    <!-- ================================================================ Kopfleiste -->
    <sys:String x:Key="S_Close">Schliessen (Esc)</sys:String>
    <sys:String x:Key="S_MeasuredRate">Tatsächlich angezeigte Bilder pro Sekunde</sys:String>
    <sys:String x:Key="S_BufferAhead">Wie weit der Ringpuffer vorausreicht. Wird die Zahl klein, stockt die Wiedergabe gleich – dann hilft eine kleinere Dekodiergröße.</sys:String>
    <sys:String x:Key="S_Adjusted">Die Anzeige ist korrigiert – die Dateien bleiben unverändert</sys:String>
    <sys:String x:Key="S_FloatPath">Die Korrektur rechnet auf den Gleitkommawerten der Datei – Belichtung holt Zeichnung aus den Lichtern zurück</sys:String>
    <sys:String x:Key="S_Curves">Kurven</sys:String>
    <sys:String x:Key="S_CurveHint">Klicken setzt einen Punkt, Ziehen verschiebt ihn, rechte Maustaste entfernt ihn.</sys:String>
    <sys:String x:Key="S_ShowOriginal">Original</sys:String>
    <sys:String x:Key="S_ShowOriginalHint">Gedrückt halten, um das Bild ohne jede Korrektur zu sehen</sys:String>
    <sys:String x:Key="S_ZoomFit">Fit</sys:String>
