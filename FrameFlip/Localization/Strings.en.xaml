    <sys:String x:Key="S_Shadows">Shadows</sys:String>
    <sys:String x:Key="S_Midtones">Midtones</sys:String>
    <sys:String x:Key="S_Highlights">Highlights</sys:String>
    <sys:String x:Key="S_ZonesHint">Three sliders each for red, green and blue - shadows lift, highlights scale, midtones bend.</sys:String>
    <sys:String x:Key="S_ColourBands">Colour ranges</sys:String>
    <sys:String x:Key="S_Hue">Hue</sys:String>
