<UserControl x:Class="FrameFlip.Views.AppearancePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,12,18"><StackPanel>
<TextBlock Text="{DynamicResource D_AppearanceIntro}" Foreground="{StaticResource DesktopMuted}" TextWrapping="Wrap" Margin="0,0,0,24" />
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource D_UiScale}" Style="{StaticResource DesktopLabel}" /><TextBlock x:Name="ScaleValue" Grid.Column="1" Foreground="{StaticResource DesktopAccent}" /></Grid>
<Slider Style="{StaticResource PanelSlider}" Focusable="True" x:Name="ScaleSlider" Minimum="85" Maximum="135" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,12,0,26" ValueChanged="OnChanged" AutomationProperties.Name="Oberflächenskalierung" />
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource D_TileSize}" Style="{StaticResource DesktopLabel}" /><TextBlock x:Name="TileValue" Grid.Column="1" Foreground="{StaticResource DesktopAccent}" /></Grid>
<Slider Style="{StaticResource PanelSlider}" Focusable="True" x:Name="TileSlider" Minimum="136" Maximum="240" TickFrequency="8" IsSnapToTickEnabled="True" Margin="0,12,0,26" ValueChanged="OnChanged" AutomationProperties.Name="Kachelgröße" />
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource D_MonitorShare}" Style="{StaticResource DesktopLabel}" /><TextBlock x:Name="ShareValue" Grid.Column="1" Foreground="{StaticResource DesktopAccent}" /></Grid>
<Slider Style="{StaticResource PanelSlider}" Focusable="True" x:Name="ShareSlider" Minimum="5" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,26" ValueChanged="OnChanged" AutomationProperties.Name="Systembereich Anteil" />
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource D_NavigationWidth}" Style="{StaticResource DesktopLabel}" /><TextBlock x:Name="NavValue" Grid.Column="1" Foreground="{StaticResource DesktopAccent}" /></Grid>
<Slider Style="{StaticResource PanelSlider}" Focusable="True" x:Name="NavSlider" Minimum="150" Maximum="420" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,12,0,26" ValueChanged="OnChanged" AutomationProperties.Name="Breite der Sequenzliste" />
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource D_LowerPanelHeight}" Style="{StaticResource DesktopLabel}"/><TextBlock x:Name="HeightValue" Grid.Column="1" Foreground="{StaticResource DesktopAccent}"/></Grid>
<Slider x:Name="HeightSlider" Minimum="180" Maximum="520" TickFrequency="10" IsSnapToTickEnabled="True" Style="{StaticResource PanelSlider}" Focusable="True" Margin="0,12,0,26" ValueChanged="OnChanged" AutomationProperties.Name="{DynamicResource D_LowerPanelHeight}"/>
<CheckBox x:Name="OrderBox" Content="{DynamicResource D_MonitorFirst}" Style="{StaticResource DesktopCheckBox}" Checked="OnChanged" Unchecked="OnChanged" Margin="0,0,0,16" />
<CheckBox x:Name="MotionBox" Content="{DynamicResource D_ReduceMotion}" Style="{StaticResource DesktopCheckBox}" Checked="OnChanged" Unchecked="OnChanged" Margin="0,0,0,22" />
<Border Background="#14151C" BorderBrush="{StaticResource DesktopLine}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,22"><Grid Height="74"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewLeft" Width="2*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="5*" /><ColumnDefinition Width="8" /><ColumnDefinition x:Name="PreviewRight" Width="2*" /></Grid.ColumnDefinitions><Border x:Name="PreviewSequence" CornerRadius="4" Background="#343140" /><Border x:Name="PreviewRender" Grid.Column="2" CornerRadius="5" Background="#514368" /><Border x:Name="PreviewSystem" Grid.Column="4" CornerRadius="5" Background="#2D4A4C" /></Grid></Border>
<Button Content="{DynamicResource D_ResetLayout}" Style="{StaticResource DesktopButton}" HorizontalAlignment="Left" Click="OnReset" />
</StackPanel></ScrollViewer></UserControl>