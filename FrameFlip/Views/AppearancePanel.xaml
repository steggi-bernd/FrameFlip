<UserControl x:Class="FrameFlip.Views.AppearancePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FrameFlip.Views">

    <!-- Dieselben Zeilen wie die uebrigen Einstellungen.

         Vorher stand hier je Regler ein Gitter fuer die Beschriftung, darunter der
         Regler, und dazwischen von Hand gesetzte 26 Pixel. Fuenfmal dasselbe,
         fuenfmal einzeln geschrieben - und beim sechsten Regler haette es wieder
         jemand abgetippt. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,10,8">
        <StackPanel>
            <TextBlock Text="{DynamicResource D_AppearanceIntro}" TextWrapping="Wrap"
                       Foreground="{StaticResource DesktopMuted}" FontSize="11.5" Margin="0,0,0,14" />

            <views:SettingGroup Style="{StaticResource SettingGroupStyle}" Header="{DynamicResource D_Appearance}">
                <views:SettingRow Style="{StaticResource SettingRowStyle}"
                                  Header="{DynamicResource D_UiScale}"
                                  Explain="{DynamicResource X_UiScale}" Important="True">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="ScaleSlider" Style="{StaticResource PanelSlider}" Width="190"
                                Focusable="True" Minimum="85" Maximum="135" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="OnChanged"
                                AutomationProperties.Name="{DynamicResource D_UiScale}" />
                        <TextBlock x:Name="ScaleValue" MinWidth="52" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{StaticResource DesktopAccent}" FontSize="11" />
                        <CheckBox x:Name="AutoScaleBox" Style="{StaticResource DesktopCheckBox}"
                                  Content="{DynamicResource D_UiScaleAuto}" Margin="14,0,0,0"
                                  VerticalAlignment="Center" ToolTip="{DynamicResource X_UiScaleAuto}"
                                  Checked="OnChanged" Unchecked="OnChanged" />
                    </StackPanel>
                </views:SettingRow>

                <views:SettingRow Style="{StaticResource SettingRowStyle}"
                                  Header="{DynamicResource D_TileSize}"
                                  Explain="{DynamicResource X_TileSize}">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="TileSlider" Style="{StaticResource PanelSlider}" Width="190"
                                Focusable="True" Minimum="136" Maximum="240" TickFrequency="8"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="OnChanged"
                                AutomationProperties.Name="{DynamicResource D_TileSize}" />
                        <TextBlock x:Name="TileValue" MinWidth="52" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{StaticResource DesktopAccent}" FontSize="11" />
                    </StackPanel>
                </views:SettingRow>

                <views:SettingRow Style="{StaticResource SettingRowStyle}"
                                  Header="{DynamicResource D_MonitorShare}"
                                  Explain="{DynamicResource X_MonitorShare}">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="ShareSlider" Style="{StaticResource PanelSlider}" Width="190"
                                Focusable="True" Minimum="5" Maximum="95" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="OnChanged"
                                AutomationProperties.Name="{DynamicResource D_MonitorShare}" />
                        <TextBlock x:Name="ShareValue" MinWidth="52" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{StaticResource DesktopAccent}" FontSize="11" />
                    </StackPanel>
                </views:SettingRow>

                <views:SettingRow Style="{StaticResource SettingRowStyle}"
                                  Header="{DynamicResource D_NavigationWidth}"
                                  Explain="{DynamicResource X_NavigationWidth}">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="NavSlider" Style="{StaticResource PanelSlider}" Width="190"
                                Focusable="True" Minimum="150" Maximum="420" TickFrequency="2"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="OnChanged"
                                AutomationProperties.Name="{DynamicResource D_NavigationWidth}" />
                        <TextBlock x:Name="NavValue" MinWidth="52" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{StaticResource DesktopAccent}" FontSize="11" />
                    </StackPanel>
                </views:SettingRow>

                <views:SettingRow Style="{StaticResource SettingRowStyle}"
                                  Header="{DynamicResource D_LowerPanelHeight}"
                                  Explain="{DynamicResource X_LowerPanelHeight}">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="HeightSlider" Style="{StaticResource PanelSlider}" Width="190"
                                Focusable="True" Minimum="180" Maximum="520" TickFrequency="10"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="OnChanged"
                                AutomationProperties.Name="{DynamicResource D_LowerPanelHeight}" />
                        <TextBlock x:Name="HeightValue" MinWidth="52" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{StaticResource DesktopAccent}" FontSize="11" />
                    </StackPanel>
                </views:SettingRow>
            </views:SettingGroup>

            <views:SettingGroup Style="{StaticResource SettingGroupStyle}" Header="{DynamicResource D_WorkspaceBehaviour}">
                <views:SettingRow Style="{StaticResource SettingRowStyle}"
                                  Header="{DynamicResource D_MonitorFirst}"
                                  Explain="{DynamicResource X_MonitorFirst}">
                    <CheckBox x:Name="OrderBox" Style="{StaticResource DesktopCheckBox}"
                              Checked="OnChanged" Unchecked="OnChanged" />
                </views:SettingRow>

                <views:SettingRow Style="{StaticResource SettingRowStyle}"
                                  Header="{DynamicResource D_ReduceMotion}"
                                  Explain="{DynamicResource X_ReduceMotion}">
                    <CheckBox x:Name="MotionBox" Style="{StaticResource DesktopCheckBox}"
                              Checked="OnChanged" Unchecked="OnChanged" />
                </views:SettingRow>
            </views:SettingGroup>

            <!-- Die Vorschau der Aufteilung bleibt, wie sie war: Sie ist kein
                 Einstellungsfeld, sondern die Antwort auf die Regler darueber. -->
            <Border Background="{StaticResource DashCard}" BorderBrush="{StaticResource DesktopLine}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <Grid Height="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PreviewLeft" Width="2*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition x:Name="PreviewRight" Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewSequence" CornerRadius="4" Background="#343140" />
                    <Border x:Name="PreviewRender" Grid.Column="2" CornerRadius="5" Background="#514368" />
                    <Border x:Name="PreviewSystem" Grid.Column="4" CornerRadius="5" Background="#2D4A4C" />
                </Grid>
            </Border>

            <Button Content="{DynamicResource D_ResetLayout}" Style="{StaticResource DesktopButton}"
                    HorizontalAlignment="Left" Click="OnReset" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
