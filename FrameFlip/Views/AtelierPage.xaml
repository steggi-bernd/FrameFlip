<UserControl x:Class="FrameFlip.Views.AtelierPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FrameFlip.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="RightColumn" Width="300" MinWidth="220" />
        </Grid.ColumnDefinitions>

        <!-- Kopfzeile: was offen ist, und womit gerechnet wird -->
        <Grid Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Style="{StaticResource OverlayButton}"
                        Content="{DynamicResource S_OpenImage}" Click="OnOpenClicked" />

                <TextBlock x:Name="FileText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Style="{StaticResource DashLabel}"
                           TextTrimming="CharacterEllipsis" MaxWidth="460"
                           Text="{DynamicResource S_NoImage}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!--
                    Gedrueckt halten zeigt das Original. Als Knopf und nicht als
                    Schalter, weil der Vergleich ein Blick ist und kein Zustand -
                    wer umschaltet, vergisst zurueckzuschalten und beurteilt dann
                    minutenlang das falsche Bild.
                -->
                <Button x:Name="CompareButton" Style="{StaticResource OverlayButton}"
                        Content="{DynamicResource S_ShowOriginal}" Margin="0,0,10,0"
                        PreviewMouseLeftButtonDown="OnCompareDown"
                        PreviewMouseLeftButtonUp="OnCompareUp"
                        MouseLeave="OnCompareUp"
                        IsEnabled="False"
                        ToolTip="{DynamicResource S_ShowOriginalHint}" />

                <Button x:Name="ZoomButton" Style="{StaticResource LinkButton}"
                        Margin="0,0,14,0" MinWidth="52" Click="OnZoomClicked"
                        ToolTip="{DynamicResource S_ZoomHint}">
                    <TextBlock x:Name="ZoomText" FontSize="9" TextAlignment="Right" Text="Fit" />
                </Button>

                <TextBlock x:Name="SourceText" VerticalAlignment="Center" Margin="0,0,14,0"
                           Style="{StaticResource DashLabel}" FontSize="9" />
                <TextBlock x:Name="ViewText" VerticalAlignment="Center"
                           Style="{StaticResource DashLabel}" FontSize="9" />

                <!--
                    Was die Pipette zuletzt gelesen hat. In der Kopfzeile und nicht
                    als Wolke am Zeiger: Ein Wert, den man ablesen will, will man
                    meistens mit einem zweiten vergleichen, und dafuer muss der
                    erste stehenbleiben.
                -->
                <TextBlock x:Name="PickText" VerticalAlignment="Center" Margin="14,0,0,0"
                           Style="{StaticResource DashLabel}" FontSize="9"
                           Foreground="{StaticResource AccentBrush}"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!--
            Die Werkzeugspalte: was die Maus im Bild tut.

            Sie steht links, weil sie dort in jedem Programm steht, das eine hat -
            und weil das Bild damit zwischen dem, was die Maus tut, und dem, woraus
            das Bild besteht, liegt. Das ist keine Anordnung aus Gewohnheit, sondern
            die Leserichtung des Vorgangs: Werkzeug, Bild, Aufbau.
        -->
        <local:ToolColumn x:Name="MouseTools" Grid.Row="1" Grid.Column="0"
                          Margin="0,0,10,0" />

        <!-- Das Bild -->
        <Border Grid.Row="1" Grid.Column="1" Background="#FF101010" CornerRadius="4"
                ClipToBounds="True"
                AllowDrop="True" Drop="OnImageFilesDropped" DragOver="OnImageFilesDragOver">
            <Grid>
                <ScrollViewer x:Name="ImageScroll"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PanningMode="Both"
                              PreviewMouseDown="OnViewportDown"
                              PreviewMouseMove="OnViewportMove"
                              PreviewMouseUp="OnViewportUp">
                    <!--
                        Bild und Greifrahmen im selben Feld: Sie bekommen damit
                        dieselben Masse, und der Rahmen muss die Lage des Bildes
                        nicht nachrechnen. Ein Rahmen, der einen Bildpunkt daneben
                        liegt, laesst einen an einer Ecke ziehen, die nicht dort ist,
                        wo sie aussieht.
                    -->
                    <Grid>
                        <Image x:Name="Display" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonDown="OnImageClicked" />

                        <local:PlacementAdorner x:Name="Placement" />
                    </Grid>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource DashLabel}" TextWrapping="Wrap" MaxWidth="360"
                           TextAlignment="Center"
                           Text="{DynamicResource S_AtelierEmpty}" />

                <Border x:Name="BusyBadge" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource BadgeBackground}" CornerRadius="4" Padding="12,7">
                    <TextBlock Style="{StaticResource DashLabel}" Text="{DynamicResource S_Loading}" />
                </Border>
            </Grid>
        </Border>

        <!--
            Die Werkzeuge. Oben der Stapel, darunter die Farbe.

            Die Reihenfolge ist die des Rechenwegs: Erst entsteht aus den Passen ein
            Bild, dann wird dieses Bild korrigiert. Wer von oben nach unten liest,
            liest damit dieselbe Kette, die auch gerechnet wird - und die Frage
            "worauf wirkt der Regler?" beantwortet sich, ohne dass sie gestellt
            werden muss: auf das, was oben herauskommt.
        -->
        <!--
            Der Griff zwischen Bild und Spalte.

            Eine feste Breite ist eine Behauptung darueber, wie breit der Schirm des
            Benutzers ist. Auf einem breiten will man die Ebenennamen lesen, auf
            einem engen will man das Bild - und beides ist richtig.
        -->
        <GridSplitter Grid.Row="1" Grid.Column="2" Width="12"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns" Focusable="False"
                      DragCompleted="OnColumnResized" />

        <Border Grid.Row="1" Grid.Column="3"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="LayersRow" Height="0" />
                </Grid.RowDefinitions>

                <!--
                    Die Farbe oben, die Ebenen UNTEN.

                    Das war zwanzig Jahre lang andersherum gedacht und einmal gut
                    begruendet: Von oben nach unten gelesen stand dort dieselbe
                    Kette, die auch gerechnet wird. Das Argument war richtig und hat
                    gegen die Gewohnheit verloren - in jedem Programm mit Ebenen
                    stehen sie unten, und wer sie oben sucht, sucht sie jedes Mal neu.
                    Die Reihenfolge des Rechenwegs lebt weiter, wo sie hingehoert:
                    innerhalb der Farbkorrektur, deren Abschnitte in der Reihenfolge
                    stehen, in der gerechnet wird.
                -->
                <local:GradingPanel x:Name="Tools" Grid.Row="0" />

                <Border x:Name="LayerSeparator" Grid.Row="1" Height="1" Margin="14,0"
                        VerticalAlignment="Center" IsHitTestVisible="False"
                        Background="{StaticResource PanelBorder}" Visibility="Collapsed" />

                <GridSplitter x:Name="LayerSplitter" Grid.Row="1" Height="11"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" Focusable="False"
                              Visibility="Collapsed"
                              DragCompleted="OnLayersResized" />

                <!--
                    Der Streifen waechst mit der Anzahl der Ebenen, seine Zeile nicht.
                    Ohne diese Bildlaufflaeche waere die achte Ebene abgeschnitten,
                    und zwar unsichtbar - eine Liste, die einfach aufhoert, sieht aus
                    wie eine vollstaendige Liste.
                -->
                <ScrollViewer x:Name="LayerScroll" Grid.Row="2" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <local:LayerPanel x:Name="Layers" Visibility="Collapsed" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Die Sequenz ausgeben -->
        <Border x:Name="ExportBar" Grid.Row="2" Grid.ColumnSpan="4" Margin="0,12,0,0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4"
                Padding="12,10" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SequenceText" VerticalAlignment="Center"
                               Style="{StaticResource DashLabel}" MinWidth="150" />

                    <ComboBox x:Name="FormatBox" Style="{StaticResource OverlayCombo}"
                              Width="150" Margin="14,0,0,0"
                              SelectionChanged="OnFormatChanged"
                              ToolTip="{DynamicResource S_OutputFormat}" />

                    <Button x:Name="TargetButton" Style="{StaticResource OverlayButton}"
                            Margin="8,0,0,0" Content="{DynamicResource S_ChooseTarget}"
                            Click="OnChooseTargetClicked" />

                    <TextBlock x:Name="TargetText" VerticalAlignment="Center" Margin="10,0,0,0"
                               Style="{StaticResource DashLabel}" FontSize="9"
                               TextTrimming="CharacterEllipsis" MaxWidth="320" />
                </StackPanel>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="BatchStatus" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource DashLabel}" FontSize="9" />

                    <Button x:Name="RunButton" Style="{StaticResource OverlayButton}"
                            Content="{DynamicResource S_RunBatch}" Click="OnRunClicked"
                            IsEnabled="False" MinWidth="120" />

                    <Button x:Name="StopButton" Style="{StaticResource OverlayButton}"
                            Margin="8,0,0,0" Content="{DynamicResource S_Stop}"
                            Click="OnStopClicked" Visibility="Collapsed" MinWidth="90" />
                </StackPanel>

                <ProgressBar x:Name="BatchProgress" Grid.Row="1" Height="3" Margin="0,10,0,0"
                             Visibility="Collapsed" Minimum="0" Maximum="1"
                             Background="{StaticResource PanelBorder}"
                             Foreground="{StaticResource DesktopAccent}"
                             BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
