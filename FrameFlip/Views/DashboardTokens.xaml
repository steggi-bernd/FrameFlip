<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FrameFlip.Views"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ================================================================ Werte aus dem Entwurf

         Die Zahlen stammen aus FrameFlipDesktop.dc.html und sind bewusst nicht
         "ungefaehr uebernommen": Wenn eine Kachel dort 11px Radius hat und hier 12,
         faellt das einzeln nicht auf, aber ueber zwanzig Bausteine hinweg sieht das
         Ergebnis aus wie eine Nachahmung statt wie dieselbe Oberflaeche.

         Diese Datei wird NACH DesktopTheme.xaml eingehaengt und ueberschreibt deren
         Farben. Die vorhandenen Seiten (Projekte, Einstellungen) benutzen dieselben
         Schluessel und ziehen dadurch mit um, ohne dass sie angefasst werden muessen.
    -->

    <!-- ================================================================ Flaechen -->
    <SolidColorBrush x:Key="DesktopBg" Color="#07070D" />
    <SolidColorBrush x:Key="DesktopPanel" Color="#0B0B14" />
    <SolidColorBrush x:Key="DesktopStage" Color="#05050A" />
    <SolidColorBrush x:Key="DesktopSurface" Color="#11111B" />
    <SolidColorBrush x:Key="DesktopSubtle" Color="#191926" />
    <SolidColorBrush x:Key="DashCard" Color="#0D0D16" />
    <SolidColorBrush x:Key="DesktopLine" Color="#1E1E2B" />
    <SolidColorBrush x:Key="DesktopLineSoft" Color="#171722" />

    <!-- ================================================================ Schrift -->
    <SolidColorBrush x:Key="DesktopInk" Color="#F4F4F8" />
    <SolidColorBrush x:Key="DesktopMuted" Color="#9B9BB0" />
    <SolidColorBrush x:Key="DesktopFaint" Color="#6B6B80" />

    <!-- ================================================================ Bedeutungsfarben

         Lila fuer Fortschritt und GPU, Blau fuer CPU/RAM, Cyan fuer Temperatur und
         Lebenszeichen, Pink ausschliesslich, wenn etwas nicht stimmt. Diese Zuordnung
         ist im Entwurf ausdruecklich festgelegt - sie ist der Grund, warum ein
         pinker Strich in der Zeitleiste sofort als Luecke gelesen wird.
    -->
    <SolidColorBrush x:Key="DesktopAccent" Color="#A855F7" />
    <SolidColorBrush x:Key="DesktopBlue" Color="#60A5FA" />
    <SolidColorBrush x:Key="DesktopCyan" Color="#22D3EE" />
    <SolidColorBrush x:Key="DesktopWarn" Color="#F472B6" />

    <SolidColorBrush x:Key="DashAccentSoft" Color="#2BA855F7" />
    <SolidColorBrush x:Key="DashAccentEdge" Color="#8CA855F7" />

    <!-- ================================================================ Beschriftungen -->

    <Style x:Key="DashLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="DashMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
    </Style>

    <Style x:Key="DashDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
    </Style>

    <!-- ================================================================ Bildmarke

         Dasselbe Symbol, das die Programmdatei traegt und das in der Taskleiste
         steht. Als Ressource, damit es nur einmal dekodiert wird - die Titelzeile
         zeigt es in jedem Fenster.
    -->
    <BitmapImage x:Key="AppMark" UriSource="pack://application:,,,/FrameFlip;component/Assets/FrameFlip.ico"
                 DecodePixelWidth="64" CacheOption="OnLoad" />

    <!-- ================================================================ Mitlaufen

         Der Schalter ueber der Buehne. Eingeschaltet traegt er die Akzentfarbe und
         ist damit das einzige farbige Feld im Bild; ausgeschaltet ist er ein
         zurueckhaltendes Schild, das immer noch sagt, dass es ihn gibt.
    -->
    <Style x:Key="DashFollow" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DashFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Shell" CornerRadius="7" Padding="10,5" Background="#CC07070D"
                            BorderBrush="{StaticResource DesktopLine}" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#E6A855F7" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush"
                                    Value="{StaticResource DashAccentEdge}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Bildrate

         Ein aufklappbares Feld, in das man auch tippen kann. Die Liste nennt die
         ueblichen Raten, das Feld nimmt jede andere: 23,976 fuer Film auf NTSC,
         48 fuer einen Zeitlupentest, 8 fuer ein Daumenkino. Eine feste Auswahl
         waere genau dann im Weg, wenn sie gebraucht wird.
    -->
    <Style x:Key="DashRateBox" TargetType="ComboBox">
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Width" Value="96" />
        <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
        <Setter Property="Background" Value="{StaticResource DesktopSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource DesktopLine}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DashFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Shell" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />

                        <Grid Margin="10,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     VerticalContentAlignment="Center" CaretBrush="{StaticResource DesktopAccent}"
                                     SelectionBrush="{StaticResource DashAccentSoft}"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}" />

                            <!-- Die Einheit steht in Tag: "fps" bei Bildraten, sonst nichts. Fest
                                 eingetragen stand sie auch hinter Sprache und Kanal. -->
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}" VerticalAlignment="Center" Margin="4,1,0,0"
                                       FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="8.5"
                                       Foreground="{StaticResource DesktopFaint}" />

                            <ToggleButton x:Name="PART_Arrow" Grid.Column="2" Width="18" Focusable="False"
                                          Background="Transparent" BorderThickness="0" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M0,0 L4,4 L8,0" StrokeThickness="1.3"
                                                  Stroke="{StaticResource DesktopMuted}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="Fade" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Margin="0,6,0,0" CornerRadius="9" Padding="5"
                                    Background="{StaticResource DesktopPanel}"
                                    BorderBrush="{StaticResource DesktopLine}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource DashAccentEdge}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource DesktopAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="9,6" />
                    <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Row" CornerRadius="6" Background="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Row" Property="Background"
                                                Value="{StaticResource DashAccentSoft}" />
                                        <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Ein Eingabefeld im Ton der Tafel.

        Es gibt bereits DashRateBox, und das sieht genauso aus - aber das ist ein Stil
        fuer ComboBox. Ihn einer TextBox zu geben, ist kein Schoenheitsfehler: WPF
        weist eine Vorlage mit falschem Zieltyp beim Laden zurueck, und mit ihr das
        ganze Fenster. Der Bau meldet nichts davon; es faellt erst beim Start auf.
    -->
    <Style x:Key="DashTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
        <Setter Property="Background" Value="{StaticResource DesktopSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource DesktopLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource DesktopAccent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource DashAccentSoft}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DashFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Shell" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush"
                                    Value="{StaticResource DashAccentEdge}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================================================================ Fokus

         WPF zeichnet von Haus aus ein gepunktetes Rechteck, das in diesem Entwurf
         wie ein Fremdkoerper wirkt. Der erste Reflex war, Focusable abzuschalten -
         damit war die ganze Oberflaeche per Tastatur unerreichbar. Richtig ist,
         das Bild zu ersetzen, nicht die Erreichbarkeit.
    -->
    <Style x:Key="DashFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="8" RadiusY="8" StrokeThickness="1.4"
                               Stroke="{StaticResource DesktopAccent}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Knoepfe -->

    <!-- Chip. Der Entwurf kennt zwei Groessen: 28px in der Kopfzeile des Viewers,
         34px in der Transportleiste. -->
    <Style x:Key="DashChip" TargetType="ToggleButton">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DashFocus}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource DesktopSurface}"
                            BorderBrush="{StaticResource DesktopLine}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DesktopFaint}" />
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DashAccentSoft}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DesktopAccent}" />
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DashChipSmall" TargetType="ToggleButton" BasedOn="{StaticResource DashChip}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="9.5" />
    </Style>

    <!-- Reiter der rechten Spalte. Oben rund, unten offen - sie sitzen auf der
         Flaeche, die sie beschriften. -->
    <Style x:Key="DashPanelTab" TargetType="RadioButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DashFocus}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" CornerRadius="9,9,0,0" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1,1,1,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DesktopSurface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DesktopLine}" />
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zurueckhaltender Knopf: dieselbe Flaeche wie eine Kachel, nur anklickbar. -->
    <Style x:Key="DashGhost" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DashFocus}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="9" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource DesktopSurface}"
                            BorderBrush="{StaticResource DesktopLine}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DesktopFaint}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DashGhostSmall" TargetType="Button" BasedOn="{StaticResource DashGhost}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="7" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource DesktopSubtle}"
                            BorderBrush="{StaticResource DesktopLine}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DesktopFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DashPrimary" TargetType="Button" BasedOn="{StaticResource DashGhost}">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="10" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource DesktopAccent}"
                            BorderBrush="{StaticResource DesktopAccent}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DesktopSurface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DesktopLine}" />
                            <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transportknoepfe. Quadratisch, damit die Pfeile auf einer Linie sitzen. -->
    <Style x:Key="DashTransport" TargetType="Button" BasedOn="{StaticResource DashGhost}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="DashPlay" TargetType="Button" BasedOn="{StaticResource DashPrimary}">
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- Fensterknopf in der Titelzeile. 46 breit wie im Entwurf. -->
    <Style x:Key="DashWindowButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DashFocus}" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DesktopSubtle}" />
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DashWindowClose" TargetType="Button" BasedOn="{StaticResource DashWindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#C4384C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reiter der Titelzeile: Dashboard, Projekte, Einstellungen. Im Entwurf
         stehen hier die Menues; die Anwendung hat keine, also traegt die Stelle
         die Navigation. -->
    <Style x:Key="DashNavTab" TargetType="RadioButton">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DashFocus}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" CornerRadius="7" Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DesktopSubtle}" />
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DashAccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Flaechen -->

    <Style x:Key="DashTile" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{StaticResource DesktopSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource DesktopLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,11,11,10" />
    </Style>

    <!-- Eintrag in der Sequenzliste. Der aktive bekommt lila Grund und Rand -
         im Entwurf ist das der einzige farbige Block in der linken Spalte. -->
    <Style x:Key="DashSequenceItem" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DashFocus}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="10" Padding="8" Margin="0,0,0,4"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DesktopSurface}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DashAccentSoft}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DashAccentEdge}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bild eines Filmstreifen-Einzelbildes. -->
    <Style x:Key="DashStripCell" TargetType="ToggleButton">
        <Setter Property="Width" Value="66" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DashFocus}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="8" Background="#0E0E17"
                            BorderBrush="{StaticResource DesktopLine}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DesktopAccent}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ein Name, der am Einsatzort stimmt.

         DashRateBox heisst nach ihrem ersten Gebrauch, dem Bildratenfeld. In den
         Einstellungen stuende dort ein Stil, dessen Name nichts mit dem zu tun hat,
         was er auswaehlt - Sprache oder Bildrate.

         Der Alias steht HIER und nicht in DesktopTheme.xaml, obwohl er dem Namen
         nach dorthin gehoerte: BasedOn loest ueber StaticResource auf, und
         DashboardTokens wird erst NACH DesktopTheme eingehaengt. Dort haette der
         Verweis beim Laden ins Leere gegriffen - und ein Fehler beim Laden nimmt
         das ganze Fenster mit, ohne dass der Compiler etwas gesagt haette. -->
    <!-- Das (i) selbst: ein Kreis, der nicht laut ist, aber gefunden wird. -->
    <Style x:Key="DesktopInfoDot" TargetType="ToggleButton">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{DynamicResource S_WhatIsThis}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="{StaticResource DesktopFaint}" StrokeThickness="1" />
                        <TextBlock x:Name="Glyph" Text="i" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource HeadFont}" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource DesktopFaint}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DesktopAccent}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DesktopAccent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DesktopAccent}" />
                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource DesktopAccent}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DesktopStage}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================ Eine Einstellung als Zeile

         Alle Masse kommen von hier. Vorher trug die Einstellungsseite vierzig von
         Hand gesetzte Abstaende in zweiundzwanzig verschiedenen Werten - deshalb
         fluchtete nichts, obwohl jedes einzelne Feld richtig war. -->

    <Style x:Key="SettingRowStyle" TargetType="{x:Type views:SettingRow}">
        <Setter Property="Margin" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:SettingRow}">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="8"
                            BorderBrush="Transparent" BorderThickness="2,0,0,0"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" MinWidth="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />   <!-- Bezeichnung, (i), Bedienelement -->
                                <RowDefinition Height="Auto" />   <!-- aufgeklappte Erklaerung -->
                                <RowDefinition Height="Auto" />   <!-- dauerhafte Fussnote -->
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="Title" Grid.Row="0" Grid.Column="0"
                                       Text="{TemplateBinding Header}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       FontSize="12" Foreground="{StaticResource DesktopInk}" />

                            <!-- Das (i) sitzt zwischen Bezeichnung und Bedienelement,
                                 nicht daneben: So steht es bei jeder Zeile an
                                 derselben Stelle, auch wenn die Bezeichnung umbricht. -->
                            <!-- Ein Name fuer die Bedienungshilfen. Ein ToolTip ist
                                 keiner: Eine Sprachausgabe liest ihn nicht vor, und
                                 der Knopf hiesse dann nichts - ein stummer Kreis. -->
                            <ToggleButton x:Name="Info" Grid.Row="0" Grid.Column="1"
                                          Style="{StaticResource DesktopInfoDot}"
                                          AutomationProperties.Name="{DynamicResource S_WhatIsThis}"
                                          VerticalAlignment="Center" Margin="0,0,12,0" />

                            <ContentPresenter Grid.Row="0" Grid.Column="2"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <!-- Die Erklaerung schiebt die Zeile auf, statt in einem
                                 Popup ueber dem Inhalt zu schweben: Wer sie aufklappt,
                                 will sie neben der Einstellung lesen, nicht darueber. -->
                            <TextBlock x:Name="Erklaerung" Grid.Row="1" Grid.ColumnSpan="3"
                                       Text="{TemplateBinding Explain}" TextWrapping="Wrap"
                                       Margin="0,8,0,2" FontSize="11" LineHeight="17"
                                       Foreground="{StaticResource DesktopMuted}"
                                       Visibility="Collapsed" />

                            <!-- Zeile 2, nicht 1. Die Erklaerung sitzt auf 1, und
                                 beide zusammen in einer Zelle waeren genau der
                                 Fehler, der die Trennlinie durch den Text gezogen
                                 hat - WPF stapelt, was sich eine Zelle teilt. -->
                            <TextBlock x:Name="Fussnote" Grid.Row="2" Grid.ColumnSpan="3"
                                       Text="{TemplateBinding Footnote}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" FontSize="11" LineHeight="17"
                                       Foreground="{StaticResource DesktopFaint}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DesktopSubtle}" />
                        </Trigger>

                        <!-- Ein (i) gibt es nur, wo auch etwas zu erklaeren ist.
                             Sichtbar ist der Grundzustand; es verschwindet bei leerem
                             Text. Das spart einen Konverter, den sonst nur diese eine
                             Stelle gebraucht haette. -->
                        <Trigger Property="Explain" Value="{x:Null}">
                            <Setter TargetName="Info" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Explain" Value="">
                            <Setter TargetName="Info" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger SourceName="Info" Property="IsChecked" Value="True">
                            <Setter TargetName="Erklaerung" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="Footnote" Value="{x:Null}">
                            <Setter TargetName="Fussnote" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footnote" Value="">
                            <Setter TargetName="Fussnote" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Wichtiges bekommt einen Strich an der Seite und mehr
                             Gewicht in der Schrift. Sparsam vergeben: Wenn alles
                             hervorgehoben ist, ist nichts hervorgehoben. -->
                        <Trigger Property="Important" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DesktopAccent}" />
                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Eine Gruppe ersetzt die Trennlinien. Eine Linie sagt "hier ist ein Schnitt";
         eine Ueberschrift sagt, worum es im Abschnitt geht. -->
    <Style x:Key="SettingGroupStyle" TargetType="{x:Type views:SettingGroup}">
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:SettingGroup}">
                    <StackPanel>
                        <TextBlock x:Name="Caption" Text="{TemplateBinding Header}" Margin="14,0,0,6"
                                   FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="9.5"
                                   Foreground="{StaticResource DesktopFaint}" />
                        <Border Background="{StaticResource DesktopPanel}" CornerRadius="10"
                                BorderBrush="{StaticResource DesktopLine}" BorderThickness="1"
                                Padding="4,3">
                            <ItemsPresenter />
                        </Border>
                    </StackPanel>
                    <!-- Ohne Ueberschrift keine leere Zeile: Steht die Gruppe allein unter
                         dem Titel ihrer Seite, saehe man sonst zweimal dasselbe Wort. -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DesktopCombo" TargetType="ComboBox" BasedOn="{StaticResource DashRateBox}" />

    <!-- ================================================================ Einstellungen

         Entwurf A (docs/Projekte-und-Masken.md, Punkt 12): die Abschnitte als Leiste
         links, der Inhalt rechts daneben, mittig und nicht breiter, als man bequem liest.
         Es bleibt ein TabControl - nur anders gezeichnet. Wer umschaltet, waehlt weiter
         einen Reiter, und alles, was einen Reiter waehlt, waehlt weiter einen Abschnitt.

         Ist die Seite schmal (Tag="Narrow", gesetzt von SettingsEditor), rueckt die Leiste
         nach oben und bricht um - daneben bliebe fuer den Inhalt kaum etwas. -->
    <Style x:Key="SettingsSections" TargetType="TabControl">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="Rail" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Width="184"
                                Margin="0,0,24,0" Padding="0,2,12,0"
                                BorderBrush="{StaticResource DesktopLine}" BorderThickness="0,0,1,0">
                            <WrapPanel x:Name="RailItems" IsItemsHost="True" Orientation="Vertical" />
                        </Border>

                        <!-- Der Name ist Pflicht - siehe DesktopTabs in DesktopTheme.xaml. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                          ContentSource="SelectedContent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Narrow">
                            <Setter TargetName="Rail" Property="Grid.RowSpan" Value="1" />
                            <Setter TargetName="Rail" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="Rail" Property="Width" Value="NaN" />
                            <Setter TargetName="Rail" Property="Margin" Value="0,0,0,14" />
                            <Setter TargetName="Rail" Property="Padding" Value="0" />
                            <Setter TargetName="Rail" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter TargetName="RailItems" Property="Orientation" Value="Horizontal" />
                            <Setter TargetName="PART_SelectedContentHost" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_SelectedContentHost" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="PART_SelectedContentHost" Property="Grid.Row" Value="1" />
                            <Setter TargetName="PART_SelectedContentHost" Property="Grid.RowSpan" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ein Abschnitt in der Leiste: eine ruhige Zeile, gewaehlt mit Flaeche und einem
         Strich am Rand - wie eine Unterhaltung in einer Nachrichtenliste. -->
    <Style x:Key="SettingsSection" TargetType="TabItem">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="172" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" Margin="0,0,0,2" CornerRadius="7" Background="Transparent"
                            MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}">
                        <Grid>
                            <Border x:Name="Mark" Width="3" CornerRadius="1.5" Margin="0,8" HorizontalAlignment="Left"
                                    Background="{StaticResource DesktopAccent}" Visibility="Collapsed" />
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DesktopSubtle}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DesktopSubtle}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DesktopSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Der Inhalt eines Abschnitts: mittig und hoechstens so breit, wie eine Zeile sich
         noch bequem liest. Gestreckt mit Hoechstbreite heisst in WPF: mittig. -->
    <sys:Double x:Key="SettingsBodyWidth">760</sys:Double>
    <sys:Double x:Key="SettingsOverviewWidth">760</sys:Double>

    <Style x:Key="SettingsPageBody" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="{DynamicResource SettingsBodyWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SettingsPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
    </Style>

    <Style x:Key="SettingsPageSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,4,0,18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
    </Style>

    <!-- Eine Karte auf der Seite "Verbindungen": eine Verbindung, ihr Code, ihr Stand. -->
    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Background" Value="{StaticResource DesktopPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource DesktopLine}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SettingsCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsCardCode" TargetType="Border">
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="200" />
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource DesktopSurface}" />
    </Style>

    <!-- Die Uebersicht der Einstellungen (Entwurf 2): Zustandsfelder oben, darunter je
         Kategorie eine Kachel mit dem, was man am haeufigsten aendert. -->
    <Style x:Key="SettingsTile" TargetType="Border" BasedOn="{StaticResource SettingsCard}">
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="SettingsTileTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsTileLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SettingsTileMore" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Foreground" Value="{StaticResource DesktopAccent}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="SettingsStat" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Background" Value="{StaticResource DesktopPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource DesktopLine}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SettingsStatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
    </Style>

    <Style x:Key="SettingsStatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>
