<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FrameFlip.Views" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="DesktopBg" Color="#101116" />
    <SolidColorBrush x:Key="DesktopSurface" Color="#191A23" />
    <SolidColorBrush x:Key="DesktopLine" Color="#30313E" />
    <SolidColorBrush x:Key="DesktopSubtle" Color="#20212D" />
    <SolidColorBrush x:Key="DesktopInk" Color="#EEEFF5" />
    <SolidColorBrush x:Key="DesktopMuted" Color="#A1A4B5" />
    <SolidColorBrush x:Key="DesktopAccent" Color="#B4A0FF" />
    <Style x:Key="DesktopButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DesktopInk}" /><Setter Property="Background" Value="{StaticResource DesktopSubtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource DesktopLine}" /><Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="14,9" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#343242" /><Setter TargetName="Surface" Property="BorderBrush" Value="#68617C" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource DesktopAccent}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DesktopPrimary" TargetType="Button" BasedOn="{StaticResource DesktopButton}">
        <Setter Property="Background" Value="#493C6D" /><Setter Property="BorderBrush" Value="#80709F" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource DesktopButton}">
        <Setter Property="Width" Value="46" /><Setter Property="Height" Value="46" /><Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="DesktopCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DesktopSurface}" /><Setter Property="BorderBrush" Value="{StaticResource DesktopLine}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="22" />
    </Style>
    <Style x:Key="DesktopHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
    </Style>
    <Style x:Key="DesktopLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DesktopSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="ShowsPreview" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter">
            <Grid Background="{TemplateBinding Background}"><Border x:Name="Grip" Width="3" Height="36" CornerRadius="2" Background="#444353" VerticalAlignment="Center" HorizontalAlignment="Center" /></Grid>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource DesktopAccent}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource DesktopAccent}" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
<Style x:Key="DashboardSplitter" TargetType="GridSplitter">
<Setter Property="Background" Value="{StaticResource DesktopBg}"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter"><Grid Background="{TemplateBinding Background}"><Border x:Name="Grip" Width="2" Height="32" Background="{StaticResource DesktopLine}" CornerRadius="1" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="ResizeDirection" Value="Rows"><Setter TargetName="Grip" Property="Width" Value="32"/><Setter TargetName="Grip" Property="Height" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource DesktopAccent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource DesktopAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style><Style x:Key="DesktopCheckBox" TargetType="CheckBox">
<Setter Property="Foreground" Value="{StaticResource DesktopInk}" /><Setter Property="FontSize" Value="12" /><Setter Property="Cursor" Value="Hand" />
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="4" BorderThickness="1" BorderBrush="#777084" Background="#23202D" VerticalAlignment="Top"/><TextBlock x:Name="CheckMark" Text="✓" Foreground="#EDE5FF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" Margin="9,0,0,0" RecognizesAccessKey="True"><ContentPresenter.Resources><DataTemplate DataType="{x:Type sys:String}"><AccessText Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ContentPresenter.Resources></ContentPresenter></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/><Setter TargetName="CheckSurface" Property="Background" Value="#645080" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource DesktopAccent}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>

    <!-- =================================================== Reiter im Dashboard-Gewand

         Die Einstellungen trugen bis hierher DialogTabs und DialogTab - Stile aus der
         Zeit, als die Einstellungen ein eigenes kleines Fenster waren. Neben einer
         ganzen Seite wirkten sie zu eng und zu fremd.

         Das Aussehen ist von DashPanelTab abgeschaut, dem Reiterband ueber Metriken
         und Protokoll. Abgeschaut und nicht wiederverwendet, weil jenes auf
         RadioButton zielt und dieses auf TabItem: Ein Stil am falschen Zieltyp wird
         nicht etwa ignoriert, er reisst beim Laden das ganze Fenster mit. -->

    <Style x:Key="DesktopTab" TargetType="TabItem">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource DesktopMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- Ein Strich unter der gewaehlten Lasche, keine gefuellte Flaeche.
                     Eine Lasche im Kachelgewand setzt voraus, dass unter ihr eine
                     Flaeche beginnt, auf der sie aufsitzt. Die gibt es hier nicht
                     mehr - sie haette dann auf einer Linie geschwebt. -->
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" Margin="0,0,4,0" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DesktopAccent}" />
                            <Setter Property="Foreground" Value="{StaticResource DesktopInk}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DesktopSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DesktopTabs" TargetType="TabControl">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Das Band selbst mit einer Linie darunter, damit die
                             gewaehlte Lasche sichtbar auf der Flaeche aufsitzt. -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource DesktopLine}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Panel.ZIndex="1" Margin="0,0,0,-1" />
                        </Border>

                        <!-- Ohne Kasten. Der Inhalt liegt auf der Seite, nicht in
                             einer zweiten Flaeche darauf: Die Reiter grenzen schon
                             ab, und eine graue Flaeche auf einer grauen Seite ist
                             ein Rahmen um nichts.

                             Der Name des Inhaltsbereichs ist nicht frei waehlbar -
                             TabControl sucht ihn ueber genau diese Zeichenkette.
                             Heisst er anders, bleibt der Rumpf leer: die Reiter sind
                             da, anklickbar, und darunter ist nichts. Kein Fehler,
                             keine Meldung, nur eine leere Flaeche. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                          Margin="0,14,0,0"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>