<Window x:Class="FrameFlip.Views.FramePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_PreviewTitle}"
        Width="960" Height="700"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBg}"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="16,16,16,0" CornerRadius="14"
                Background="{StaticResource AppBg2}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
            <Grid>
                <Image x:Name="Picture" Margin="10" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- EXR und halb geschriebene Dateien lassen sich nicht anzeigen.
                     Das gehört dann auch dagestanden, statt eine leere Fläche zu
                     zeigen, die wie ein Fehler aussieht. -->
                <TextBlock x:Name="Trouble" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap"
                           FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                           Foreground="{StaticResource FaintBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,14,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="Caption" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                           FontSize="12.5" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource ForegroundBrush}" />

                <TextBlock x:Name="Detail" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"
                           FontSize="10.5" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="Previous" Padding="13,7" CornerRadius="9" Cursor="Hand"
                        Background="{StaticResource AppSurface}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                    <TextBlock Text="◀" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                </Border>

                <Border x:Name="Next" Margin="6,0,0,0" Padding="13,7" CornerRadius="9" Cursor="Hand"
                        Background="{StaticResource AppSurface}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                    <TextBlock Text="▶" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                </Border>

                <Border x:Name="Combine" Margin="14,0,0,0" Padding="16,8" CornerRadius="9" Cursor="Hand"
                        Background="{StaticResource AppSurface}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <TextBlock x:Name="CombineText" Text="{DynamicResource S_CombineButton}"
                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="9.5"
                               Foreground="{StaticResource ForegroundBrush}" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
