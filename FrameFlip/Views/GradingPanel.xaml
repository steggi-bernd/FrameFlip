                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_VignetteRoundness}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="VignetteRoundnessValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="VignetteRoundnessSlider" Style="{StaticResource PanelSlider}"
                        Minimum="-1" Maximum="1" Value="0" SmallChange="0.02" LargeChange="0.1"
