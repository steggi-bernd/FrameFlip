                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_VignetteMidpoint}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="VignetteMidpointValue" Style="{StaticResource PanelValue}" />
