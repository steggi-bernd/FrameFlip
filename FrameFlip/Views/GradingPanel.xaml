                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_VignetteFeather}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="VignetteFeatherValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="VignetteFeatherSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0.02" Maximum="1" Value="0.5" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0.5" />

                <TextBlock Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{DynamicResource S_VignetteHint}" />
            </StackPanel>

            <ToggleButton x:Name="GroupDither" Style="{StaticResource SectionHeader}"
                          Margin="0,18,0,2" IsChecked="True" Tag="Dither,Grain"
                          Content="{DynamicResource S_GroupFilm}"
                          Checked="OnGroupToggled" Unchecked="OnGroupToggled" />
            <!--
                Rastern. Steht NACH dem Korn, weil es dort auch gerechnet wird: Ein
                Korn hinterher braeuchte Zwischenwerte, die es nach dem Rastern nicht
                mehr gibt - es wuerde die Stufen wieder verwischen und damit genau das
                aufheben, wofuer jemand gerastert hat.
            -->
            <Grid x:Name="DitherHead" Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource S_Dither}" Style="{StaticResource PanelHeading}" />
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Content="+" Tag="DitherBody" Click="OnSectionToggled" />
            </Grid>
            <StackPanel x:Name="DitherBody" Visibility="Collapsed" Margin="0,6,0,0">
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="{DynamicResource S_DitherAmount}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="DitherValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="DitherSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0" Maximum="1" Value="0" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_DitherLevels}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="DitherLevelsValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="DitherLevelsSlider" Style="{StaticResource PanelSlider}"
                        Minimum="2" Maximum="32" Value="6" SmallChange="1" LargeChange="4"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="6" />

                <!--
                    Die Rasterpunktgroesse - und sie ist der Unterschied zwischen
                    einem Raster und Gries.

                    Ein 4K-Bild auf zwei Stufen zu bringen ergibt Punkte von einem
                    Bildpunkt Kantenlaenge, und das ist aus zwei Metern Abstand kein
                    Muster mehr, sondern gleichmaessiges Rauschen. Jedes Programm fuer
                    diesen Blick verkleinert erst, rastert dann und vergroessert
                    hinterher mit harten Kanten zurueck.
                -->
                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_DitherPixels}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="DitherPixelsValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="DitherPixelsSlider" Style="{StaticResource PanelSlider}"
                        Minimum="1" Maximum="24" Value="1" SmallChange="1" LargeChange="4"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="1"
                        ToolTip="{DynamicResource S_DitherPixelsHint}" />

                <!--
                    Und die Hoehe getrennt. Ohne sie sieht ein Raster nie wie eine
                    Schraffur aus: Quadratische Rasterpunkte ergeben Punkte, breite
                    und flache ergeben Striche - und benachbarte Striche einer Zeile
                    verschmelzen zu einer Linie, die der Form folgt.
                -->
                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_DitherPixelsTall}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="DitherPixelsTallValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="DitherPixelsTallSlider" Style="{StaticResource PanelSlider}"
                        Minimum="1" Maximum="24" Value="1" SmallChange="1" LargeChange="4"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="1"
                        ToolTip="{DynamicResource S_DitherPixelsTallHint}" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_DitherSize}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="DitherSizeValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="DitherSizeSlider" Style="{StaticResource PanelSlider}"
                        Minimum="1" Maximum="8" Value="2" SmallChange="1" LargeChange="2"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="2" />

                <!--
                    ALLE Verfahren in EINER Liste.

                    Sie standen eine Weile in zweien: erst die Art waehlen, dann bei
                    der Fehlerdiffusion noch das Schema. Das spiegelte sauber, wie
                    gerechnet wird - die ersten drei sind Ortswerkzeuge, die uebrigen
                    Durchgaenge ueber das ganze Bild -, und genau das war der Fehler.
                    Wer ein Raster sucht, sucht einen NAMEN und keine Passart;
                    Atkinson steckte dadurch zwei Ebenen tief und war nicht zu finden,
                    solange man nicht schon wusste, dass es ihn gibt.
                -->
                <ComboBox x:Name="DitherPatternBox" Style="{StaticResource OverlayCombo}"
                          HorizontalAlignment="Left" Width="180" Margin="0,10,0,0"
                          SelectedIndex="0" SelectionChanged="OnDitherPattern"
                          ToolTip="{DynamicResource S_DitherPatternHint}">
                    <ComboBoxItem Style="{StaticResource OverlayComboItem}"
                                  Content="{DynamicResource S_DitherOrdered}" />
                    <ComboBoxItem Style="{StaticResource OverlayComboItem}"
                                  Content="{DynamicResource S_DitherNoise}" />
                    <ComboBoxItem Style="{StaticResource OverlayComboItem}"
                                  Content="{DynamicResource S_DitherLines}" />
                    <!-- Ab hier die Fehlerdiffusionen, beim Namen genannt. -->
                    <ComboBoxItem Style="{StaticResource OverlayComboItem}" Content="Floyd-Steinberg" />
                    <ComboBoxItem Style="{StaticResource OverlayComboItem}" Content="Atkinson" />
                    <ComboBoxItem Style="{StaticResource OverlayComboItem}" Content="Jarvis-Judice-Ninke" />
                    <ComboBoxItem Style="{StaticResource OverlayComboItem}" Content="Stucki" />
                    <ComboBoxItem Style="{StaticResource OverlayComboItem}" Content="Burkes" />
                    <ComboBoxItem Style="{StaticResource OverlayComboItem}" Content="Sierra" />
                </ComboBox>

                <!--
                    Nur fuer das Linienraster. Sichtbar statt nur unwirksam: Ein
                    Regler, der je nach Muster etwas tut oder nicht, ist schwerer zu
                    verstehen als einer, der verschwindet.
                -->

                <Grid x:Name="DitherAngleHeader" Visibility="Collapsed" Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_DitherAngle}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="DitherAngleValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="DitherAngleSlider" Style="{StaticResource PanelSlider}"
                        Visibility="Collapsed"
                        Minimum="0" Maximum="180" Value="0" SmallChange="1" LargeChange="15"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

                <!--
                    Zweifarbig. Der Schalter, ohne den ein gerastertes Farbbild in
                    drei unabhaengige Punktwolken zerfaellt - und die einzige Art,
                    hier ueberhaupt Farbe zu bekommen: Dieser Durchgang laeuft ganz am
                    Ende, nach allen Farbwerkzeugen.
                -->
                <ToggleButton x:Name="DitherDuotoneButton" Style="{StaticResource OverlayToggle}"
                              HorizontalAlignment="Left" Margin="0,12,0,0" Padding="8,1" FontSize="10"
                              Content="{DynamicResource S_DitherDuotone}"
                              Checked="OnDitherPattern" Unchecked="OnDitherPattern"
                              ToolTip="{DynamicResource S_DitherDuotoneHint}" />

                <Grid x:Name="DitherHueHeader" Visibility="Collapsed" Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_DitherHue}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="DitherHueValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="DitherHueSlider" Style="{StaticResource PanelSlider}"
                        Visibility="Collapsed"
                        Minimum="0" Maximum="360" Value="210" SmallChange="1" LargeChange="30"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="210" />

                <Grid x:Name="DitherSaturationHeader" Visibility="Collapsed" Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_DitherSaturation}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="DitherSaturationValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="DitherSaturationSlider" Style="{StaticResource PanelSlider}"
                        Visibility="Collapsed"
                        Minimum="0" Maximum="1" Value="0.8" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0.8" />

                <TextBlock Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{DynamicResource S_DitherHint}" />
            </StackPanel>

            <Grid x:Name="GrainHead" Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource S_Grain}" Style="{StaticResource PanelHeading}" />
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Content="+" Tag="GrainBody" Click="OnSectionToggled" />
            </Grid>
            <StackPanel x:Name="GrainBody" Visibility="Collapsed" Margin="0,6,0,0">
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="{DynamicResource S_GrainAmount}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="GrainValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="GrainSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0" Maximum="1" Value="0" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_GrainSize}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="GrainSizeValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="GrainSizeSlider" Style="{StaticResource PanelSlider}"
                        Minimum="1" Maximum="12" Value="2" SmallChange="1" LargeChange="2"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="2" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_GrainRoughness}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="GrainRoughnessValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="GrainRoughnessSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0" Maximum="1" Value="0.4" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0.4" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_GrainColour}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="GrainColourValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="GrainColourSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0" Maximum="1" Value="0.2" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0.2" />

                <TextBlock Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{DynamicResource S_GrainHint}" />
            </StackPanel>

            <ToggleButton x:Name="GroupLut" Style="{StaticResource SectionHeader}"
                          Margin="0,18,0,2" IsChecked="True" Tag="Lut"
                          Content="{DynamicResource S_GroupTable}"
                          Checked="OnGroupToggled" Unchecked="OnGroupToggled" />
            <!-- Tabelle -->
            <Grid x:Name="LutHead" Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource S_Lut}" Style="{StaticResource PanelHeading}" />
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Content="+" Tag="LutBody" Click="OnSectionToggled" />
            </Grid>
            <StackPanel x:Name="LutBody" Visibility="Collapsed" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LutPathText" Grid.Column="0" VerticalAlignment="Center"
                               FontSize="10" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,6,0"
                               Text="{DynamicResource S_NoLut}" />
                    <Button Grid.Column="1" Style="{StaticResource OverlayButton}"
                            Content="…" Click="OnPickLutClicked" MinWidth="34" />
                </Grid>

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_Strength}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="LutStrengthValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="LutStrengthSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0" Maximum="1" Value="1" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="1" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
