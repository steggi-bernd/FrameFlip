<UserControl x:Class="FrameFlip.Views.GradingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FrameFlip.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,14">

            <!-- Verteilung -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="{DynamicResource S_Distribution}" Style="{StaticResource PanelHeading}" />
                <Button x:Name="HistogramModeButton" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right" Content="RGB" Click="OnHistogramModeClicked"
                        ToolTip="{DynamicResource S_RgbToggle}" />
            </Grid>

            <local:HistogramView x:Name="Histogram" Margin="0,0,0,4" />

            <TextBlock x:Name="ClipText" Margin="0,0,0,4" FontSize="10"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

            <!-- Grundkorrektur -->
            <Grid Margin="0,10,0,6">
                <TextBlock Text="{DynamicResource S_Correction}" Style="{StaticResource PanelHeading}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource LinkButton}" Margin="0,0,10,0"
                            Content="{DynamicResource S_Reset}" Click="OnResetBasicClicked" />
                    <Button Style="{StaticResource LinkButton}" Content="−"
                            Tag="BasicBody" Click="OnSectionToggled" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="BasicBody">
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="{DynamicResource S_Exposure}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="ExposureValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="ExposureSlider" Style="{StaticResource PanelSlider}"
                        Minimum="-6" Maximum="6" Value="0" SmallChange="0.05" LargeChange="0.25"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_Gamma}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="GammaValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="GammaSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0.2" Maximum="3" Value="1" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="1" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_Contrast}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="ContrastValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="ContrastSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0" Maximum="3" Value="1" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="1" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_Saturation}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="SaturationValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="SaturationSlider" Style="{StaticResource PanelSliderTinted}"
                        Background="{StaticResource TrackSaturation}"
                        Minimum="0" Maximum="3" Value="1" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="1" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_BlackPoint}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="BlackValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="BlackSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0" Maximum="0.9" Value="0" SmallChange="0.01" LargeChange="0.05"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_WhitePoint}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="WhiteValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="WhiteSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0.1" Maximum="2" Value="1" SmallChange="0.01" LargeChange="0.05"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="1" />
            </StackPanel>

            <!-- Kurven -->
            <Grid Margin="0,16,0,6">
                <TextBlock Text="{DynamicResource S_Curves}" Style="{StaticResource PanelHeading}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource LinkButton}" Margin="0,0,10,0"
                            Content="{DynamicResource S_Reset}" Click="OnResetCurveClicked" />
                    <Button Style="{StaticResource LinkButton}" Content="−"
                            Tag="CurveBody" Click="OnSectionToggled" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="CurveBody">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="CurveMasterButton" Grid.Column="0" Style="{StaticResource OverlayToggle}"
                                  Margin="0,0,2,0" Content="RGB" IsChecked="True" Tag="0"
                                  Checked="OnCurveChannelPicked" />
                    <ToggleButton x:Name="CurveRedButton" Grid.Column="1" Style="{StaticResource OverlayToggle}"
                                  Margin="2,0,2,0" Content="R" Tag="1" Checked="OnCurveChannelPicked" />
                    <ToggleButton x:Name="CurveGreenButton" Grid.Column="2" Style="{StaticResource OverlayToggle}"
                                  Margin="2,0,2,0" Content="G" Tag="2" Checked="OnCurveChannelPicked" />
                    <ToggleButton x:Name="CurveBlueButton" Grid.Column="3" Style="{StaticResource OverlayToggle}"
                                  Margin="2,0,0,0" Content="B" Tag="3" Checked="OnCurveChannelPicked" />
                </Grid>

                <local:CurveEditor x:Name="CurveField" />

                <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Text="{DynamicResource S_CurveHint}" />
            </StackPanel>

            <!-- Weissabgleich -->
            <Grid Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource S_WhiteBalance}" Style="{StaticResource PanelHeading}" />
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Content="+" Tag="WhiteBalanceBody" Click="OnSectionToggled" />
            </Grid>
            <StackPanel x:Name="WhiteBalanceBody" Visibility="Collapsed" Margin="0,6,0,0">
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="{DynamicResource S_Temperature}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="TemperatureValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <!--
                    Der Regler laeuft in Mired (Millionstel reziproke Kelvin), nicht in
                    Kelvin: Ein Schritt von 1000 K bewirkt bei 2000 K das Dreissigfache
                    dessen, was er bei 14000 K bewirkt - die rechte Haelfte eines
                    Kelvin-Reglers taete praktisch nichts. In Mired sind die Schritte
                    ueber den ganzen Weg gleich gross.

                    Umgekehrte Richtung, weil weniger Mired mehr Kelvin heisst und der
                    Regler nach rechts waermer werden soll.
                -->
                <Slider x:Name="TemperatureSlider" Style="{StaticResource PanelSliderTinted}"
                        Background="{StaticResource TrackTemperature}"
                        Minimum="66.7" Maximum="500" Value="153.8"
                        SmallChange="2" LargeChange="10" IsDirectionReversed="True"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="153.8" />

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_Tint}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="TintValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="TintSlider" Style="{StaticResource PanelSliderTinted}"
                        Background="{StaticResource TrackTint}"
                        Minimum="-100" Maximum="100" Value="0" SmallChange="1" LargeChange="5"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0" />
            </StackPanel>

            <!-- Dynamik -->
            <Grid Margin="0,16,0,2">
                <TextBlock Text="{DynamicResource S_Vibrance}" Style="{StaticResource PanelLabel}" />
                <TextBlock x:Name="VibranceValue" Style="{StaticResource PanelValue}" />
            </Grid>
            <Slider x:Name="VibranceSlider" Style="{StaticResource PanelSliderTinted}"
                        Background="{StaticResource TrackVibrance}"
                    Minimum="-1" Maximum="1" Value="0" SmallChange="0.02" LargeChange="0.1"
                    ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

            <!-- Zonen -->
            <Grid Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource S_Zones}" Style="{StaticResource PanelHeading}" />
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Content="+" Tag="ZonesBody" Click="OnSectionToggled" />
            </Grid>
            <StackPanel x:Name="ZonesBody" Visibility="Collapsed" Margin="0,6,0,0">
                <!--
                    Drei Raeder nebeneinander, darunter je ein Regler fuer die
                    Helligkeit. Ein Rad hat zwei Freiheitsgrade, eine Zone hat drei -
                    die Aufteilung entspricht dem, wonach man greift: "waermer" ist
                    eine Richtung, "heller" ist es nicht.

                    Das Rad verschiebt die Kanaele so gegeneinander, dass ihre Summe
                    null bleibt. Es aendert also nie die Helligkeit, auch nicht ein
                    bisschen - sonst zoege jeder Griff ins Farbige den
                    Helligkeitsregler hinter sich her.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource S_Shadows}" Style="{StaticResource PanelLabel}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <local:ColourWheel x:Name="LiftWheel" Width="82" Height="82" />
                        <Slider x:Name="LiftBrightSlider" Style="{StaticResource PanelSlider}"
                                Margin="4,4,4,0" Minimum="-0.25" Maximum="0.25" Value="0"
                                SmallChange="0.005" LargeChange="0.02"
                                ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0" />
                        <TextBlock x:Name="LiftValues" FontSize="9" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource S_Midtones}" Style="{StaticResource PanelLabel}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <local:ColourWheel x:Name="GammaWheel" Width="82" Height="82" />
                        <Slider x:Name="GammaBrightSlider" Style="{StaticResource PanelSlider}"
                                Margin="4,4,4,0" Minimum="-0.6" Maximum="1.0" Value="0"
                                SmallChange="0.02" LargeChange="0.1"
                                ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0" />
                        <TextBlock x:Name="GammaValues" FontSize="9" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource S_Highlights}" Style="{StaticResource PanelLabel}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <local:ColourWheel x:Name="GainWheel" Width="82" Height="82" />
                        <Slider x:Name="GainBrightSlider" Style="{StaticResource PanelSlider}"
                                Margin="4,4,4,0" Minimum="-0.5" Maximum="0.8" Value="0"
                                SmallChange="0.01" LargeChange="0.05"
                                ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="0" />
                        <TextBlock x:Name="GainValues" FontSize="9" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Text="{DynamicResource S_ZonesHint}" />
            </StackPanel>

            <!-- Farbbereiche -->
            <Grid Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource S_ColourBands}" Style="{StaticResource PanelHeading}" />
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Content="+" Tag="BandsBody" Click="OnSectionToggled" />
            </Grid>
            <StackPanel x:Name="BandsBody" Visibility="Collapsed" Margin="0,6,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="BandHueButton" Grid.Column="0" Style="{StaticResource OverlayToggle}"
                                  Margin="0,0,2,0" Content="{DynamicResource S_Hue}" IsChecked="True" Tag="0"
                                  Checked="OnBandModePicked" />
                    <ToggleButton x:Name="BandSatButton" Grid.Column="1" Style="{StaticResource OverlayToggle}"
                                  Margin="2,0,2,0" Content="{DynamicResource S_Saturation}" Tag="1"
                                  Checked="OnBandModePicked" />
                    <ToggleButton x:Name="BandLumButton" Grid.Column="2" Style="{StaticResource OverlayToggle}"
                                  Margin="2,0,0,0" Content="{DynamicResource S_Luminance}" Tag="2"
                                  Checked="OnBandModePicked" />
                </Grid>

                <StackPanel x:Name="BandSliders" />
            </StackPanel>

            <!-- Tabelle -->
            <Grid Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource S_Lut}" Style="{StaticResource PanelHeading}" />
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Content="+" Tag="LutBody" Click="OnSectionToggled" />
            </Grid>
            <StackPanel x:Name="LutBody" Visibility="Collapsed" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LutPathText" Grid.Column="0" VerticalAlignment="Center"
                               FontSize="10" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,6,0"
                               Text="{DynamicResource S_NoLut}" />
                    <Button Grid.Column="1" Style="{StaticResource OverlayButton}"
                            Content="…" Click="OnPickLutClicked" MinWidth="34" />
                </Grid>

                <Grid Margin="0,10,0,2">
                    <TextBlock Text="{DynamicResource S_Strength}" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="LutStrengthValue" Style="{StaticResource PanelValue}" />
                </Grid>
                <Slider x:Name="LutStrengthSlider" Style="{StaticResource PanelSlider}"
                        Minimum="0" Maximum="1" Value="1" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnChanged" MouseDoubleClick="OnSliderReset" Tag="1" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
