<UserControl x:Class="FrameFlip.Views.LayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FrameFlip.Views">

    <UserControl.Resources>

        <!--
            Eine Zeile der Ebenenliste. Schmal, weil der Streifen 300 Punkte breit
            ist und darunter noch die ganze Farbkorrektur steht: Zwei Zeilen je
            Ebene wuerden bei acht Passen die Werkzeuge aus dem Fenster schieben.

            Die Auswahl zeigt sich als Strich links und nicht als eingefaerbte
            Zeile - dieselbe Loesung wie in den Auswahllisten, und sie bleibt auch
            dann lesbar, wenn die Liste lang ist.
        -->
        <Style x:Key="LayerRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="2,1">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" />
                            <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,3"
                                    Background="{StaticResource AccentBrush}" CornerRadius="2" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource ControlBrush}" />
                                <Setter TargetName="Marker" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Der Punkt links in jeder Zeile: sichtbar oder nicht.

            Ein Auge waere das gewohnte Zeichen, braucht aber eine Schriftart, auf
            die kein Verlass ist. Ein gefuellter und ein leerer Kreis sagen dasselbe
            und stehen auf jedem Rechner gleich.
        -->
        <Style x:Key="LayerEye" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Width="10" Height="10" StrokeThickness="1.2"
                                     Stroke="{StaticResource MutedBrush}" />
                            <Ellipse x:Name="Dot" Width="10" Height="10"
                                     Fill="{StaticResource ForegroundBrush}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Der Kopf ist ein BALKEN und keine Zeile mit Abstand darunter.

            Gemeldet wurde, dass nicht zu erkennen ist, wo der Ebenenbereich aufhoert
            und die Farbkorrektur anfaengt. Das lag nicht an zu wenig Abstand - mit
            Abstand allein sieht ein Ende aus wie eine Luecke. Eine eigene Flaeche mit
            einer Linie darunter ist eine Grenze, und sie kostet keine Hoehe, die
            nicht ohnehin fuer die Ueberschrift draufginge.

            Und er bleibt STEHEN: Er sitzt ausserhalb der Bildlaufflaeche. Ein Kopf,
            der beim Rollen verschwindet, beantwortet die Frage "wo bin ich hier"
            genau dann nicht mehr, wenn sie gestellt wird.
        -->
        <Border Grid.Row="0" Height="28"
                Background="{StaticResource OverlayBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <TextBlock Text="{DynamicResource S_Layers}" Style="{StaticResource PanelHeading}"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="ResetButton" Style="{StaticResource LinkButton}" Margin="0,0,6,0"
                            Content="{DynamicResource S_ResetLayers}" Click="OnResetClicked" />
                    <Button x:Name="FoldButton" Style="{StaticResource StripButton}" Content="−"
                            Click="OnFoldClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="14,10,14,12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

        <StackPanel x:Name="Body">

            <!--
                Die Liste steht oben und die Werkzeuge darunter, weil die Ebene
                entscheidet, worauf die Regler wirken. Umgekehrt herum stellte man
                etwas ein und suchte danach, woran.
            -->
            <Border Background="{StaticResource OverlayBackground}"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    CornerRadius="4,4,0,0" Padding="0,3,0,0">
                <!--
                    Der Strich liegt UEBER der Liste und faengt keine Maus: Er zeigt
                    beim Ziehen, wo die Zeile landen wuerde, und darf dabei nicht
                    selbst im Weg sein.

                    Die Liste ist ansprechbar - ohne Fokus gibt es keine Tasten, und
                    eine Ebenenliste ohne Entfernen-Taste fuehlt sich kaputt an.
                -->
                <Grid>
                    <ListBox x:Name="LayerList" MaxHeight="300" MinHeight="96" Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource LayerRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSelectionChanged"
                             PreviewKeyDown="OnListKeyDown"
                             PreviewMouseLeftButtonDown="OnRowPressed"
                             PreviewMouseMove="OnRowDragging"
                             AllowDrop="True" Drop="OnFilesDropped" DragOver="OnFilesDragOver"
                             ToolTip="{DynamicResource S_DropHere}" />

                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="DropLine" Height="2" Visibility="Collapsed"
                                   Fill="{StaticResource AccentBrush}" />
                    </Canvas>
                </Grid>
            </Border>

            <!--
                Die Leiste gehoert zur LISTE und nicht in den Streifen darunter.

                Vorher stand sie frei zwischen der Liste und den Reglern der gewaehlten
                Ebene, mit acht sichtbaren Kaesten - und teilte den Bereich genau dort,
                wo er zusammengehoert. Angesetzt an die Liste, mit derselben Flaeche
                und ohne Fuge, liest sie sich als das, was sie ist: die Werkzeuge
                dieser Liste.
            -->
            <Border Background="{StaticResource OverlayBackground}"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,1,1"
                    CornerRadius="0,0,4,4" Padding="5,3">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AddButton" Style="{StaticResource StripButton}" Content="+" Click="OnAddClicked"
                                ToolTip="{DynamicResource S_AddLayer}" />
                        <Button x:Name="DuplicateButton" Style="{StaticResource StripButton}"
                                Content="❐" Click="OnDuplicateClicked"
                                ToolTip="{DynamicResource S_DuplicateLayer}" />
                        <Button x:Name="RemoveButton" Style="{StaticResource StripButton}"
                                Content="✕" Click="OnRemoveClicked"
                                ToolTip="{DynamicResource S_RemoveLayer}" />

                        <!--
                            Die Schnittmaske. Fuer Renderpasse ist sie keine Feinheit,
                            sondern die Bedingung dafuer, dass die Rechnung aufgeht:
                            Ein Farbpass ist ein Faktor seines Lichtpasses und nicht
                            des ganzen Stapels darunter.
                        -->
                        <Button x:Name="ClipButton" Style="{StaticResource StripButton}"
                                Content="↳" Click="OnClipClicked"
                                ToolTip="{DynamicResource S_ClipLayer}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!--
                            Ein- und ausruecken statt Ziehen und Fallenlassen: Eine Maus,
                            die eine Zeile in eine Gruppe zieht, trifft im schmalen
                            Streifen daneben, und das Ergebnis sieht man erst hinterher.
                        -->
                        <Button x:Name="IndentButton" Style="{StaticResource StripButton}" Content="▶" Click="OnIndentClicked"
                                ToolTip="{DynamicResource S_MoveIntoGroup}" />
                        <Button x:Name="OutdentButton" Style="{StaticResource StripButton}"
                                Margin="0,0,8,0" Content="◀" Click="OnOutdentClicked"
                                ToolTip="{DynamicResource S_MoveOutOfGroup}" />

                        <Button x:Name="UpButton" Style="{StaticResource StripButton}" Content="▲" Click="OnUpClicked"
                                ToolTip="{DynamicResource S_MoveLayerUp}" />
                        <Button x:Name="DownButton" Style="{StaticResource StripButton}"
                                Content="▼" Click="OnDownClicked"
                                ToolTip="{DynamicResource S_MoveLayerDown}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Was auf die gewaehlte Ebene wirkt -->
            <StackPanel x:Name="LayerTools" Margin="0,10,0,0">
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="{DynamicResource S_BlendMode}" Style="{StaticResource PanelLabel}" />

                    <!--
                        Der Schalter steht NEBEN der Mischung, weil er zu ihr gehoert:
                        Er sagt nicht, was gemischt wird, sondern worin. Ein eigener
                        Abschnitt weiter unten liesse die beiden Fragen getrennt
                        aussehen, und sie sind es nicht.
                    -->
                    <ToggleButton x:Name="BlendSpaceButton" Style="{StaticResource OverlayToggle}"
                                  HorizontalAlignment="Right" Padding="6,1" FontSize="10"
                                  Content="{DynamicResource S_BlendSpace}"
                                  ToolTip="{DynamicResource S_BlendSpaceHint}"
                                  Click="OnBlendSpaceChanged" />
                </Grid>
                <ComboBox x:Name="ModeBox" Style="{StaticResource OverlayCombo}"
                          SelectionChanged="OnModeChanged" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Dasselbe Rad wie bei den Zonen, und aus demselben Grund: Die
                        Farbe einer Ebene ist eine Richtung, keine drei Zahlen. Die
                        Kanaele gehen dabei so gegeneinander, dass ihre Summe null
                        bleibt - eingefaerbt wird, ohne dass es heller oder dunkler
                        wird. Dafuer ist der Regler daneben da.
                    -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <local:ColourWheel x:Name="TintWheel" Width="66" Height="66" />
                        <TextBlock Text="{DynamicResource S_LayerTint}" Style="{StaticResource PanelLabel}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="{DynamicResource S_Opacity}" Style="{StaticResource PanelLabel}" />
                            <TextBlock x:Name="OpacityValue" Style="{StaticResource PanelValue}" />
                        </Grid>
                        <Slider x:Name="OpacitySlider" Style="{StaticResource PanelSlider}"
                                Minimum="0" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.05"
                                ValueChanged="OnSliderChanged" MouseDoubleClick="OnSliderReset" Tag="1" />

                        <Grid Margin="0,10,0,2">
                            <TextBlock Text="{DynamicResource S_Exposure}" Style="{StaticResource PanelLabel}" />
                            <TextBlock x:Name="LayerExposureValue" Style="{StaticResource PanelValue}" />
                        </Grid>
                        <Slider x:Name="LayerExposureSlider" Style="{StaticResource PanelSlider}"
                                Minimum="-6" Maximum="6" Value="0" SmallChange="0.05" LargeChange="0.25"
                                ValueChanged="OnSliderChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

                        <!--
                            Nur fuer Bildebenen: Ein Pass bringt keine Deckung mit,
                            die zu saeubern waere - dort heisst Alpha "hier wurde
                            nichts getroffen", und die Farbe daneben ist trotzdem
                            echt.
                        -->
                        <!--
                            Eine gemeinsame Ueberschrift ueber beide.

                            Einzeln waren die Namen nicht einzuordnen - sie sagten,
                            WORAN gedreht wird, und nicht, was dabei passiert. Als
                            Paar unter einer Ueberschrift ist beides in einem Blick da:
                            zwei Richtungen auf derselben Zahl.
                        -->
                        <TextBlock x:Name="MatteGroup" Visibility="Collapsed"
                                   Margin="0,14,0,0" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="{DynamicResource S_MatteGroup}"
                                   ToolTip="{DynamicResource S_MatteGroupHint}" />

                        <Grid x:Name="MatteHeader" Margin="0,6,0,2" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource S_Matte}" Style="{StaticResource PanelLabel}" />
                            <TextBlock x:Name="MatteValue" Style="{StaticResource PanelValue}" />
                        </Grid>
                        <Slider x:Name="MatteSlider" Style="{StaticResource PanelSlider}"
                                Visibility="Collapsed"
                                Minimum="0" Maximum="0.2" Value="0" SmallChange="0.004" LargeChange="0.02"
                                ValueChanged="OnSliderChanged" MouseDoubleClick="OnSliderReset" Tag="0"
                                ToolTip="{DynamicResource S_MatteHint}" />

                        <!--
                            Der Gegenregler, und er steht direkt darunter, weil beide
                            an derselben Zahl ziehen: Der eine entscheidet, ab wann
                            eine Deckung als nicht vorhanden gilt, der andere zieht
                            sie zum Vollen hin. Getrennt in zwei Abschnitte gelegt
                            saehen sie aus wie zwei Themen, und man haette sie nie
                            nebeneinander ausprobiert.
                        -->
                        <Grid x:Name="RevealHeader" Margin="0,10,0,2" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource S_Reveal}" Style="{StaticResource PanelLabel}" />
                            <TextBlock x:Name="RevealValue" Style="{StaticResource PanelValue}" />
                        </Grid>
                        <Slider x:Name="RevealSlider" Style="{StaticResource PanelSlider}"
                                Visibility="Collapsed"
                                Minimum="0" Maximum="1" Value="0" SmallChange="0.01" LargeChange="0.1"
                                ValueChanged="OnSliderChanged" MouseDoubleClick="OnSliderReset" Tag="0"
                                ToolTip="{DynamicResource S_RevealHint}" />
                    </StackPanel>
                </Grid>

                <!--
                    Platzierung: wo die Ebene liegt, wie gross sie ist, was von ihr
                    gilt. Alles in Anteilen der Bildgroesse - ein Rezept von 1080p
                    gilt damit auch fuer 4K.
                -->
                <Grid x:Name="PlaceHeader" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource S_Place}" Style="{StaticResource PanelHeading}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource LinkButton}" Margin="0,0,10,0"
                                Content="{DynamicResource S_PlaceReset}" Click="OnResetPlaceClicked" />
                        <Button x:Name="PlaceFoldButton" Style="{StaticResource LinkButton}"
                                Content="+" Click="OnPlaceFoldClicked" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="PlaceBody" Visibility="Collapsed" Margin="0,6,0,0">
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="{DynamicResource S_PlaceX}" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="PlaceXValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="PlaceXSlider" Style="{StaticResource PanelSlider}"
                            Minimum="-1" Maximum="1" Value="0" SmallChange="0.01" LargeChange="0.05"
                            ValueChanged="OnPlaceChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

                    <Grid Margin="0,8,0,2">
                        <TextBlock Text="{DynamicResource S_PlaceY}" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="PlaceYValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="PlaceYSlider" Style="{StaticResource PanelSlider}"
                            Minimum="-1" Maximum="1" Value="0" SmallChange="0.01" LargeChange="0.05"
                            ValueChanged="OnPlaceChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

                    <Grid Margin="0,8,0,2">
                        <TextBlock Text="{DynamicResource S_PlaceScale}" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="PlaceScaleValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="PlaceScaleSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0.05" Maximum="3" Value="1" SmallChange="0.01" LargeChange="0.1"
                            ValueChanged="OnPlaceChanged" MouseDoubleClick="OnSliderReset" Tag="1" />

                    <Grid Margin="0,8,0,2">
                        <TextBlock Text="{DynamicResource S_PlaceRotation}" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="PlaceRotationValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <!--
                        Von -180 bis 180 und nicht von 0 bis 360: Eine Drehung um ein
                        paar Grad nach links ist der haeufigste Griff, und sie soll
                        nicht am anderen Ende des Reglers liegen.
                    -->
                    <Slider x:Name="PlaceRotationSlider" Style="{StaticResource PanelSlider}"
                            Minimum="-180" Maximum="180" Value="0" SmallChange="1" LargeChange="15"
                            ValueChanged="OnPlaceChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

                    <TextBlock Text="{DynamicResource S_Crop}" Style="{StaticResource PanelLabel}"
                               Margin="0,12,0,4" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="{DynamicResource S_CropLeft}" Style="{StaticResource PanelLabel}" />
                            <Slider x:Name="CropLeftSlider" Style="{StaticResource PanelSlider}"
                                    Minimum="0" Maximum="0.9" Value="0" SmallChange="0.01"
                                    ValueChanged="OnPlaceChanged" MouseDoubleClick="OnSliderReset" Tag="0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{DynamicResource S_CropRight}" Style="{StaticResource PanelLabel}" />
                            <Slider x:Name="CropRightSlider" Style="{StaticResource PanelSlider}"
                                    Minimum="0" Maximum="0.9" Value="0" SmallChange="0.01"
                                    ValueChanged="OnPlaceChanged" MouseDoubleClick="OnSliderReset" Tag="0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,4,0">
                            <TextBlock Text="{DynamicResource S_CropTop}" Style="{StaticResource PanelLabel}" />
                            <Slider x:Name="CropTopSlider" Style="{StaticResource PanelSlider}"
                                    Minimum="0" Maximum="0.9" Value="0" SmallChange="0.01"
                                    ValueChanged="OnPlaceChanged" MouseDoubleClick="OnSliderReset" Tag="0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,8,0,0">
                            <TextBlock Text="{DynamicResource S_CropBottom}" Style="{StaticResource PanelLabel}" />
                            <Slider x:Name="CropBottomSlider" Style="{StaticResource PanelSlider}"
                                    Minimum="0" Maximum="0.9" Value="0" SmallChange="0.01"
                                    ValueChanged="OnPlaceChanged" MouseDoubleClick="OnSliderReset" Tag="0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{DynamicResource S_PlaceHint}" />
                </StackPanel>

                <!--
                    Die Maske. Ein Wert je Bildpunkt, der sagt, wie stark die Ebene
                    dort wirkt - sie multipliziert die Deckkraft und sonst nichts.
                    Deshalb steht sie hier, gleich unter ihr: Es ist dieselbe
                    Groesse, nur oertlich statt ueberall.
                -->
                <Grid Margin="0,12,0,0">
                    <TextBlock Text="{DynamicResource S_Mask}" Style="{StaticResource PanelHeading}" />
                    <Button x:Name="MaskFoldButton" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right" Content="+"
                            Click="OnMaskFoldClicked" />
                </Grid>

                <StackPanel x:Name="MaskBody" Visibility="Collapsed" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="MaskBox" Grid.Column="0" Style="{StaticResource OverlayCombo}"
                                  SelectionChanged="OnMaskKindChanged" />

                        <ToggleButton x:Name="MaskInvertButton" Grid.Column="1"
                                      Style="{StaticResource OverlayToggle}" Margin="6,0,0,0"
                                      MinWidth="34" Content="±"
                                      Checked="OnMaskInvertChanged" Unchecked="OnMaskInvertChanged"
                                      ToolTip="{DynamicResource S_MaskInvert}" />
                    </Grid>

                    <!-- Welcher Pass die Maske traegt -->
                    <ComboBox x:Name="MaskSourceBox" Style="{StaticResource OverlayCombo}"
                              Margin="0,6,0,0" Visibility="Collapsed"
                              SelectionChanged="OnMaskSourceChanged" />

                    <!-- Helligkeit, Untergrund, Pass: ein Bereich mit weichen Kanten -->
                    <StackPanel x:Name="MaskRangeBody" Visibility="Collapsed">
                        <Grid Margin="0,10,0,2">
                            <TextBlock x:Name="MaskLowLabel" Text="{DynamicResource S_MaskFrom}"
                                       Style="{StaticResource PanelLabel}" />
                            <TextBlock x:Name="MaskLowValue" Style="{StaticResource PanelValue}" />
                        </Grid>
                        <Slider x:Name="MaskLowSlider" Style="{StaticResource PanelSlider}"
                                Minimum="0" Maximum="1" Value="0" SmallChange="0.01" LargeChange="0.05"
                                ValueChanged="OnMaskSliderChanged" MouseDoubleClick="OnSliderReset" Tag="0" />

                        <Grid Margin="0,8,0,2">
                            <TextBlock x:Name="MaskHighLabel" Text="{DynamicResource S_MaskTo}"
                                       Style="{StaticResource PanelLabel}" />
                            <TextBlock x:Name="MaskHighValue" Style="{StaticResource PanelValue}" />
                        </Grid>
                        <Slider x:Name="MaskHighSlider" Style="{StaticResource PanelSlider}"
                                Minimum="0" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.05"
                                ValueChanged="OnMaskSliderChanged" MouseDoubleClick="OnSliderReset" Tag="1" />

                        <Grid x:Name="MaskSoftRow" Margin="0,8,0,2">
                            <TextBlock Text="{DynamicResource S_MaskSoft}" Style="{StaticResource PanelLabel}" />
                            <TextBlock x:Name="MaskSoftValue" Style="{StaticResource PanelValue}" />
                        </Grid>
                        <Slider x:Name="MaskSoftSlider" Style="{StaticResource PanelSlider}"
                                Minimum="0" Maximum="0.5" Value="0.1" SmallChange="0.01" LargeChange="0.05"
                                ValueChanged="OnMaskSliderChanged" MouseDoubleClick="OnSliderReset" Tag="0.1" />
                    </StackPanel>

                    <!--
                        Kryptomatte: waehlen durch Klicken ins Bild.

                        Eine Liste von Objektnamen und kein Feld zum Eintippen -
                        die Namen stehen in der Datei, und wer sie abtippen muesste,
                        haette schon verloren.
                    -->
                    <StackPanel x:Name="MaskCryptoBody" Visibility="Collapsed" Margin="0,6,0,0">
                        <ToggleButton x:Name="CryptoPickButton" Style="{StaticResource OverlayToggle}"
                                      Content="{DynamicResource S_CryptoPick}"
                                      Checked="OnCryptoPickToggled" Unchecked="OnCryptoPickToggled" />

                        <Border Margin="0,6,0,0" Background="{StaticResource OverlayBackground}"
                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                CornerRadius="4" Padding="0,3">
                            <StackPanel>
                                <ItemsControl x:Name="CryptoPicks" />
                                <TextBlock x:Name="CryptoEmpty" Margin="10,4"
                                           FontSize="10" Foreground="{StaticResource MutedBrush}"
                                           Text="{DynamicResource S_CryptoEmpty}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Verlauf: Richtung, Mitte, Breite -->
                    <StackPanel x:Name="MaskGradientBody" Visibility="Collapsed">
                        <Grid Margin="0,10,0,2">
                            <TextBlock Text="{DynamicResource S_MaskAngle}" Style="{StaticResource PanelLabel}" />
                            <TextBlock x:Name="MaskAngleValue" Style="{StaticResource PanelValue}" />
                        </Grid>
                        <Slider x:Name="MaskAngleSlider" Style="{StaticResource PanelSlider}"
                                Minimum="0" Maximum="360" Value="90" SmallChange="1" LargeChange="15"
                                ValueChanged="OnMaskSliderChanged" MouseDoubleClick="OnSliderReset" Tag="90" />

                        <Grid Margin="0,8,0,2">
                            <TextBlock Text="{DynamicResource S_MaskCentre}" Style="{StaticResource PanelLabel}" />
                            <TextBlock x:Name="MaskCentreValue" Style="{StaticResource PanelValue}" />
                        </Grid>
                        <Slider x:Name="MaskCentreSlider" Style="{StaticResource PanelSlider}"
                                Minimum="0" Maximum="1" Value="0.5" SmallChange="0.01" LargeChange="0.05"
                                ValueChanged="OnMaskSliderChanged" MouseDoubleClick="OnSliderReset" Tag="0.5" />

                        <Grid Margin="0,8,0,2">
                            <TextBlock Text="{DynamicResource S_MaskWidth}" Style="{StaticResource PanelLabel}" />
                            <TextBlock x:Name="MaskWidthValue" Style="{StaticResource PanelValue}" />
                        </Grid>
                        <Slider x:Name="MaskWidthSlider" Style="{StaticResource PanelSlider}"
                                Minimum="0" Maximum="1.5" Value="0.5" SmallChange="0.02" LargeChange="0.1"
                                ValueChanged="OnMaskSliderChanged" MouseDoubleClick="OnSliderReset" Tag="0.5" />
                    </StackPanel>

                    <TextBlock x:Name="MaskHint" Margin="0,8,0,0" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Eine Bildebene: welche Datei, und ob sie mitlaeuft -->
                <StackPanel x:Name="ImageBody" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ImagePathText" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />

                        <Button Grid.Column="1" Style="{StaticResource OverlayButton}"
                                Content="…" MinWidth="34" Click="OnPickImageClicked" />
                    </Grid>

                    <ToggleButton x:Name="FollowButton" Style="{StaticResource OverlayToggle}"
                                  Margin="0,6,0,0" Content="{DynamicResource S_FollowSequence}"
                                  Checked="OnFollowChanged" Unchecked="OnFollowChanged" />

                    <!--
                        Ueber allem: nicht nur oben im Stapel, sondern hinter der
                        Bildwerdung. Ein Wasserzeichen soll in jedem Bild gleich
                        aussehen, egal was am Bild eingestellt ist.
                    -->
                    <ToggleButton x:Name="OnTopButton" Style="{StaticResource OverlayToggle}"
                                  Margin="0,4,0,0" Content="{DynamicResource S_OnTop}"
                                  Checked="OnOnTopChanged" Unchecked="OnOnTopChanged"
                                  ToolTip="{DynamicResource S_OnTopHint}" />

                    <TextBlock Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{DynamicResource S_ImageHint}" />
                </StackPanel>

                <TextBlock x:Name="GroupHint" Margin="0,10,0,0" FontSize="10"
                           Visibility="Collapsed"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="{DynamicResource S_GroupHint}" />

                <TextBlock x:Name="AdjustmentHint" Margin="0,10,0,0" FontSize="10"
                           Visibility="Collapsed"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="{DynamicResource S_AdjustmentHint}" />

                <TextBlock x:Name="HintText" Margin="0,10,0,0" FontSize="10"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="{DynamicResource S_LayersHint}" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
