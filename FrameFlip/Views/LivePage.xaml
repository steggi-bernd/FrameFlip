<UserControl x:Class="FrameFlip.Views.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dieselbe Reihenfolge wie in der App: erst wie weit und wie lange noch,
         dann die Maschine. Wer hinsieht, will zuerst wissen, ob es sich lohnt zu
         warten - nicht, wie warm die Karte ist. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ================================================== Leerlauf -->
            <StackPanel x:Name="IdleBlock" Margin="0,18,0,0">
                <TextBlock Text="IM LEERLAUF" FontFamily="{StaticResource DisplayFont}"
                           FontSize="44" Foreground="{StaticResource ForegroundBrush}" />
                <TextBlock Margin="0,8,0,0" MaxWidth="520" HorizontalAlignment="Left"
                           TextWrapping="Wrap" FontFamily="{StaticResource BodyFont}"
                           FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                           Text="Auf diesem Rechner läuft gerade kein Render. Sobald einer startet, steht hier der Fortschritt." />
            </StackPanel>

            <!-- ================================================== Fortschritt -->
            <Grid x:Name="ProgressBlock" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock x:Name="BigNumber" FontFamily="{StaticResource DisplayFont}"
                               FontSize="78" Foreground="{StaticResource ForegroundBrush}" />
                    <TextBlock x:Name="BigUnit" Text="%" Margin="8,0,0,12" VerticalAlignment="Bottom"
                               FontFamily="{StaticResource DisplayFont}" FontSize="30"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock x:Name="RemainingLabel" Text="RESTZEIT" HorizontalAlignment="Right"
                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                               FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="RemainingValue" Margin="0,4,0,0" HorizontalAlignment="Right"
                               FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold"
                               FontSize="30" Foreground="{StaticResource ForegroundBrush}" />
                    <TextBlock x:Name="ElapsedValue" Margin="0,4,0,0" HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <!-- Zwei Segmente statt eines Verlaufs: Violett die fertigen Frames,
                     Blau der Sample-Anteil im laufenden. Ein einzelner Balken kann
                     nicht zeigen, dass ein Frame seit vier Minuten bei 60 % steht. -->
                <Border x:Name="BarTrack" Grid.Row="1" Grid.ColumnSpan="2" Height="10" Margin="0,18,0,0"
                        CornerRadius="5" Background="{StaticResource TrackBrush}" ClipToBounds="True"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BarDone" Background="{StaticResource AccentBrush}" />
                        <Border x:Name="BarLive" Background="{StaticResource AppBlue}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <TextBlock x:Name="FrameCounter" HorizontalAlignment="Left"
                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                               FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="SampleCounter" HorizontalAlignment="Right"
                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                               FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                </Grid>

                <Border Grid.Row="3" Grid.ColumnSpan="2" Height="4" Margin="0,8,0,0"
                        CornerRadius="2" Background="{StaticResource TrackBrush}" ClipToBounds="True">
                    <Border x:Name="SampleBar" HorizontalAlignment="Left" Width="0"
                            Background="{StaticResource AppBlue}" />
                </Border>
            </Grid>

            <!-- ================================================== Maschine -->
            <TextBlock Text="MASCHINE" Margin="0,30,0,10"
                       FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                       FontSize="10" Foreground="{StaticResource AccentBrush}" />

            <UniformGrid x:Name="Tiles" Columns="3" />

            <!-- ================================================== Statuszeile -->
            <Border x:Name="PhaseBox" Margin="0,20,0,0" Padding="14,12" CornerRadius="12"
                    Background="{StaticResource AppBg2}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="PhaseText" Margin="12,0,0,0" TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="GpuName" Margin="0,14,0,0"
                       FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                       Foreground="{StaticResource FaintBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
