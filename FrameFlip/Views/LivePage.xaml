<UserControl x:Class="FrameFlip.Views.LivePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FrameFlip.Views">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{DynamicResource D_Studio}" TextWrapping="Wrap" Style="{StaticResource DesktopHeading}" /><TextBlock Text="{DynamicResource D_StudioIntro}" Foreground="{StaticResource DesktopMuted}" FontSize="12" Margin="0,7,12,0" TextWrapping="Wrap" /></StackPanel>
            <Button Grid.Column="1" Style="{StaticResource DesktopButton}" Content="{DynamicResource D_Swap}" VerticalAlignment="Top" Margin="12,4,0,0" Click="OnSwap" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="Panels" SizeChanged="OnPanelsSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="PrimaryColumn" Width="3*" /><ColumnDefinition x:Name="DividerColumn" Width="16" /><ColumnDefinition x:Name="MonitorColumn" Width="2*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel x:Name="RenderPanel" Grid.Column="0">
                    <Border Style="{StaticResource DesktopCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18"><TextBlock Text="{DynamicResource D_RenderSession}" Style="{StaticResource DesktopLabel}" /><TextBlock Text="BLENDER / FRAMEFLIP" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="9" Foreground="#878398" /></DockPanel>
                            <StackPanel x:Name="IdleBlock">
                                <Border Height="170" CornerRadius="8" Background="#14141D" BorderBrush="#34303E" BorderThickness="1" Margin="0,0,0,22">
                                    <Grid>
                                        <Path Data="M0,20 L80,20 L80,80 L0,80 Z M15,8 L95,8 L95,68 M32,40 L50,50 L32,60 Z" Stroke="#B4A0FF" StrokeThickness="1.5" Width="96" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="FRAME / FLIP" Foreground="#797087" FontFamily="Consolas" FontSize="9" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{DynamicResource D_Ready}" TextWrapping="Wrap" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource DesktopInk}" />
                                <TextBlock Text="{DynamicResource D_ReadyHint}" Margin="0,10,0,20" Foreground="{StaticResource DesktopMuted}" FontSize="12" LineHeight="19" TextWrapping="Wrap" />
                                <WrapPanel><Button Style="{StaticResource DesktopPrimary}" Content="{DynamicResource D_OpenSequence}" Click="OnOpenSequence" Margin="0,0,10,8" /><Button Style="{StaticResource DesktopButton}" Content="{DynamicResource D_BrowseProjects}" Click="OnProjects" Margin="0,0,0,8" /></WrapPanel>
                            </StackPanel>
<Grid x:Name="ProgressBlock" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock x:Name="BigNumber" FontFamily="{StaticResource DisplayFont}"
                               FontSize="78" Foreground="{StaticResource ForegroundBrush}" />
                    <TextBlock x:Name="BigUnit" Text="%" Margin="8,0,0,12" VerticalAlignment="Bottom"
                               FontFamily="{StaticResource DisplayFont}" FontSize="30"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock x:Name="RemainingLabel" Text="RESTZEIT" HorizontalAlignment="Right"
                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                               FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="RemainingValue" Margin="0,4,0,0" HorizontalAlignment="Right"
                               FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold"
                               FontSize="30" Foreground="{StaticResource ForegroundBrush}" />
                    <TextBlock x:Name="ElapsedValue" Margin="0,4,0,0" HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <!-- Zwei Segmente statt eines Verlaufs: Violett die fertigen Frames,
                     Blau der Sample-Anteil im laufenden. Ein einzelner Balken kann
                     nicht zeigen, dass ein Frame seit vier Minuten bei 60 % steht. -->
                <Border x:Name="BarTrack" Grid.Row="1" Grid.ColumnSpan="2" Height="10" Margin="0,18,0,0"
                        CornerRadius="5" Background="{StaticResource TrackBrush}" ClipToBounds="True"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BarDone" Background="{StaticResource AccentBrush}" />
                        <Border x:Name="BarLive" Background="{StaticResource AppBlue}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <TextBlock x:Name="FrameCounter" HorizontalAlignment="Left"
                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                               FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="SampleCounter" HorizontalAlignment="Right"
                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                               FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                </Grid>

                <Border Grid.Row="3" Grid.ColumnSpan="2" Height="4" Margin="0,8,0,0"
                        CornerRadius="2" Background="{StaticResource TrackBrush}" ClipToBounds="True">
                    <Border x:Name="SampleBar" HorizontalAlignment="Left" Width="0"
                            Background="{StaticResource AppBlue}" />
                </Border>
            </Grid>

            
                            <Border x:Name="PhaseBox" Visibility="Collapsed" Background="#23212F" Padding="12" CornerRadius="6" Margin="0,14,0,0"><TextBlock x:Name="PhaseText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource DesktopMuted}" TextWrapping="Wrap" /></Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DesktopCard}" Margin="0,16,0,12" Padding="18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="↗" FontSize="26" Foreground="{StaticResource DesktopAccent}" />
                            <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource D_QuickPreview}" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="HotkeyHint" FontSize="11" Foreground="{StaticResource DesktopMuted}" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Style="{StaticResource DesktopSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="{DynamicResource D_ResizePanels}" AutomationProperties.Name="Bereiche aufteilen" />
                <Border x:Name="MonitorPanel" Grid.Column="2" Style="{StaticResource DesktopCard}" Padding="18" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel><TextBlock Text="{DynamicResource D_System}" Style="{StaticResource DesktopLabel}" /><Border Background="#202D2B" CornerRadius="4" Padding="7,3" HorizontalAlignment="Right"><TextBlock Text="LIVE" FontSize="9" Foreground="#9ED5C4" /></Border></DockPanel>
                        <TextBlock x:Name="GpuName" Margin="0,12,0,18" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource DesktopMuted}" />
                        <UniformGrid x:Name="Tiles" Columns="2" />
                        <TextBlock Text="{DynamicResource D_UnknownMetric}" FontSize="10" Foreground="{StaticResource DesktopMuted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>