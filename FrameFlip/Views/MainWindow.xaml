<Window x:Class="FrameFlip.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:FrameFlip.Views"
        Title="FrameFlip"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        Background="{StaticResource DesktopBg}" Foreground="{StaticResource DesktopInk}"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Das Dashboard nach FrameFlipDesktop.dc.html: Sequenzen links, Viewer mit
         Zeitleiste und Filmstreifen in der Mitte, Metriken rechts. Der Desktop ist
         die Quelle, nicht der Spiegel des Handys - hier liegt der Ordner, hier
         laeuft der Render, hier haengt das Handy dran.

         Projekte und Einstellungen sind nicht verschwunden: Sie sitzen als Reiter
         in der Titelzeile, dort wo der Entwurf die Menues zeigt, und legen sich
         ueber die drei Spalten. Das Dashboard bleibt der Ausgangszustand. -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" />
        </Grid.LayoutTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ============================================================ Titelzeile -->
        <Border Grid.Row="0" Background="{StaticResource DesktopPanel}"
                BorderBrush="{StaticResource DesktopLine}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

<!-- Das Programmsymbol selbst, nicht eine nachgezeichnete Marke.
                     Ein zweites, aehnliches Zeichen neben dem echten waere genau die
                     Art Unterschied, die man in der Taskleiste bemerkt. -->
                <Image Grid.Column="0" Width="22" Height="22" Margin="12,0,0,0"
                       VerticalAlignment="Center" Source="{StaticResource AppMark}"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock Grid.Column="1" views:Track.Text="FRAMEFLIP" Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold" FontSize="11.5"
                           Foreground="{StaticResource DesktopInk}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="14,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="1" Height="18" Margin="0,0,14,0" Background="{StaticResource DesktopLine}" />

                    <RadioButton x:Name="NavDashboard" Style="{StaticResource DashNavTab}" IsChecked="True"
                                 Checked="OnNavChanged" Tag="dashboard">
                        <TextBlock views:Track.Text="{DynamicResource D_NavDashboard}" />
                    </RadioButton>
                    <RadioButton x:Name="NavProjects" Style="{StaticResource DashNavTab}" Margin="2,0,0,0"
                                 Checked="OnNavChanged" Tag="projects">
                        <TextBlock views:Track.Text="{DynamicResource D_NavProjects}" />
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource DashNavTab}" Margin="2,0,0,0"
                                 Checked="OnNavChanged" Tag="settings">
                        <TextBlock views:Track.Text="{DynamicResource D_NavSettings}" />
                    </RadioButton>
                    <Button Content="{DynamicResource D_Layout}" Style="{StaticResource DashGhostSmall}" Margin="12,0,0,0" Click="OnLayoutPreferences" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="PreviewBadge" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource DashLabel}" FontSize="9"
                               Foreground="{StaticResource DesktopAccent}" />
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource DesktopFaint}" />
                    <TextBlock x:Name="TitleInfo" Margin="9,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource DashMono}" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource DashWindowButton}" Click="OnMinimize"
                            ToolTip="{DynamicResource D_Minimize}" AutomationProperties.Name="Minimieren">
                        <Border Width="11" Height="1.5" Background="{Binding Foreground,
                                RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource DashWindowButton}" Click="OnMaximize"
                            ToolTip="{DynamicResource D_Maximize}" AutomationProperties.Name="Maximieren">
                        <Border x:Name="MaximizeGlyph" Width="10" Height="10" BorderThickness="1.5"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource DashWindowClose}" Click="OnCloseWindow"
                            ToolTip="{DynamicResource D_Close}" AutomationProperties.Name="Schließen">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Haarstrich: Fortschritt ueber die ganze Breite -->
        <Border Grid.Row="1" Background="#12FFFFFF">
            <Border x:Name="Hairline" HorizontalAlignment="Left" Width="0"
                    Background="{StaticResource DesktopAccent}" />
        </Border>

        <!-- ============================================================ Rumpf -->
        <Grid Grid.Row="2">

            <!-- ==================================================== Dashboard -->
            <Grid x:Name="DashboardBody" SizeChanged="OnDashboardSizeChanged">
                <Grid.RowDefinitions><RowDefinition x:Name="ViewerRow" Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="PanelsRow" Height="0"/></Grid.RowDefinitions>
<!-- Die Seitenspalten sind Anteile, keine festen Breiten. Fest hiesse:
                     Das Fenster waechst, und nur die Mitte waechst mit - bei einem
                     breiten Bildschirm steht dann ein schmaler Streifen Sequenzen
                     neben einer riesigen Buehne. Als Anteil waechst alles zusammen,
                     und Min/Max halten die Spalten dennoch in lesbaren Grenzen.
                     Der Griff dazwischen verschiebt die Anteile, nicht die Pixel. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="0.19*" MinWidth="150" MaxWidth="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="CenterColumn" Width="0.55*" MinWidth="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RightColumn" Width="0.26*" MinWidth="205" MaxWidth="520" />
                </Grid.ColumnDefinitions>

                <!-- ................................................ Sequenzen -->
                <Border x:Name="SequencePanel" Grid.Column="0" Background="{StaticResource DesktopPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="14,14,14,10">
                            <TextBlock views:Track.Text="{DynamicResource D_Sequences}"
                                       Style="{StaticResource DashLabel}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource DashGhostSmall}" HorizontalAlignment="Right"
                                    Click="OnOpenSequence" ToolTip="{DynamicResource D_OpenHint}">
                                <TextBlock views:Track.Text="{DynamicResource D_Open}" views:Track.Amount="1" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,10">
                            <StackPanel x:Name="SequenceList" />
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{StaticResource DesktopLine}" BorderThickness="0,1,0,0"
                                Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LinkDot" Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{StaticResource DesktopFaint}" />
                                    <TextBlock x:Name="LinkText" Margin="9,0,0,0" VerticalAlignment="Center"
                                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                               FontSize="10.5" Foreground="{StaticResource DesktopInk}" />
                                </StackPanel>

                                <TextBlock x:Name="LinkDetail" Margin="0,9,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource DashMono}" FontSize="9.5" LineHeight="15" />

                                <Button Style="{StaticResource DashGhost}" Height="32" Margin="0,9,0,0"
                                        Click="OnShowPairing">
                                    <TextBlock views:Track.Text="{DynamicResource D_ShowQr}" views:Track.Amount="1"
                                               FontSize="9.5" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="8" Style="{StaticResource DashboardSplitter}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ToolTip="{DynamicResource D_ResizeNav}" AutomationProperties.Name="Sequenzbereich anpassen" />

                <!-- ................................................ Viewer -->
                <Grid x:Name="ViewerPanel" SizeChanged="OnViewerPanelSizeChanged" Grid.Column="2" Background="{StaticResource DesktopBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource DesktopLine}" BorderThickness="0,0,0,1" MinHeight="44">
                        <Grid Margin="14,6">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="SequenceHeading" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="SequenceName" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="ExtraBold" FontSize="12"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           Foreground="{StaticResource DesktopInk}" />
                                <TextBlock x:Name="SequenceFile" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           Style="{StaticResource DashMono}" FontSize="9" />
                            </StackPanel>

                            <StackPanel x:Name="ViewChips" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                        </Grid>
                    </Border>

<!-- Buehne. Der Rahmen traegt das Seitenverhaeltnis des Renders und
                         fuellt den Platz, der da ist - in beide Richtungen. Mit
                         DownOnly sass ein 320x180-Render als Briefmarke in der Mitte,
                         waehrend ringsum alles frei war. -->
                    <Grid x:Name="StageArea" Grid.Row="1" Background="{StaticResource DesktopStage}" Focusable="True" MouseLeftButtonDown="OnStageFocus"
                          ClipToBounds="True">
                        <Viewbox Margin="18" Stretch="Uniform">
                            <Viewbox.Style><Style TargetType="Viewbox"><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=StageImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></Viewbox.Style>
                            <Border x:Name="StageFrame" Width="1000" Height="562" CornerRadius="10"
                                    Background="{StaticResource DashCard}"
                                    BorderBrush="{StaticResource DesktopLine}" BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="StageImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                </Grid>
                            </Border>
                        </Viewbox>
                        <ScrollViewer x:Name="EmptyStage" Visibility="{Binding Visibility, ElementName=StageEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="410" Margin="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12">
                                <TextBlock Text="{DynamicResource D_StageWelcome}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="22" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource DesktopInk}"/>
                                <TextBlock x:Name="StageEmpty" Text="{DynamicResource D_StageStartHint}" FontSize="12" LineHeight="19" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource DesktopMuted}" Margin="0,12,0,0"/>
                                <Button x:Name="EmptyOpenButton" Content="{DynamicResource D_OpenSequenceAction}" Style="{StaticResource DashPrimary}" Click="OnOpenSequence" HorizontalAlignment="Center" Padding="18,10" Margin="0,20,0,0"/>
                                <TextBlock Text="{DynamicResource D_OpenShortcut}" Style="{StaticResource DashMono}" TextAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Aufschriften liegen ueber der Buehne, nicht im Bild:
                             So bleiben sie lesbar, egal wie klein der Frame skaliert. -->
                        <StackPanel x:Name="StageAnnotations" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="30,30,0,0">
                            <Border CornerRadius="7" Padding="9,5" Background="#CC07070D">
                                <TextBlock x:Name="StageHead" Style="{StaticResource DashMono}"
                                           Foreground="{StaticResource DesktopInk}" />
                            </Border>
                            <Border CornerRadius="7" Padding="9,5" Margin="7,0,0,0" Background="#CC07070D">
                                <TextBlock x:Name="StageZoom" Style="{StaticResource DashMono}"
                                           Foreground="{StaticResource DesktopInk}" />
                            </Border>
                            <Border CornerRadius="7" Padding="9,5" Margin="7,0,0,0" Background="#CC07070D">
                                <TextBlock x:Name="StageDecode" Style="{StaticResource DashMono}"
                                           Foreground="{StaticResource DesktopInk}" />
                            </Border>
                        </StackPanel>

<!-- Aus dem Schild ist ein Schalter geworden: Es zeigte nur an,
                             dass man auf dem neuesten Bild steht. Jetzt bestimmt es, ob
                             der Kopf dort bleibt, waehrend der Render weiterschreibt. -->
<!-- Waehrend des Vorausladens. Unten mittig auf der Buehne, damit sie
                             das Bild nicht verdeckt, das gerade steht - man will beim
                             Warten sehen, worauf man wartet. -->
                        <Border x:Name="PreloadBar" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,26" CornerRadius="11" Padding="16,12" MinWidth="300"
                                Background="#E60B0B14" BorderBrush="{StaticResource DesktopLine}"
                                BorderThickness="1" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock views:Track.Text="{DynamicResource D_Preloading}"
                                               Style="{StaticResource DashLabel}" FontSize="9"
                                               VerticalAlignment="Center" />

                                    <Border x:Name="PaceChip" HorizontalAlignment="Right" CornerRadius="6"
                                            Padding="8,3" Background="{StaticResource DashAccentSoft}"
                                            BorderBrush="{StaticResource DashAccentEdge}" BorderThickness="1">
                                        <TextBlock x:Name="PaceText" AutomationProperties.AutomationId="PaceText" FontFamily="{StaticResource HeadFont}"
                                                   FontWeight="ExtraBold" FontSize="8.5"
                                                   Foreground="{StaticResource DesktopInk}" />
                                    </Border>
                                </Grid>

                                <Border Height="4" CornerRadius="2" Margin="0,10,0,0" Background="#16FFFFFF"
                                        ClipToBounds="True" SizeChanged="OnPreloadBarResized">
                                    <Border x:Name="PreloadFill" HorizontalAlignment="Left" Width="0"
                                            Background="{StaticResource DesktopAccent}" />
                                </Border>

                                <TextBlock x:Name="PreloadCount" AutomationProperties.AutomationId="PreloadCount" Margin="0,8,0,0"
                                           Style="{StaticResource DashMono}" FontSize="10" />

                                <TextBlock x:Name="PreloadNote" Margin="0,4,0,0" TextWrapping="Wrap"
                                           FontSize="10" LineHeight="15"
                                           Foreground="{StaticResource DesktopFaint}" />
                            </StackPanel>
                        </Border>

                        <ToggleButton x:Name="FollowToggle" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,30,30,0" IsChecked="True"
                                      Style="{StaticResource DashFollow}"
                                      Checked="OnFollowChanged" Unchecked="OnFollowChanged"
                                      ToolTip="{DynamicResource D_FollowHint}"
                                      AutomationProperties.Name="{DynamicResource D_Newest}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="NewestDot" Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock views:Track.Text="{DynamicResource D_Newest}" Margin="7,0,0,0"
                                           FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold"
                                           FontSize="9.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <!-- ............................................ Transport -->
                    <Border Grid.Row="2" Background="{StaticResource DesktopPanel}"
                            BorderBrush="{StaticResource DesktopLine}" BorderThickness="0,1,0,0"
                            Padding="14,12,14,14">
                        <StackPanel>
                            <!-- Zeitleiste. Alles darin wird gezeichnet, nicht gelegt:
                                 Bereich, geschriebene Frames, Luecken, Marken, Kopf. -->
                            <Border x:Name="ScrubTrack" Height="36" CornerRadius="9" Background="#0DFFFFFF"
                                    BorderBrush="{StaticResource DesktopLine}" BorderThickness="1"
                                    ClipToBounds="True" Cursor="Hand"
                                    MouseLeftButtonDown="OnScrubDown" MouseMove="OnScrubMove"
                                    MouseLeftButtonUp="OnScrubUp" SizeChanged="OnScrubResized">
                                <Canvas x:Name="ScrubCanvas" ClipToBounds="True" Background="Transparent" />
                            </Border>

                            <ScrollViewer x:Name="StripScroller" Margin="0,10,0,0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          SizeChanged="OnStripResized">
                                <StackPanel x:Name="FilmStrip" Orientation="Horizontal" />
                            </ScrollViewer>

<!-- Start, Ende und Bildzahl standen frueher hier rechts und drueckten
                                 die Knoepfe zur Seite. Sie sind Angaben, keine Bedienung,
                                 und stehen jetzt unten in der Statuszeile bei Aufloesung,
                                 Format und Bildrate - dort, wo die uebrigen Angaben
                                 ohnehin schon stehen. Damit bleibt diese Leiste eine
                                 einzige Zeile, die nichts verschiebt. -->
                            <Grid Margin="0,10,0,0">
<!-- Alle fuenf Knoepfe tragen gezeichnete Zeichen derselben Bauart:
                                     gleiche Strichstaerke, gleiche Hoehe, gleiche Farbe wie
                                     der Text. Vorher standen Schriftzeichen aus drei Quellen
                                     nebeneinander - Guillemets neben Medientasten aus der
                                     Emoji-Schrift - und das sah man. -->
<!-- Zwei Gruppen in einem umbrechenden Feld, nicht zehn einzelne
                                     Teile: Die Abspielknoepfe stehen fest, und wenn der
                                     Platz fuer die Einstellungen nicht reicht, ruecken
                                     DIESE geschlossen eine Zeile tiefer. Vorher wichen
                                     einzelne Knoepfe aus, und ohne Umbruch verschwanden
                                     sie hinter der Metrikspalte. -->
                                <WrapPanel x:Name="TransportControls" Orientation="Horizontal">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, ElementName=TransportControls}" Margin="0,0,12,8"><StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource DashTransport}" Click="OnJumpIn"
                                            ToolTip="{DynamicResource D_JumpIn}"
                                            AutomationProperties.Name="{DynamicResource D_JumpIn}">
                                        <Canvas Width="14" Height="12">
                                            <Rectangle Width="2" Height="12" Fill="{Binding Foreground,
                                                       RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Path Data="M13,0 L13,12 L4,6 Z" Fill="{Binding Foreground,
                                                  RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Canvas>
                                    </Button>
                                    <Button Style="{StaticResource DashTransport}" Margin="9,0,0,0"
                                            Click="OnStepBack" ToolTip="{DynamicResource D_StepBack}"
                                            AutomationProperties.Name="{DynamicResource D_StepBack}">
                                        <Canvas Width="14" Height="12">
                                            <Path Data="M10,0 L10,12 L2,6 Z" Fill="{Binding Foreground,
                                                  RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Canvas>
                                    </Button>
                                    <Button x:Name="PlayButton" Style="{StaticResource DashPlay}" Margin="9,0,0,0"
                                            Click="OnTogglePlay" AutomationProperties.Name="{DynamicResource D_Play}">
                                        <Canvas Width="16" Height="16">
                                            <Path x:Name="PlayGlyph" Data="M2,1 L15,8 L2,15 Z"
                                                  Fill="{Binding Foreground,
                                                  RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Canvas>
                                    </Button>
                                    <Button Style="{StaticResource DashTransport}" Margin="9,0,0,0"
                                            Click="OnStepForward" ToolTip="{DynamicResource D_StepForward}"
                                            AutomationProperties.Name="{DynamicResource D_StepForward}">
                                        <Canvas Width="14" Height="12">
                                            <Path Data="M4,0 L4,12 L12,6 Z" Fill="{Binding Foreground,
                                                  RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Canvas>
                                    </Button>
                                    <Button Style="{StaticResource DashTransport}" Margin="9,0,0,0"
                                            Click="OnJumpOut" ToolTip="{DynamicResource D_JumpOut}"
                                            AutomationProperties.Name="{DynamicResource D_JumpOut}">
                                        <Canvas Width="14" Height="12">
                                            <Path Data="M1,0 L1,12 L10,6 Z" Fill="{Binding Foreground,
                                                  RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Rectangle Canvas.Left="11" Width="2" Height="12"
                                                       Fill="{Binding Foreground,
                                                       RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Canvas>
                                    </Button>

                                </StackPanel></Viewbox>
                                <WrapPanel MaxWidth="{Binding ActualWidth, ElementName=TransportControls}"><WrapPanel x:Name="PlayChips" MaxWidth="{Binding ActualWidth, ElementName=TransportControls}" Margin="0,0,8,8" />

                                    <ComboBox x:Name="RateBox" Style="{StaticResource DashRateBox}"
                                              Margin="2,0,0,8" VerticalAlignment="Center"
                                              ToolTip="{DynamicResource D_RateHint}"
                                              AutomationProperties.Name="{DynamicResource D_Rate}"
                                              SelectionChanged="OnRatePicked" /></WrapPanel>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter x:Name="LowerSplitter" Grid.Row="1" Grid.ColumnSpan="5" Height="8" Visibility="Collapsed" Style="{StaticResource DashboardSplitter}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="{DynamicResource D_ResizeHeight}" AutomationProperties.Name="{DynamicResource D_LowerPanelHeight}"/>
                <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="8" Style="{StaticResource DashboardSplitter}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ToolTip="{DynamicResource D_ResizePanels}" AutomationProperties.Name="Metrikbereich anpassen" />

                <!-- ................................................ Metriken -->
                <Border x:Name="MetricsPanel" Grid.Column="4" Background="{StaticResource DesktopPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

<!-- Ein Punkt tiefer als die Flaeche darunter beginnt, damit der
                             gewaehlte Reiter deren Oberkante verdeckt: So sitzt er auf
                             seinem Bereich, statt als andersfarbiges Schild darueber zu
                             schweben. Vorher war der Reiter hell und der Bereich dunkel -
                             zwei Materialien, die zusammengehoeren sollten. -->
                        <Grid Margin="10,10,10,-1" Panel.ZIndex="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="TabMetrics" Grid.Column="0" Style="{StaticResource DashPanelTab}"
                                         IsChecked="True" Checked="OnPanelChanged" Tag="metrics">
                                <TextBlock views:Track.Text="{DynamicResource D_Metrics}" />
                            </RadioButton>
                            <RadioButton x:Name="TabLog" Grid.Column="1" Style="{StaticResource DashPanelTab}"
                                         Margin="4,0" Checked="OnPanelChanged" Tag="log">
                                <TextBlock views:Track.Text="{DynamicResource D_Log}" />
                            </RadioButton>
                            <RadioButton x:Name="TabGaps" Grid.Column="2" Style="{StaticResource DashPanelTab}"
                                         Checked="OnPanelChanged" Tag="gaps">
                                <TextBlock views:Track.Text="{DynamicResource D_Gaps}" />
                            </RadioButton>
                        </Grid>

                        <Border Grid.Row="1" Margin="10,0,10,10" CornerRadius="0,0,10,10"
                                Background="{StaticResource DesktopSurface}"
                                BorderBrush="{StaticResource DesktopLine}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="14">
                            <Grid>
                                <!-- ........................ Metriken -->
                                <StackPanel x:Name="PanelMetrics">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="BigPercent" Style="{StaticResource DashDisplay}"
                                                       FontSize="52" />
                                            <TextBlock Text="%" Style="{StaticResource DashDisplay}" FontSize="22"
                                                       Margin="5,0,0,6" VerticalAlignment="Bottom"
                                                       Foreground="{StaticResource DesktopAccent}" />
                                        </StackPanel>

                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock views:Track.Text="{DynamicResource D_Remaining}"
                                                       Style="{StaticResource DashLabel}" FontSize="9"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock x:Name="RemainValue" Margin="0,4,0,0"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold"
                                                       FontSize="21" Foreground="{StaticResource DesktopInk}" />
                                            <TextBlock x:Name="EtaLine" Margin="0,3,0,0" HorizontalAlignment="Right"
                                                       Style="{StaticResource DashMono}" FontSize="9.5" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="9" CornerRadius="5" Margin="0,12,0,0" Background="#12FFFFFF"
                                            ClipToBounds="True">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="BarDone" Background="{StaticResource DesktopAccent}" />
                                            <Border x:Name="BarLive" Background="{StaticResource DesktopBlue}" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,10,0,0">
                                        <TextBlock x:Name="FrameCounter" Style="{StaticResource DashLabel}"
                                                   FontSize="10" />
                                        <TextBlock x:Name="SampleCounter" HorizontalAlignment="Right"
                                                   Style="{StaticResource DashLabel}" FontSize="10" />
                                    </Grid>

                                    <Border Height="4" CornerRadius="2" Margin="0,8,0,0" Background="#12FFFFFF"
                                            ClipToBounds="True">
                                        <Border x:Name="SampleBar" HorizontalAlignment="Left" Width="0"
                                                Background="{StaticResource DesktopBlue}" />
                                    </Border>

                                    <UniformGrid x:Name="Tiles" Columns="2" Margin="0,16,0,0" />

                                    <Grid Margin="0,16,0,0">
                                        <TextBlock views:Track.Text="{DynamicResource D_SecPerFrame}"
                                                   Style="{StaticResource DashLabel}" FontSize="9" />
                                        <TextBlock x:Name="AverageLabel" HorizontalAlignment="Right"
                                                   Style="{StaticResource DashMono}"
                                                   Foreground="{StaticResource DesktopBlue}" />
                                    </Grid>

                                    <Border Height="74" CornerRadius="11" Margin="0,8,0,0"
                                            Background="{StaticResource DesktopSurface}"
                                            BorderBrush="{StaticResource DesktopLine}" BorderThickness="1"
                                            ClipToBounds="True">
                                        <views:Sparkline x:Name="FrameGraph" Margin="1" />
                                    </Border>

                                    <TextBlock views:Track.Text="{DynamicResource D_Remote}" Margin="0,18,0,8"
                                               Style="{StaticResource DashLabel}" FontSize="9" />

                                    <Button Style="{StaticResource DashPrimary}" Click="OnShowPairing">
                                        <TextBlock views:Track.Text="{DynamicResource D_PairDevice}" />
                                    </Button>

                                    <UniformGrid x:Name="RemoteActions" Columns="2" Margin="0,8,0,0" />
                                </StackPanel>

                                <!-- ........................ Protokoll -->
                                <StackPanel x:Name="PanelLog" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" CornerRadius="2"
                                                Background="{StaticResource DesktopAccent}" />
                                        <TextBlock x:Name="PhaseText" Grid.Column="1" Margin="10,0,0,0"
                                                   TextWrapping="Wrap" Style="{StaticResource DashMono}"
                                                   Foreground="{StaticResource DesktopInk}" LineHeight="16" />
                                    </Grid>
                                    <StackPanel x:Name="LogLines" Margin="0,9,0,0" />
                                </StackPanel>

                                <!-- ........................ Luecken -->
                                <StackPanel x:Name="PanelGaps" Visibility="Collapsed">
                                    <TextBlock x:Name="GapIntro" TextWrapping="Wrap" FontSize="11.5" LineHeight="19"
                                               Foreground="{StaticResource DesktopMuted}" />

                                    <UniformGrid x:Name="GapGrid" Columns="12" Margin="0,13,0,0" />

                                    <WrapPanel Margin="0,13,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <Border Width="9" Height="9" CornerRadius="3"
                                                    Background="{StaticResource DesktopAccent}" />
                                            <TextBlock views:Track.Text="{DynamicResource D_Written}"
                                                       Margin="5,0,0,0" Style="{StaticResource DashLabel}"
                                                       FontSize="9" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <Border Width="9" Height="9" CornerRadius="3"
                                                    Background="{StaticResource DesktopWarn}" />
                                            <TextBlock views:Track.Text="{DynamicResource D_Missing}"
                                                       Margin="5,0,0,0" Style="{StaticResource DashLabel}"
                                                       FontSize="9" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="9" Height="9" CornerRadius="3" Background="#1AFFFFFF" />
                                            <TextBlock views:Track.Text="{DynamicResource D_Pending}"
                                                       Margin="5,0,0,0" Style="{StaticResource DashLabel}"
                                                       FontSize="9" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <TextBlock x:Name="GapList" Margin="0,13,0,0" TextWrapping="Wrap"
                                               Style="{StaticResource DashMono}" FontSize="11" LineHeight="19"
                                               Foreground="{StaticResource DesktopInk}" />

                                    <Button x:Name="ExportButton" Style="{StaticResource DashGhost}" Height="40"
                                            Margin="0,13,0,0" Click="OnExport">
                                        <TextBlock views:Track.Text="{DynamicResource D_ExportVideo}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================================================== Projekte / Einstellungen

                 Sie legen sich ueber das Dashboard statt es zu ersetzen: So bleibt
                 der Zustand der drei Spalten erhalten, und der Rueckweg ist ein
                 Klick ohne Neuaufbau. -->
            <Border x:Name="PageHost" Background="{StaticResource DesktopBg}" Visibility="Collapsed">
                <ContentControl x:Name="PageContent" Margin="28,22,28,22" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Border>

            <!-- ==================================================== Kopplungstafel

                 Der Code gehoert dorthin, wo danach gefragt wird. Vorher fuehrte
                 "QR ZEIGEN" auf die Einstellungsseite, wo je nach Zustand statt
                 eines Codes ein Satz stand, warum keiner da ist - eine Antwort auf
                 eine Frage, die niemand gestellt hatte. -->
            <Grid x:Name="PairHost" Background="#B305050A" Visibility="Collapsed"
                  MouseLeftButtonDown="OnPairBackdrop">
                <Border MaxWidth="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                        CornerRadius="14" Padding="24" Background="{StaticResource DesktopPanel}"
                        BorderBrush="{StaticResource DesktopLine}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.55" Color="#000000" />
                    </Border.Effect>

                    <StackPanel>
                        <Grid>
                            <TextBlock views:Track.Text="{DynamicResource D_PairTitle}"
                                       Style="{StaticResource DashLabel}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource DashGhostSmall}" HorizontalAlignment="Right"
                                    Width="28" Padding="0" Click="OnPairClose"
                                    AutomationProperties.Name="{DynamicResource D_Close}">
                                <Path Data="M0,0 L9,9 M9,0 L0,9" StrokeThickness="1.3"
                                      Stroke="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>

                        <Border x:Name="PairCodeFrame" Margin="0,18,0,0" CornerRadius="11" Padding="14"
                                Width="252" Height="252" HorizontalAlignment="Center"
                                Background="{StaticResource DesktopSurface}">
                            <views:QrCodeView x:Name="PairCode" LightModules="True" />
                        </Border>

                        <TextBlock x:Name="PairRoom" Margin="0,14,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource DashMono}" FontSize="10" />

                        <TextBlock x:Name="PairHint" Margin="0,10,0,0" TextWrapping="Wrap"
                                   TextAlignment="Center" FontSize="11.5" LineHeight="18"
                                   Foreground="{StaticResource DesktopMuted}" />

                        <WrapPanel x:Name="PairActions" Margin="0,16,0,0" HorizontalAlignment="Center" />

                        <!-- ==================================== Zusehen im Netz

                             Der Kopplungscode darueber gehoert der App; das hier ist
                             der Weg fuer alles andere - ein Browser, ein zweiter
                             Bildschirm, jemand im selben Netz. Die Seite kann
                             ausschliesslich lesen. -->
                        <Border Margin="0,20,0,0" Padding="0,18,0,0"
                                BorderBrush="{StaticResource DesktopLine}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock views:Track.Text="{DynamicResource D_Watch}"
                                               Style="{StaticResource DashLabel}" FontSize="9"
                                               VerticalAlignment="Center" />

                                    <ToggleButton x:Name="WatchToggle" HorizontalAlignment="Right"
                                                  Style="{StaticResource DashChipSmall}"
                                                  Checked="OnWatchToggled" Unchecked="OnWatchToggled">
                                        <TextBlock x:Name="WatchToggleText" FontSize="8.5" />
                                    </ToggleButton>
                                </Grid>

                                <Border x:Name="WatchCodeFrame" Margin="0,14,0,0" CornerRadius="10"
                                        Padding="12" Width="170" Height="170"
                                        HorizontalAlignment="Center" Visibility="Collapsed"
                                        Background="{StaticResource DesktopSurface}">
                                    <views:QrCodeView x:Name="WatchCode" LightModules="True" />
                                </Border>

                                <TextBlock x:Name="WatchAddress" Margin="0,12,0,0"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Style="{StaticResource DashMono}"
                                           FontSize="11" Foreground="{StaticResource DesktopInk}" />

                                <TextBlock x:Name="WatchHint" Margin="0,8,0,0" TextWrapping="Wrap"
                                           TextAlignment="Center" FontSize="10.5" LineHeight="16"
                                           Foreground="{StaticResource DesktopMuted}" />

                                <!-- Das Kennwort steht sichtbar, nicht hinter Punkten: Es ist
                                     dazu da, weitergesagt zu werden. Wer es verbirgt, zwingt
                                     nur dazu, es woanders aufzuschreiben. -->
                                <StackPanel x:Name="WatchPassRow" Margin="0,16,0,0" Visibility="Collapsed">
                                    <TextBlock views:Track.Text="{DynamicResource D_WatchPass}"
                                               Style="{StaticResource DashLabel}" FontSize="8.5"
                                               HorizontalAlignment="Center" />

                                    <TextBox x:Name="WatchPass" Margin="0,8,0,0" Width="170"
                                             HorizontalAlignment="Center" MaxLength="32"
                                             Style="{StaticResource DashTextBox}"
                                             HorizontalContentAlignment="Center"
                                             KeyDown="OnWatchPassKey" LostFocus="OnWatchPassDone" />

                                    <TextBlock x:Name="WatchPassHint" Margin="0,8,0,0"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               FontSize="9.5" LineHeight="14"
                                               Foreground="{StaticResource DesktopMuted}" />
                                </StackPanel>

                                <WrapPanel x:Name="WatchActions" Margin="0,16,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Die Zustimmungstafel.

                 Sie kommt VOR jeder Verbindung nach draussen - Kopplung wie
                 Zuschauerseite. Kein Hintergrund zum Wegklicken: Wer sie schliesst,
                 soll das ueber "Nicht jetzt" tun, damit klar ist, dass nichts
                 eingeschaltet wurde.

                 Sie steht NACH der Kopplungstafel, weil Geschwister in dieser
                 Reihenfolge uebereinander liegen. Vorher stand sie davor und lag
                 damit darunter: Wer den Kopplungscode aufrief, ohne zugestimmt zu
                 haben, sah die Frage hinter dem QR-Code aufblitzen und kam nicht an
                 sie heran.

                 Kein Track.Text auf den Absaetzen. Track setzt zwischen jedes
                 Zeichen ein Haarspatium - richtig fuer gesperrte Versalien wie die
                 Ueberschrift, falsch fuer Fliesstext: Ein Haarspatium IST ein
                 Leerzeichen, und damit darf die Zeile nach jedem Buchstaben
                 umbrechen. Genau das tat sie.

                 Die drei Absaetze kommen aus dem Code, weil ihr Wortlaut davon
                 abhaengt, wessen Server eingetragen ist. -->
            <Grid x:Name="TermsHost" Background="#F205050A" Visibility="Collapsed">
                <Border MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                        CornerRadius="14" Padding="26" Background="{StaticResource DesktopPanel}"
                        BorderBrush="{StaticResource DesktopLine}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.55" Color="#000000" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock views:Track.Text="{DynamicResource D_TermsTitle}"
                                   Style="{StaticResource DashLabel}" />

                        <TextBlock x:Name="TermsBody" Margin="0,16,0,0" TextWrapping="Wrap"
                                   FontSize="11.5" LineHeight="19"
                                   Foreground="{StaticResource DesktopInk}" />

                        <TextBlock x:Name="TermsLinks" Margin="0,14,0,0" TextWrapping="Wrap"
                                   FontSize="11" LineHeight="18"
                                   Foreground="{StaticResource DesktopMuted}">
                            <Hyperlink RequestNavigate="OnTermsLink"
                                       AutomationProperties.Name="{DynamicResource D_TermsUse}"
                                       NavigateUri="https://relay.steggi-matrix.work/recht/nutzungsbedingungen.html">
                                <Run Text="{DynamicResource D_TermsUse}" />
                            </Hyperlink>
                            <Run Text="  &#183;  " />
                            <Hyperlink RequestNavigate="OnTermsLink"
                                       AutomationProperties.Name="{DynamicResource D_TermsPrivacy}"
                                       NavigateUri="https://relay.steggi-matrix.work/recht/datenschutz.html">
                                <Run Text="{DynamicResource D_TermsPrivacy}" />
                            </Hyperlink>
                        </TextBlock>

                        <CheckBox x:Name="TermsAgree" Margin="0,20,0,0"
                                  Style="{StaticResource DialogCheckBox}"
                                  Checked="OnTermsChecked" Unchecked="OnTermsChecked">
                            <TextBlock x:Name="TermsAgreeText" TextWrapping="Wrap"
                                       FontSize="11.5" LineHeight="18" />
                        </CheckBox>

                        <TextBlock x:Name="TermsNote" Margin="0,16,0,0" TextWrapping="Wrap"
                                   FontSize="10.5" LineHeight="17"
                                   Foreground="{StaticResource DesktopFaint}" />

                        <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Right">
                            <Button x:Name="TermsLater" Style="{StaticResource DashGhost}"
                                    Margin="0,0,8,0" Click="OnTermsLater">
                                <TextBlock views:Track.Text="{DynamicResource D_TermsLater}" />
                            </Button>
                            <Button x:Name="TermsGo" Style="{StaticResource DashPrimary}"
                                    IsEnabled="False" Click="OnTermsAccept">
                                <TextBlock views:Track.Text="{DynamicResource D_TermsGo}" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ Statuszeile -->
        <Border Grid.Row="3" Background="{StaticResource DesktopPanel}"
                BorderBrush="{StaticResource DesktopLine}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusFormat" Style="{StaticResource DashMono}" FontSize="10" />
                    <TextBlock x:Name="StatusDecode" Margin="14,0,0,0" Style="{StaticResource DashMono}"
                               FontSize="10" />
                    <TextBlock x:Name="StatusFps" Margin="14,0,0,0" Style="{StaticResource DashMono}"
                               FontSize="10" />
                    <TextBlock x:Name="RangeInfo" Margin="14,0,0,0" Style="{StaticResource DashMono}"
                               FontSize="10" />
                    <TextBlock x:Name="StatusMissing" Margin="14,0,0,0" Style="{StaticResource DashMono}"
                               FontSize="10" Foreground="{StaticResource DesktopWarn}" />
                    <TextBlock x:Name="FooterHint" Margin="14,0,0,0" Style="{StaticResource DashMono}"
                               FontSize="10" Foreground="{StaticResource DesktopAccent}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusHotkey" Style="{StaticResource DashMono}" FontSize="10" />
                    <TextBlock x:Name="StatusRelay" Margin="14,0,0,0" Style="{StaticResource DashMono}"
                               FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
