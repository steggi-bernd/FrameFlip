<Window x:Class="FrameFlip.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrameFlip"
        Width="1080" Height="720"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}"
        TextOptions.TextFormattingMode="Display">

    <!-- Der Aufbau ist der der Handy-App, um neunzig Grad gedreht: Dort liegen die
         Reiter unten, hier links. Alles andere bleibt gleich - Kopfzeile mit
         Lebenszeichen, grosse Zahlen, gesperrte Versalien, dieselben Farben. Wer
         beides benutzt, soll sich nicht umgewoehnen muessen. -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ Navigation -->
        <Border Grid.Column="0" Background="{StaticResource AppNav}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="FRAMEFLIP" Margin="20,24,20,4"
                           FontFamily="{StaticResource HeadFont}" FontWeight="ExtraBold"
                           FontSize="15" Foreground="{StaticResource ForegroundBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#A855F7" BlurRadius="18" ShadowDepth="0" Opacity="0.35" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="MachineName" Grid.Row="1" Margin="20,0,20,22"
                           FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                           Foreground="{StaticResource FaintBrush}" />

                <StackPanel Grid.Row="2" x:Name="NavItems" Margin="0,4,0,0" />

                <StackPanel Grid.Row="3" Margin="20,0,20,20">
                    <Border x:Name="LinkPill" CornerRadius="9" Padding="10,8"
                            Background="{StaticResource AppSurface}"
                            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LinkDot" Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{StaticResource DisabledBrush}" />
                                <TextBlock x:Name="LinkText" Margin="8,0,0,0" FontSize="9.5"
                                           FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="LinkDetail" Margin="0,5,0,0" FontSize="9.5" TextWrapping="Wrap"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource FaintBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ Inhalt -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Der Haarstrich mit dem Fortschritt, wie in der App. -->
            <Border Grid.Row="0" Height="3" Background="{StaticResource TrackBrush}">
                <Border x:Name="Hairline" HorizontalAlignment="Left" Width="0"
                        Background="{StaticResource AccentBrush}" />
            </Border>

            <Border Grid.Row="1" Padding="28,18,28,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F20D0D16" Offset="0" />
                        <GradientStop Color="#0007070D" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{StaticResource DisabledBrush}" />

                    <TextBlock x:Name="StatusWord" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                               FontSize="9.5" Foreground="{StaticResource MutedBrush}" />

                    <TextBlock x:Name="HeaderFile" Margin="16,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource ForegroundBrush}" />
                </StackPanel>
            </Border>

            <ContentControl x:Name="Page" Grid.Row="2" Margin="28,6,28,24" />
        </Grid>
    </Grid>
</Window>
