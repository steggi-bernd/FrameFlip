<Window x:Class="FrameFlip.Views.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FrameFlip.Views"
        Title="{DynamicResource S_PairTitle}"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBg}"
        TextOptions.TextFormattingMode="Display">

    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource S_PairHeading}" FontFamily="{StaticResource DisplayFont}"
                   FontSize="34" Foreground="{StaticResource ForegroundBrush}" />

        <TextBlock x:Name="StateLine" Margin="0,6,0,0"
                   FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                   FontSize="10.5" Foreground="{StaticResource AccentBrush}" />

        <Border Margin="0,18,0,0" Width="220" Height="220" HorizontalAlignment="Center"
                CornerRadius="{StaticResource SurfaceCorner}" Background="White">
            <views:QrCodeView x:Name="Code" />
        </Border>

        <TextBlock x:Name="Hint" Margin="0,14,0,0" TextWrapping="Wrap"
                   FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                   Foreground="{StaticResource MutedBrush}" />

        <TextBox x:Name="LinkBox" Margin="0,14,0,0" Style="{StaticResource DialogTextBox}"
                 IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10.5" />

        <TextBlock x:Name="RoomLine" Margin="0,8,0,0"
                   FontFamily="{StaticResource MonoFont}" FontSize="10"
                   Foreground="{StaticResource FaintBrush}" />

        <!-- Was das gekoppelte Gerät darf, gehört dorthin, wo man es koppelt.
             Im Einstellungsdialog steht derselbe Schalter noch einmal - er gehört
             thematisch auch dorthin, aber gesucht wird er hier. -->
        <Border Margin="0,18,0,0" Padding="14,12,14,13" CornerRadius="{StaticResource SurfaceCorner}"
                Background="{StaticResource AppSurface}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{DynamicResource S_PhoneMayTitle}" FontFamily="{StaticResource HeadFont}"
                           FontWeight="Bold" FontSize="9.5"
                           Foreground="{StaticResource MutedBrush}" />

                <CheckBox x:Name="LibraryBox" Margin="0,12,0,0"
                          Style="{StaticResource DialogCheckBox}"
                          Content="{DynamicResource S_LibraryShort}"
                          Checked="OnLibraryChanged" Unchecked="OnLibraryChanged" />

                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           FontFamily="{StaticResource BodyFont}" FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{DynamicResource S_LibraryHint}" />

                <Separator Margin="0,14,0,12" Background="{StaticResource PanelBorder}" />

                <CheckBox x:Name="RenderBox" Style="{StaticResource DialogCheckBox}"
                          Content="{DynamicResource S_RenderEnable}"
                          Checked="OnRenderChanged" Unchecked="OnRenderChanged" />

                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           FontFamily="{StaticResource BodyFont}" FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{DynamicResource S_RenderHint}" />

                <!-- Die Auswahl steht auch dann da, wenn das Rendern aus ist: Sie
                     sagt, WOMIT gerechnet würde, und das gehört zur Entscheidung. -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource S_BlenderLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" />

                    <ComboBox x:Name="BlenderBox" Grid.Column="1" VerticalAlignment="Center"
                              SelectionChanged="OnBlenderChosen" />

                    <Button x:Name="AddBlenderButton" Grid.Column="2" Margin="8,0,0,0"
                            Style="{StaticResource DialogButton}"
                            Content="{DynamicResource S_AddBlender}" Click="OnAddBlender" />
                </Grid>

                <Separator Margin="0,14,0,12" Background="{StaticResource PanelBorder}" />

                <CheckBox x:Name="PushBox" Style="{StaticResource DialogCheckBox}"
                          Content="{DynamicResource S_PushEnable}"
                          Checked="OnPushChanged" Unchecked="OnPushChanged" />

                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           FontFamily="{StaticResource BodyFont}" FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{DynamicResource S_PushHint}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource S_ExchangeFolder}"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" />

                    <TextBlock x:Name="FolderLine" Grid.Column="1" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Foreground="{StaticResource ForegroundBrush}" />

                    <Button x:Name="PickFolderButton" Grid.Column="2" Margin="8,0,0,0"
                            Style="{StaticResource DialogButton}"
                            Content="{DynamicResource S_ChooseFolder}" Click="OnPickFolder" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                   FontFamily="{StaticResource BodyFont}" FontSize="11"
                   Foreground="{StaticResource AppDim}"
                   Text="{DynamicResource S_NoWebYet}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CopyButton" Style="{StaticResource DialogButton}" MinWidth="130"
                    Content="{DynamicResource S_CopyLink}" Margin="0,0,8,0" Click="OnCopy" />
            <Button Style="{StaticResource DialogButton}" MinWidth="130"
                    Content="{DynamicResource S_NewKey}" Click="OnNewKey" />
        </StackPanel>
    </StackPanel>
</Window>
