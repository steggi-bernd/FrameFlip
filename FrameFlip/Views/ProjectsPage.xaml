<UserControl x:Class="FrameFlip.Views.ProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Titel links, Werkzeuge rechts -->
        <Grid Grid.Row="0" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Heading" Grid.Column="0" Text="{DynamicResource S_ProjectsTitle}"
                       FontFamily="{StaticResource DisplayFont}" FontSize="44"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource ForegroundBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="AddFolder" Padding="12,7" CornerRadius="9" Cursor="Hand"
                        Background="{StaticResource AppSurface}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                    <TextBlock Text="{DynamicResource S_AddFolderButton}" FontFamily="{StaticResource HeadFont}"
                               FontWeight="Bold" FontSize="9.5"
                               Foreground="{StaticResource MutedBrush}" />
                </Border>

                <Border x:Name="Rescan" Margin="8,0,0,0" Padding="12,7" CornerRadius="9" Cursor="Hand"
                        Background="{StaticResource AppSurface}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                    <TextBlock Text="{DynamicResource S_RescanButton}" FontFamily="{StaticResource HeadFont}"
                               FontWeight="Bold" FontSize="9.5"
                               Foreground="{StaticResource MutedBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Die Krumen, dahinter der Stapel der .blend-Dateien. Ein WrapPanel und
             kein StackPanel: In einem schmalen Fenster ist die Zeile sonst länger
             als das Fenster, und was rechts steht, ist einfach weg. -->
        <WrapPanel Grid.Row="1" x:Name="Crumbs" Margin="0,10,0,0" />

        <!-- Die Blender-Dateien des Projekts. Eigene Zeile und eigene Form: In der
             Krumenzeile sahen sie aus wie ein weiterer Ordner, und genau das sind
             sie nicht - sie sind das Dokument, zu dem die Ordner gehören. -->
        <ContentControl Grid.Row="2" x:Name="StackBar" Margin="0,12,0,0" />

        <TextBlock x:Name="Note" Grid.Row="3" VerticalAlignment="Top" MaxWidth="620"
                   HorizontalAlignment="Left" TextWrapping="Wrap" Visibility="Collapsed"
                   FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                   Foreground="{StaticResource FaintBrush}" />

        <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" />
        </ScrollViewer>
    </Grid>
</UserControl>
