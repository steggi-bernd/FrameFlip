<UserControl x:Class="FrameFlip.Views.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Die Leiste des gewaehlten Werkzeugs - waagerecht, ueber dem Bild.

        Wie in jedem Bildprogramm: Die Einstellungen eines Werkzeugs stehen dort, wo
        man mit ihm arbeitet, und nicht in einer Spalte am Rand, die sie sich mit der
        Farbe und den Ebenen teilen muss. Links steht, was das Werkzeug tut - in einer
        Zeile, der ganze Satz im Hinweis -, rechts daneben, was sich daran einstellen
        laesst.
    -->
    <Border Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4"
            Padding="12,0" MinHeight="40">
        <DockPanel LastChildFill="True">

            <!--
                Name und Satz. Der Satz ist gekuerzt, wenn der Platz nicht reicht,
                und steht dann ganz im Hinweis - eine Leiste, die umbricht, frisst
                die Hoehe, die sie gerade freigeben soll.
            -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <TextBlock x:Name="ToolName" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Der Pinsel: vier Regler in einer Zeile. -->
            <StackPanel x:Name="BrushBody" DockPanel.Dock="Left" Orientation="Horizontal"
                        VerticalAlignment="Center" Visibility="Collapsed">

                <TextBlock Text="{DynamicResource S_BrushSize}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider x:Name="BrushSizeSlider" Style="{StaticResource PanelSlider}" Width="110"
                        VerticalAlignment="Center"
                        Minimum="2" Maximum="400" Value="40" SmallChange="2" LargeChange="20"
                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="40" />
                <TextBlock x:Name="BrushSizeValue" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Width="46" Margin="6,0,14,0"
                           HorizontalAlignment="Left" />

                <TextBlock Text="{DynamicResource S_BrushHardness}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider x:Name="BrushHardnessSlider" Style="{StaticResource PanelSlider}" Width="80"
                        VerticalAlignment="Center"
                        Minimum="0" Maximum="1" Value="0.5" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0.5" />
                <TextBlock x:Name="BrushHardnessValue" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Width="36" Margin="6,0,14,0"
                           HorizontalAlignment="Left" />

                <TextBlock Text="{DynamicResource S_BrushFlow}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider x:Name="BrushFlowSlider" Style="{StaticResource PanelSlider}" Width="80"
                        VerticalAlignment="Center"
                        Minimum="0.02" Maximum="1" Value="0.7" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0.7" />
                <TextBlock x:Name="BrushFlowValue" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Width="36" Margin="6,0,14,0"
                           HorizontalAlignment="Left" />

                <!--
                    Staerke und Deckkraft sind nicht dasselbe, auch wenn sie sich
                    aehnlich anfuehlen: Die eine sagt, wieviel EIN Strich auftraegt,
                    die andere, wo auch zehn Striche aufhoeren.
                -->
                <TextBlock Text="{DynamicResource S_BrushOpacity}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider x:Name="BrushOpacitySlider" Style="{StaticResource PanelSlider}" Width="80"
                        VerticalAlignment="Center"
                        Minimum="0.05" Maximum="1" Value="1" SmallChange="0.02" LargeChange="0.1"
                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="1" />
                <TextBlock x:Name="BrushOpacityValue" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Width="36" Margin="6,0,14,0"
                           HorizontalAlignment="Left" />

                <!-- Der Abstand der Tupfer, als Anteil des Radius. Strg und Rad am Bild tun dasselbe. -->
                <TextBlock Text="{DynamicResource S_BrushSpacing}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           ToolTip="{DynamicResource S_BrushSpacingHint}" />
                <Slider x:Name="BrushSpacingSlider" Style="{StaticResource PanelSlider}" Width="80"
                        VerticalAlignment="Center"
                        Minimum="0.05" Maximum="4" Value="0.25" SmallChange="0.05" LargeChange="0.25"
                        ToolTip="{DynamicResource S_BrushSpacingHint}"
                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0.25" />
                <TextBlock x:Name="BrushSpacingValue" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Width="40" Margin="6,0,0,0"
                           HorizontalAlignment="Left" />

                <!-- Der Verlauf der Maske, auf die der Pinsel malt - nur im Knotenmodus,
                     nur dort wird er aufgezeichnet. -->
                <Button x:Name="BrushHistoryButton" Style="{StaticResource OverlayButton}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed"
                        Content="{DynamicResource S_MaskMenuHistory}" Click="OnBrushHistory"
                        ToolTip="{DynamicResource S_MaskHistoryButtonHint}" />
            </StackPanel>

            <!-- Was die Pipette gelesen hat - ebenfalls in einer Zeile. -->
            <StackPanel x:Name="PickBody" DockPanel.Dock="Left" Orientation="Horizontal"
                        VerticalAlignment="Center" Visibility="Collapsed">

                <TextBlock Text="{DynamicResource S_PickAt}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="PickWhere" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <TextBlock Text="{DynamicResource S_PickByte}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="PickByte" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <!--
                    Beide Zahlen, und das ist Absicht: Nur der Lichtwert beantwortet
                    "wie hell ist das wirklich", und nur der Anzeigewert laesst sich
                    mit einer Pipette in einem anderen Programm vergleichen.
                -->
                <TextBlock Text="{DynamicResource S_PickLight}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="PickLight" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <StackPanel x:Name="DepthRow" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource S_PickDepth}" Style="{StaticResource PanelLabel}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="PickDepth" Style="{StaticResource PanelValue}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                </StackPanel>

                <!--
                    Der Grund, warum es die Pipette ueberhaupt gibt: Die nachtraegliche
                    Tiefenschaerfe verlangt eine Entfernung in Szeneneinheiten, und ein
                    Klick auf das, was scharf sein soll, ist die ehrliche Antwort.
                -->
                <Button x:Name="FocusButton" Style="{StaticResource OverlayButton}"
                        VerticalAlignment="Center" IsEnabled="False"
                        Content="{DynamicResource S_UseAsFocus}" Click="OnUseAsFocus"
                        ToolTip="{DynamicResource S_UseAsFocusHint}" />

                <TextBlock x:Name="FocusNote" Margin="10,0,0,0" FontSize="10"
                           VerticalAlignment="Center" Visibility="Collapsed"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <!--
                Der Satz zum Werkzeug, am Ende: Er nimmt, was an Platz uebrig bleibt,
                und steht beim Pinsel hinter den Reglern statt davor.
            -->
            <TextBlock x:Name="ToolHint" FontSize="10" VerticalAlignment="Center"
                       Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource MutedBrush}" />
        </DockPanel>
    </Border>
</UserControl>
