<UserControl x:Class="FrameFlip.Views.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FrameFlip.Views">

    <UserControl.Resources>
        <!--
            Eine Gruppe der Leiste (Entscheidung 9): ein feiner Strich davor. Seit Entscheidung 10
            ohne Namen - die Leiste zeigt nur Zeichen, Regler und Werte. Umgebrochen wird nur
            zwischen Gruppen - nie mitten durch eine.
        -->
        <Style x:Key="OptionGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Zeichen, Regler, Wert - ueberall gleich breit, damit die Gruppen ruhig stehen. Der Name steht im Hinweis. -->
        <Style x:Key="OptionIcon" TargetType="local:IconLabel">
            <Setter Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="OptionSlider" TargetType="Slider" BasedOn="{StaticResource PanelSlider}">
            <Setter Property="Width" Value="64" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OptionValue" TargetType="TextBlock" BasedOn="{StaticResource PanelValue}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Margin" Value="5,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="OptionChip" TargetType="ToggleButton" BasedOn="{StaticResource OverlayToggle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <!--
        Die Leiste des gewaehlten Werkzeugs - waagerecht, ueber dem Bild.

        Wie in jedem Bildprogramm: Die Einstellungen eines Werkzeugs stehen dort, wo
        man mit ihm arbeitet, und nicht in einer Spalte am Rand, die sie sich mit der
        Farbe und den Ebenen teilen muss. Links steht, was das Werkzeug tut - in einer
        Zeile, der ganze Satz im Hinweis -, rechts daneben, was sich daran einstellen
        laesst.
    -->
    <!-- Rahmen und Grund gibt die Gruppe der Andockflaeche, in der die Leiste steht. -->
    <Border Padding="12,0" MinHeight="40">
        <DockPanel LastChildFill="True">

            <!--
                Name und Satz. Der Satz ist gekuerzt, wenn der Platz nicht reicht,
                und steht dann ganz im Hinweis - eine Leiste, die umbricht, frisst
                die Hoehe, die sie gerade freigeben soll.
            -->
            <!-- Links in der Leiste, in einer schmalen Seitenzone oben (ArrangeFor). -->
            <StackPanel x:Name="ToolNamePanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <TextBlock x:Name="ToolName" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!--
                Der Pinsel in Gruppen wie im Entwurf: Spitze, Auftrag, Form, Bindung, Druck.
                Bei wenig Platz bricht die Leiste zwischen den Gruppen um. Was zum gewaehlten
                Werkzeug nicht gehoert, steht gar nicht da (ShowBrushGroups).
            -->
            <WrapPanel x:Name="BrushBody" DockPanel.Dock="Left" Orientation="Horizontal"
                       VerticalAlignment="Center" Visibility="Collapsed">

                <!-- Die Arten stehen seit Phase U als Werkzeuge in der Werkzeugzeile (Malen);
                     hier bleiben sie nur als Stand, unsichtbar. Genau eine ist an. -->
                <StackPanel x:Name="BrushModeRow" Orientation="Horizontal" Visibility="Collapsed">
                    <ToggleButton x:Name="BrushModeStroke" Style="{StaticResource OverlayToggle}" IsChecked="True"
                                  Content="✎" ToolTip="{DynamicResource S_BrushModeStrokeHint}"
                                  Checked="OnBrushMode" Unchecked="OnBrushMode" />
                    <ToggleButton x:Name="BrushModeRectangle" Style="{StaticResource OverlayToggle}"
                                  Content="▭" ToolTip="{DynamicResource S_BrushModeRectangleHint}"
                                  Checked="OnBrushMode" Unchecked="OnBrushMode" />
                    <ToggleButton x:Name="BrushModeEllipse" Style="{StaticResource OverlayToggle}"
                                  Content="◯" ToolTip="{DynamicResource S_BrushModeEllipseHint}"
                                  Checked="OnBrushMode" Unchecked="OnBrushMode" />
                    <ToggleButton x:Name="BrushModeLasso" Style="{StaticResource OverlayToggle}"
                                  Content="➰" ToolTip="{DynamicResource S_BrushModeLassoHint}"
                                  Checked="OnBrushMode" Unchecked="OnBrushMode" />
                    <!-- Rund oder eckig: seit Entscheidung 10 im Auswahlfeld; die Schalter halten den Stand. -->
                    <ToggleButton x:Name="BrushRoundToggle" Style="{StaticResource OptionChip}"
                                  ToolTip="{DynamicResource S_BrushRoundHint}"
                                  Checked="OnBrushToggle" Unchecked="OnBrushToggle">
                        <local:IconLabel Icon="round" Text="{DynamicResource S_BrushRound}" />
                    </ToggleButton>
                    <ToggleButton x:Name="BrushSquareToggle" Style="{StaticResource OptionChip}"
                                  ToolTip="{DynamicResource S_BrushSquareHint}"
                                  Checked="OnBrushToggle" Unchecked="OnBrushToggle">
                        <local:IconLabel Icon="square" Text="{DynamicResource S_BrushSquare}" />
                    </ToggleButton>
                    <!-- Der Stempel ist ein Werkzeug der Zeile; der Schalter haelt nur den Stand. -->
                    <ToggleButton x:Name="BrushStampToggle" Style="{StaticResource OverlayToggle}"
                                  Content="✿" ToolTip="{DynamicResource S_BrushStampHint}"
                                  Checked="OnBrushToggle" Unchecked="OnBrushToggle" />
                </StackPanel>

                <!-- SPITZE - nur beim Zug. Rund oder eckig; beim Stempel statt dessen seine Spitze. -->
                <Border x:Name="BrushTipRow" Style="{StaticResource OptionGroup}">
                    <WrapPanel Orientation="Horizontal">

                        <!-- Die Form der Spitze als Auswahlfeld (Entscheidung 10) - rund oder eckig. -->
                        <StackPanel x:Name="BrushTipShapes" Orientation="Horizontal" Margin="0,0,10,0">
                            <!-- Die Eintraege kommen als Daten (IconChoice): Ein Element als Eintrag
                                 kann nur an einer Stelle stehen, und das Feld blieb dann leer. -->
                            <ComboBox x:Name="BrushShapeBox" Style="{StaticResource OverlayCombo}" Width="92"
                                      VerticalAlignment="Center"
                                      ToolTip="{DynamicResource S_BrushShapeHint}"
                                      SelectionChanged="OnBrushShapeChosen">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <local:IconLabel Icon="{Binding Icon}" Text="{Binding Text}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Der Stempel: eine Spitze aus einem Bild, je Tupfer zufaellig gedreht und gestreut. -->
                        <StackPanel x:Name="BrushStampRow" Orientation="Horizontal" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsChecked, ElementName=BrushStampToggle}">
                            <Button x:Name="BrushTipButton" Style="{StaticResource OverlayButton}" VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    AutomationProperties.Name="{DynamicResource S_BrushTipLoad}"
                                    ToolTip="{DynamicResource S_BrushTipHint}" Click="OnBrushTipClicked">
                                <local:IconLabel Icon="open" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <local:IconLabel Icon="jitter" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushJitter}" />
                                <Slider x:Name="BrushJitterSlider" Style="{StaticResource OptionSlider}" Width="56" Margin="0,0,12,0"
                                        Minimum="0" Maximum="1" Value="0.5" SmallChange="0.05" LargeChange="0.25"
                                        ToolTip="{DynamicResource S_BrushJitterHint}"
                                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0.5" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <local:IconLabel Icon="scatter" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushScatter}" />
                                <Slider x:Name="BrushScatterSlider" Style="{StaticResource OptionSlider}" Width="56" Margin="0,0,12,0"
                                        Minimum="0" Maximum="1" Value="0.25" SmallChange="0.05" LargeChange="0.25"
                                        ToolTip="{DynamicResource S_BrushScatterHint}"
                                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0.25" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <local:IconLabel Icon="size" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushSize}" />
                            <Slider x:Name="BrushSizeSlider" Style="{StaticResource OptionSlider}" ToolTip="{DynamicResource S_BrushSize}" Width="84"
                                    Minimum="2" Maximum="400" Value="40" SmallChange="2" LargeChange="20"
                                    ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="40" />
                            <TextBlock x:Name="BrushSizeValue" Style="{StaticResource OptionValue}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <local:IconLabel Icon="hardness" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushHardness}" />
                            <Slider x:Name="BrushHardnessSlider" Style="{StaticResource OptionSlider}" ToolTip="{DynamicResource S_BrushHardness}"
                                    Minimum="0" Maximum="1" Value="0.5" SmallChange="0.02" LargeChange="0.1"
                                    ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0.5" />
                            <TextBlock x:Name="BrushHardnessValue" Style="{StaticResource OptionValue}" Margin="5,0,0,0" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- FORM - nur beim Zug: gedreht, gestreckt, zum Karo gezogen, und ob der Winkel dem Strich folgt. -->
                <Border x:Name="BrushShapeRow" Style="{StaticResource OptionGroup}">
                    <WrapPanel Orientation="Horizontal">

                        <StackPanel Orientation="Horizontal">
                            <local:IconLabel Icon="angle" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushAngle}" />
                            <Slider x:Name="BrushAngleSlider" Style="{StaticResource OptionSlider}"
                                    Minimum="0" Maximum="180" Value="0" SmallChange="5" LargeChange="15"
                                    ToolTip="{DynamicResource S_BrushAngleHint}"
                                    ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0" />
                            <TextBlock x:Name="BrushAngleValue" Style="{StaticResource OptionValue}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <local:IconLabel Icon="aspect" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushAspect}" />
                            <Slider x:Name="BrushAspectSlider" Style="{StaticResource OptionSlider}"
                                    Minimum="1" Maximum="8" Value="1" SmallChange="0.25" LargeChange="1"
                                    ToolTip="{DynamicResource S_BrushAspectHint}"
                                    ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="1" />
                            <TextBlock x:Name="BrushAspectValue" Style="{StaticResource OptionValue}" />
                        </StackPanel>

                        <!-- Das Karo gibt es nur fuer die eckige Spitze. -->
                        <StackPanel x:Name="BrushSquishRow" Orientation="Horizontal"
                                    IsEnabled="{Binding IsChecked, ElementName=BrushSquareToggle}">
                            <StackPanel Orientation="Horizontal">
                                <local:IconLabel Icon="squish" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushSquish}" />
                                <Slider x:Name="BrushSquishSlider" Style="{StaticResource OptionSlider}"
                                        Minimum="0" Maximum="1" Value="0" SmallChange="0.05" LargeChange="0.25"
                                        ToolTip="{DynamicResource S_BrushSquishHint}"
                                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0" />
                                <TextBlock x:Name="BrushSquishValue" Style="{StaticResource OptionValue}" />
                            </StackPanel>
                        </StackPanel>

                        <ToggleButton x:Name="BrushFollowToggle" Style="{StaticResource OptionChip}"
                                      AutomationProperties.Name="{DynamicResource S_BrushFollow}"
                                      ToolTip="{DynamicResource S_BrushFollowHint}"
                                      Checked="OnBrushToggle" Unchecked="OnBrushToggle">
                            <local:IconLabel Icon="follow" />
                        </ToggleButton>
                    </WrapPanel>
                </Border>

                <!--
                    AUFTRAG - Staerke und Deckkraft sind nicht dasselbe, auch wenn sie sich
                    aehnlich anfuehlen: Die eine sagt, wieviel EIN Strich auftraegt, die andere,
                    wo auch zehn Striche aufhoeren. Beim Fuellen gilt nur die Deckkraft.
                -->
                <Border Style="{StaticResource OptionGroup}">
                    <WrapPanel Orientation="Horizontal">

                        <StackPanel x:Name="BrushFlowRow" Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <local:IconLabel Icon="flow" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushFlow}" />
                                <Slider x:Name="BrushFlowSlider" Style="{StaticResource OptionSlider}" ToolTip="{DynamicResource S_BrushFlow}"
                                        Minimum="0.02" Maximum="1" Value="0.7" SmallChange="0.02" LargeChange="0.1"
                                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0.7" />
                                <TextBlock x:Name="BrushFlowValue" Style="{StaticResource OptionValue}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <local:IconLabel Icon="opacity" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushOpacity}" />
                            <Slider x:Name="BrushOpacitySlider" Style="{StaticResource OptionSlider}" ToolTip="{DynamicResource S_BrushOpacity}"
                                    Minimum="0.05" Maximum="1" Value="1" SmallChange="0.02" LargeChange="0.1"
                                    ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="1" />
                            <TextBlock x:Name="BrushOpacityValue" Style="{StaticResource OptionValue}" Margin="5,0,0,0" />
                        </StackPanel>

                        <!-- Der Abstand der Tupfer, als Anteil des Radius. Strg und Rad am Bild tun dasselbe. -->
                        <StackPanel x:Name="BrushSpacingRow" Orientation="Horizontal" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <local:IconLabel Icon="spacing" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushSpacing}" />
                                <Slider x:Name="BrushSpacingSlider" Style="{StaticResource OptionSlider}"
                                        Minimum="0.05" Maximum="4" Value="0.25" SmallChange="0.05" LargeChange="0.25"
                                        ToolTip="{DynamicResource S_BrushSpacingHint}"
                                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0.25" />
                                <TextBlock x:Name="BrushSpacingValue" Style="{StaticResource OptionValue}" Margin="5,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- BINDUNG - woran der Strich sich haelt: das Objekt oder die Flaeche, auf der er ansetzt. -->
                <Border Style="{StaticResource OptionGroup}">
                    <WrapPanel Orientation="Horizontal">

                        <ToggleButton x:Name="BrushObjectToggle" Style="{StaticResource OptionChip}"
                                      AutomationProperties.Name="{DynamicResource S_BrushObject}"
                                      ToolTip="{DynamicResource S_BrushObjectHint}"
                                      Checked="OnBrushToggle" Unchecked="OnBrushToggle">
                            <local:IconLabel Icon="object" />
                        </ToggleButton>
                        <ToggleButton x:Name="BrushEdgeToggle" Style="{StaticResource OptionChip}"
                                      AutomationProperties.Name="{DynamicResource S_BrushEdge}"
                                      ToolTip="{DynamicResource S_BrushEdgeHint}"
                                      Checked="OnBrushToggle" Unchecked="OnBrushToggle">
                            <local:IconLabel Icon="edge" />
                        </ToggleButton>

                        <!-- Wie weit die Flaeche vom Ansatz abweichen darf - nur mit der Flaeche. -->
                        <StackPanel x:Name="BrushEdgeRow" Orientation="Horizontal" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsChecked, ElementName=BrushEdgeToggle}">
                            <StackPanel Orientation="Horizontal">
                                <local:IconLabel Icon="tolerance" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushEdgeTolerance}" />
                                <Slider x:Name="BrushEdgeSlider" Style="{StaticResource OptionSlider}"
                                        Minimum="0" Maximum="1" Value="0.3" SmallChange="0.05" LargeChange="0.2"
                                        ToolTip="{DynamicResource S_BrushEdgeToleranceHint}"
                                        ValueChanged="OnBrushChanged" MouseDoubleClick="OnBrushReset" Tag="0.3" />
                                <TextBlock x:Name="BrushEdgeValue" Style="{StaticResource OptionValue}" Margin="5,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- DRUCK - der Druck eines Stifts; die Maus hat keinen. Nur beim Zug. -->
                <Border x:Name="BrushPressureRow" Style="{StaticResource OptionGroup}">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <local:IconLabel Icon="pressure" Style="{StaticResource OptionIcon}" ToolTip="{DynamicResource S_BrushPressure}" />
                            <ComboBox x:Name="BrushPressureBox" Style="{StaticResource OverlayCombo}" Width="90"
                                      VerticalAlignment="Center" SelectedIndex="1" ToolTip="{DynamicResource S_BrushPressureHint}"
                                      SelectionChanged="OnBrushPressureChanged">
                                <ComboBoxItem Content="{DynamicResource S_BrushPressureOff}" />
                                <ComboBoxItem Content="{DynamicResource S_BrushPressureSize}" />
                                <ComboBoxItem Content="{DynamicResource S_BrushPressureFlow}" />
                                <ComboBoxItem Content="{DynamicResource S_BrushPressureBoth}" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- Der Verlauf der Maske, auf die der Pinsel malt - nur im Knotenmodus,
                     nur dort wird er aufgezeichnet. -->
                <Button x:Name="BrushEditButton" Style="{StaticResource OverlayButton}"
                        VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"
                        AutomationProperties.Name="{DynamicResource S_MaskEditButton}" Click="OnBrushEdit"
                        ToolTip="{DynamicResource S_MaskEditHint}">
                    <local:IconLabel Icon="mask-edit" />
                </Button>
                <Button x:Name="BrushHistoryButton" Style="{StaticResource OverlayButton}"
                        VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"
                        AutomationProperties.Name="{DynamicResource S_MaskMenuHistory}" Click="OnBrushHistory"
                        ToolTip="{DynamicResource S_MaskHistoryButtonHint}">
                    <local:IconLabel Icon="history" />
                </Button>
            </WrapPanel>

            <!-- Was die Pipette gelesen hat - ebenfalls in einer Zeile. -->
            <StackPanel x:Name="PickBody" DockPanel.Dock="Left" Orientation="Horizontal"
                        VerticalAlignment="Center" Visibility="Collapsed">

                <TextBlock Text="{DynamicResource S_PickAt}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="PickWhere" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <TextBlock Text="{DynamicResource S_PickByte}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="PickByte" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <!-- HEX und HSV der angezeigten Farbe (C4) - zum Vergleichen mit anderen Programmen. -->
                <Border x:Name="PickSwatch" Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                        Margin="0,0,6,0" BorderThickness="1" BorderBrush="{StaticResource PanelBorder}" />
                <TextBlock x:Name="PickHex" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="PickHsv" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <!--
                    Beide Zahlen, und das ist Absicht: Nur der Lichtwert beantwortet
                    "wie hell ist das wirklich", und nur der Anzeigewert laesst sich
                    mit einer Pipette in einem anderen Programm vergleichen.
                -->
                <TextBlock Text="{DynamicResource S_PickLight}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="PickLight" Style="{StaticResource PanelValue}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <StackPanel x:Name="DepthRow" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource S_PickDepth}" Style="{StaticResource PanelLabel}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="PickDepth" Style="{StaticResource PanelValue}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                </StackPanel>

                <!--
                    Der Grund, warum es die Pipette ueberhaupt gibt: Die nachtraegliche
                    Tiefenschaerfe verlangt eine Entfernung in Szeneneinheiten, und ein
                    Klick auf das, was scharf sein soll, ist die ehrliche Antwort.
                -->
                <!-- Was gelesen wird: das angezeigte Ergebnis oder die Quelle. -->
                <ToggleButton x:Name="PickFromSource" Style="{StaticResource OverlayToggle}" Margin="0,0,10,0"
                              VerticalAlignment="Center" Content="{DynamicResource S_PickSource}"
                              ToolTip="{DynamicResource S_PickSourceHint}" />

                <Button x:Name="FocusButton" Style="{StaticResource OverlayButton}"
                        VerticalAlignment="Center" IsEnabled="False"
                        Content="{DynamicResource S_UseAsFocus}" Click="OnUseAsFocus"
                        ToolTip="{DynamicResource S_UseAsFocusHint}" />

                <TextBlock x:Name="FocusNote" Margin="10,0,0,0" FontSize="10"
                           VerticalAlignment="Center" Visibility="Collapsed"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <!-- Beim Waehlen (C3): an welcher Kryptomatte, was gewaehlt ist, was unter dem Zeiger liegt. -->
            <StackPanel x:Name="SelectBody" DockPanel.Dock="Left" Orientation="Horizontal"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="SelectSet" Style="{StaticResource PanelLabel}" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <WrapPanel x:Name="SelectPicks" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource S_SelectUnder}" Style="{StaticResource PanelLabel}"
                           VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBlock x:Name="SelectHover" Style="{StaticResource PanelValue}" VerticalAlignment="Center" />
            </StackPanel>

            <!--
                Der Satz zum Werkzeug, am Ende: Er nimmt, was an Platz uebrig bleibt,
                und steht beim Pinsel hinter den Reglern statt davor.
            -->
            <TextBlock x:Name="ToolHint" FontSize="10" VerticalAlignment="Center" Visibility="Collapsed"
                       Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource MutedBrush}" />
        </DockPanel>
    </Border>
</UserControl>
