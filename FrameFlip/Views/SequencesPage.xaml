<UserControl x:Class="FrameFlip.Views.SequencesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SEQUENZEN" Margin="0,14,0,0"
                   FontFamily="{StaticResource DisplayFont}" FontSize="44"
                   Foreground="{StaticResource ForegroundBrush}" />

        <TextBlock Grid.Row="1" Margin="0,8,0,18" MaxWidth="620" HorizontalAlignment="Left"
                   TextWrapping="Wrap" FontFamily="{StaticResource BodyFont}"
                   FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                   Text="Was FrameFlip auf diesem Rechner schon einmal geöffnet hat. Anklicken lädt die Sequenz wieder in die Vorschau." />

        <!-- Wenn nichts da ist, steht das auch da - eine leere Liste ohne Erklärung
             sieht aus wie ein Fehler. -->
        <TextBlock x:Name="EmptyNote" Grid.Row="2" VerticalAlignment="Top" MaxWidth="620"
                   HorizontalAlignment="Left" TextWrapping="Wrap" Visibility="Collapsed"
                   FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                   Foreground="{StaticResource FaintBrush}"
                   Text="Noch nichts geöffnet. Im Explorer einen Ordner mit einer Bildsequenz markieren und den Hotkey drücken – danach steht die Sequenz hier." />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Items" />
        </ScrollViewer>
    </Grid>
</UserControl>
