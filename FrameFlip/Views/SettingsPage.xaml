<UserControl x:Class="FrameFlip.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,22"><TextBlock Text="{DynamicResource D_Settings}" Style="{StaticResource DesktopHeading}" /><TextBlock Text="{DynamicResource D_SettingsIntro}" Foreground="{StaticResource DesktopMuted}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" /></StackPanel>
<Border Grid.Row="1" Style="{StaticResource DesktopCard}"><ContentControl x:Name="EditorHost" /></Border></Grid>
</UserControl>