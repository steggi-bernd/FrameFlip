<UserControl x:Class="FrameFlip.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Kein Kasten mehr um den Inhalt, und keine grosse Ueberschrift.

         Vorher lagen hier DREI graue Flaechen ineinander: diese Seite als
         DesktopCard, darin der Reiterrumpf als zweite Flaeche, darin die Gruppe als
         dritte. Jede fuer sich war unauffaellig; uebereinander war es ein Kasten um
         einen Kasten um einen Kasten.

         Uebrig bleibt die Gruppe - die einzige, die etwas AUSSAGT, naemlich welche
         Einstellungen zusammengehoeren.

         Die Ueberschrift "Einstellungen" in Schriftgrad 30 stand ausserdem direkt
         unter dem Reiter "Einstellungen" in der Titelzeile. Zweimal dasselbe Wort,
         und das zweite kostete achtzig Pixel Hoehe. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource D_SettingsIntro}" Margin="0,0,0,14"
                   Foreground="{StaticResource DesktopMuted}" FontSize="11.5"
                   TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />

        <ContentControl x:Name="EditorHost" Grid.Row="1" />
    </Grid>
</UserControl>
