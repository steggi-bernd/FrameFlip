<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:views="clr-namespace:FrameFlip.Views">

    <!-- ================================================================ Farben

         Dunkel und flach, aber nicht neutralgrau: die Flaechen sind leicht ins
         Violette gezogen, in derselben Richtung wie der Akzent. Ein neutralgrauer
         Grund unter einem violetten Akzent laesst den Akzent aufgeklebt wirken;
         eine gemeinsame Tendenz haelt beides zusammen.

         Die Leiste liegt ueber dem Bild, deshalb ueberall halbtransparente
         Flaechen statt harter Kanten - eine Bedienflaeche, die das Bild
         zudeckt, hilft bei einer Bildvorschau niemandem.
    -->

    <SolidColorBrush x:Key="OverlayBackground" Color="#D81B1A23" />
    <SolidColorBrush x:Key="BadgeBackground" Color="#A6100F16" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FF1B1A23" />

    <!-- Eine Stufe ueber dem Panelgrund, fuer Eingabefelder und aufgehende Listen. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF252333" />
    <SolidColorBrush x:Key="PanelBorder" Color="#FF37324B" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFF2F0F7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FFA09AB4" />

    <!-- Die drei Kanaele, wo sie benannt werden muessen: an den Kurven und an den
         neun Zonenreglern, die sonst nicht auseinanderzuhalten waeren. Gedaempft
         genug, um neben einer Beschriftung nicht zu schreien. -->
    <SolidColorBrush x:Key="ChannelRed" Color="#FFE06C6C" />
    <SolidColorBrush x:Key="ChannelGreen" Color="#FF6CD086" />
    <SolidColorBrush x:Key="ChannelBlue" Color="#FF6C9CE0" />
    <SolidColorBrush x:Key="FaintBrush" Color="#FF716C86" />

    <!-- Violett statt des frueheren Blender-Orange. Hell genug, dass er auf dem
         dunklen Grund auch in duennen Linien traegt - ein satteres Violett saeuft
         in einer zwei Pixel breiten Kurve ab. -->

    <SolidColorBrush x:Key="AccentBrush" Color="#FFA47BF0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFBB9BFF" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#FFA47BF0" />

    <SolidColorBrush x:Key="ControlBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#FF67637A" />

    <!-- Fehlende Frames in der Zeitleiste. Bewusst nicht die Akzentfarbe: die steht
         fuer den bereits abgespielten Bereich, und beides nebeneinander waere nicht
         auseinanderzuhalten. -->
    <SolidColorBrush x:Key="GapBrush" Color="#FFE0566B" />

    <!-- Ecken an einer Stelle, damit sie ueberall gleich sind. -->
    <CornerRadius x:Key="ControlCorner">6</CornerRadius>
    <CornerRadius x:Key="SurfaceCorner">8</CornerRadius>

    <!-- Uebergangsdauer. Kurz genug, um nicht traege zu wirken, lang genug, damit
         die Flaeche nicht springt. -->
    <Duration x:Key="HoverDuration">0:0:0.12</Duration>

    <!-- ================================================================ Knoepfe -->

    <!-- Kleiner Textknopf fuer die Leiste, ohne Flaeche bis zum Ueberfahren. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Hover" Background="{StaticResource ControlBrush}"
                                CornerRadius="5" Opacity="0" />
                        <ContentPresenter Margin="6,2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Der Standardknopf der Leiste. Drei Schichten uebereinander statt einer
        umgefaerbten: die Grundflaeche bleibt, darueber wird eine zweite lediglich
        eingeblendet. Das laesst sich weich animieren, ohne an eingefrorenen
        Pinseln zu scheitern - eine Farbe aus dem Ressourcenwoerterbuch ist
        unveraenderlich und liesse sich gar nicht animieren.
    -->
    <Style x:Key="OverlayButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Base" Background="{StaticResource ControlBrush}"
                                CornerRadius="{StaticResource ControlCorner}"
                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" />
                        <Border x:Name="Hover" Background="{StaticResource ControlHoverBrush}"
                                CornerRadius="{StaticResource ControlCorner}" Opacity="0" />
                        <ContentPresenter Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Gedrueckt kurz dunkler: ohne diese Rueckmeldung fuehlt sich
                             ein flacher Knopf tot an. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                        </Trigger>

                        <!-- Ein gesperrter Knopf muss auch gesperrt aussehen. Ohne das
                             klickt man ins Leere und sucht den Fehler beim Programm. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Base" Property="Background" Value="#12FFFFFF" />
                            <Setter TargetName="Base" Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schliessen-Knopf in der Kopfleiste: rot beim Ueberfahren, wie bei Systemfenstern. -->
    <Style x:Key="HeaderButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Hover" Background="#FFCF4B44" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eingeschaltet wird nicht nur die Schrift eingefaerbt, sondern die Flaeche
         mit angehoben. Nur farbige Schrift ist auf einem halbtransparenten Grund
         ueber wechselndem Bildinhalt zu leicht zu uebersehen. -->
    <Style x:Key="OverlayToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Base" Background="{StaticResource ControlBrush}"
                                CornerRadius="{StaticResource ControlCorner}"
                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" />
                        <Border x:Name="Hover" Background="{StaticResource ControlHoverBrush}"
                                CornerRadius="{StaticResource ControlCorner}" Opacity="0" />
                        <Border x:Name="Active" Background="#2EA47BF0"
                                BorderBrush="#66A47BF0" BorderThickness="1"
                                CornerRadius="{StaticResource ControlCorner}" Opacity="0" />
                        <ContentPresenter Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Active" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Der Knopf der Werkzeugspalte: quadratisch, weil ein Zeichen darin steht und
        keine Beschriftung. Alles andere kommt von OverlayToggle - die gewaehlte
        Farbe, das Schweben, die Ecken. Ein eigener Entwurf haette dieselben drei
        Zustaende noch einmal beschrieben und waere beim naechsten Farbwechsel
        zurueckgeblieben.
    -->
    <Style x:Key="ToolButton" TargetType="ToggleButton" BasedOn="{StaticResource OverlayToggle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--
        Eine Kachel der Farbspalte.

        Breit genug fuer einen Namen, schmal genug fuer zwei Spalten. Alles andere
        kommt von OverlayToggle - die gewaehlte Farbe und das Schweben -, damit eine
        Kachel sich anfuehlt wie jeder andere Schalter im Programm.
    -->
    <Style x:Key="ToolTile" TargetType="ToggleButton" BasedOn="{StaticResource OverlayToggle}">
        <Setter Property="Width" Value="128" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,0,5,5" />
    </Style>

    <!--
        Der Kopf eines Abschnitts in der rechten Spalte.

        Er tut zwei Dinge auf einmal, und beide waren gewuenscht: Er sagt, wo ein
        Bereich ANFAENGT - vorher ging die Farbkorrektur ohne sichtbare Grenze in die
        Ebenen ueber -, und er klappt ihn zu. Ein Balken mit eigener Flaeche und einer
        Linie darunter trennt deutlicher als jeder Abstand, und er kostet keine Hoehe,
        die nicht ohnehin fuer die Ueberschrift draufginge.

        Der Winkel zeigt nach unten, wenn offen, und nach rechts, wenn zu - dieselbe
        Richtung wie ueberall sonst, damit niemand sie lesen muss.
    -->
    <Style x:Key="SectionHeader" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bar" Background="{StaticResource OverlayBackground}"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="Chevron" Grid.Column="0" Width="8" Height="8"
                                  Margin="0,0,7,0" VerticalAlignment="Center"
                                  Stretch="Uniform" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stroke="{StaticResource MutedBrush}"
                                  Data="M1,3 L5,7 L9,3"
                                  RenderTransformOrigin="0.5,0.5" />

                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{StaticResource ControlBrush}" />
                            <Setter TargetName="Chevron" Property="Stroke"
                                    Value="{StaticResource ForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Der Knopf der Leiste unter der Ebenenliste.

        Flach und ohne eigene Flaeche, bis die Maus darueber steht. Der gewoehnliche
        Knopf traegt einen sichtbaren Kasten, und acht Kaesten nebeneinander unter
        einer Liste sehen aus wie ein Bedienfeld fuer etwas anderes - sie ziehen mehr
        Aufmerksamkeit auf sich als die Liste, zu der sie gehoeren.
    -->
    <Style x:Key="StripButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Hover" Background="{StaticResource ControlHoverBrush}"
                                CornerRadius="4" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Derselbe flache Knopf, aber mit Zustand.
        
        Gebraucht fuer die Schnittmaske: Sie ist kein Befehl, sondern eine
        Eigenschaft der Ebene, und ein Knopf, der sie umlegt, ohne zu zeigen, wie sie
        steht, laesst einen jedes Mal im Bild nachsehen.
    -->
    <Style x:Key="StripToggle" TargetType="ToggleButton" BasedOn="{StaticResource OverlayToggle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
        Karomuster hinter einer Miniatur: Damit sieht eine freigestellte Ebene in der
        Liste auch freigestellt aus. Auf einem einfarbigen Grund ist "durchsichtig"
        von "genau dieser Farbe" nicht zu unterscheiden, und das ist bei einer Liste
        aus Freistellungen die einzige Frage, die man an eine Miniatur hat.
    -->
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Stretch="None"
                  Viewport="0,0,8,8" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF2A2836">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF35323F">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,4,4" />
                            <RectangleGeometry Rect="4,4,4,4" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ================================================================ Regler

         Scrubber und Panelregler teilen sich denselben Aufbau: eine durchgehende
         Rinne, der gefuellte Teil links davon in der Akzentfarbe, darauf ein
         runder Griff mit Hof. Der Hof waechst beim Ueberfahren und noch einmal
         beim Ziehen - beim Scrubben liegt der Mauszeiger genau darauf, und ohne
         diese Rueckmeldung weiss man nicht, ob man den Griff hat.
    -->

    <Style x:Key="TrackFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource AccentBrush}" Height="4" CornerRadius="2"
                            VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrackEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource TrackBrush}" Height="4" CornerRadius="2"
                            VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Der Griff. Der Hof liegt als eigene Ellipse darunter und wird nur skaliert
        und eingeblendet: eine Groessenaenderung ueber Width/Height wuerde jedes Mal
        einen Layoutdurchlauf ausloesen, waehrend eine Skalierung allein beim
        Zeichnen anfaellt. Bei einem Regler, den man waehrend der Wiedergabe zieht,
        ist das der Unterschied zwischen weich und hakelig.
    -->
    <ControlTemplate x:Key="ThumbTemplate" TargetType="Thumb">
        <Grid Background="Transparent">
            <Ellipse x:Name="Glow" Fill="{StaticResource AccentGlowBrush}" Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Knob" Fill="{StaticResource ThumbBrush}" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="KnobScale" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                             To="0.3" Duration="{StaticResource HoverDuration}" />
                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX"
                                             To="2" Duration="{StaticResource HoverDuration}" />
                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY"
                                             To="2" Duration="{StaticResource HoverDuration}" />
                            <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.15" Duration="{StaticResource HoverDuration}" />
                            <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.15" Duration="{StaticResource HoverDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource HoverDuration}" />
                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="{StaticResource HoverDuration}" />
                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="{StaticResource HoverDuration}" />
                            <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="{StaticResource HoverDuration}" />
                            <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="{StaticResource HoverDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!--
                Beim Ziehen bleibt der Hof stehen, auch wenn der Zeiger den Griff
                seitlich verlaesst - genau dann braucht man ihn.

                Und er GEHT WIEDER AUS. Eine Animation ohne Gegenstueck haelt ihren
                Wert fuer immer: Der Hof blieb an dem Regler stehen, den man zuletzt
                bedient hatte, und beim naechsten stand ein zweiter daneben. Gestoppt
                statt zurueckanimiert, weil darunter noch der Schwebezustand liegt -
                wer den Griff nach dem Ziehen nicht verlassen hat, soll den kleinen
                Hof behalten und nicht gar keinen.
            -->
            <Trigger Property="IsDragging" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="DragGlow">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                             To="0.45" Duration="{StaticResource HoverDuration}" />
                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX"
                                             To="2.4" Duration="{StaticResource HoverDuration}" />
                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY"
                                             To="2.4" Duration="{StaticResource HoverDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="DragGlow" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ScrubThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource ThumbTemplate}" />
    </Style>

    <Style x:Key="Scrubber" TargetType="Slider">
        <Setter Property="views:SliderGuard.CancelOnRightClick" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackEmpty}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrubThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Auswahl

         ComboBox: eigenes Template, damit das Popup nicht im hellen Systemstil
         aufgeht.
    -->

    <Style x:Key="OverlayComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Margin="4,1">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" />

                        <!-- Ein schmaler Strich links statt einer eingefaerbten Zeile:
                             die Auswahl bleibt lesbar, auch wenn die Liste lang ist. -->
                        <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,4"
                                Background="{StaticResource AccentBrush}" CornerRadius="2" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Marker" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OverlayCombo" TargetType="ComboBox">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource OverlayComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="Base" Background="{StaticResource ControlBrush}"
                                                CornerRadius="{StaticResource ControlCorner}"
                                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" />
                                        <Border x:Name="Hover" Background="{StaticResource ControlHoverBrush}"
                                                CornerRadius="{StaticResource ControlCorner}" Opacity="0" />
                                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,9,0" Data="M0,0 L7,0 L3.5,4.5 Z"
                                              Fill="{StaticResource MutedBrush}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource ForegroundBrush}" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="{StaticResource HoverDuration}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="{StaticResource HoverDuration}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Base" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter IsHitTestVisible="False" Margin="10,0,24,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <Popup x:Name="PART_Popup" Placement="Top" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="#F5232030" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource SurfaceCorner}" Padding="0,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,0,0,6">
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Dialog -->

    <Style x:Key="DialogLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style x:Key="DialogTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCorner}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF4A4E55" />
                        </Trigger>

                        <!-- Das Feld mit dem Schreibfokus muss man finden, ohne zu suchen. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Kaestchen und Punkt kommen sonst im Systemstil - und der sieht in einem
        dunklen, flachen Fenster wie ein Fremdkoerper aus. Deshalb beide
        nachgebaut, mit derselben Akzentfarbe wie die Regler.
    -->
    <Style x:Key="DialogCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- Ein Gitter, keine waagerechte StackPanel.

                     Eine waagerechte StackPanel misst ihre Kinder mit unbegrenzter
                     Breite. Eine mehrzeilige Beschriftung bekommt dort nie eine
                     Breite zugeteilt, an der sie umbrechen koennte - TextWrapping
                     steht dran und wirkt nicht, die Zeile laeuft aus der Tafel
                     hinaus. Die Sternspalte gibt ihr den Rest der Zeile. -->
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="4"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="#FF4A4E55" BorderThickness="1" />
                            <Border x:Name="Fill" CornerRadius="4" Opacity="0"
                                    Background="{StaticResource AccentBrush}" />
                            <Path x:Name="Tick" Opacity="0" Stretch="Uniform" Margin="3.5"
                                  Data="M0,4.5 L3.4,8 L9.5,0.6" Stroke="#FF15131C" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0"
                                          VerticalAlignment="Center" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}"><AccessText Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="1" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Fill" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{StaticResource SurfaceBrush}"
                                     Stroke="#FF4A4E55" StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Fill="{StaticResource AccentBrush}" Margin="4.5" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="DotScale" ScaleX="0.4" ScaleY="0.4" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource HoverDuration}" />
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.4" Duration="{StaticResource HoverDuration}" />
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.4" Duration="{StaticResource HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource OverlayButton}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Height" Value="30" />
    </Style>

    <!-- ================================================================ Seitenpanel -->

    <Style x:Key="PanelHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PanelLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Zahlen rechtsbündig und in fester Schrittweite: so springt die Anzeige beim
         Ziehen am Regler nicht seitlich hin und her. -->
    <Style x:Key="PanelValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="PanelSliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource ThumbTemplate}" />
    </Style>

    <!-- ================================================================ Metriken

         Karten statt Tabelle. Eine Tabelle aus Zahlen liest niemand, waehrend im
         Hintergrund ein Render laeuft - eine grosse Zahl mit Kurve daneben schon.
    -->

    <Style x:Key="MetricCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SurfaceCorner}" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Klein, gesperrt, gedaempft: eine Beschriftung soll benennen, nicht auffallen. -->
    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!--
        Zahlen in gleicher Zeichenbreite. Ohne das springt die Anzeige bei jedem
        Wechsel von 9 auf 10 seitlich - bei einer Groesse, die sich sekuendlich
        aendert, ist das quaelend.
    -->
    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style x:Key="MetricUnit" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="3,0,0,3" />
    </Style>

    <Style x:Key="MetricNote" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Fortschrittsbalken ohne ProgressBar-Steuerelement: Dessen Vorlage bringt
        Rahmen, Animation und Systemfarben mit, die hier alle wieder abgeraeumt
        werden muessten. Zwei Rechtecke sind ehrlicher.
    -->
    <Style x:Key="ProgressTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TrackBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Height" Value="6" />
    </Style>

    <Style x:Key="ProgressFill" TargetType="Border">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Height" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF8F63EA" Offset="0" />
                    <GradientStop Color="#FFC49BFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Ein Regler, dessen Bahn zeigt, wohin er fuehrt.

        Die Bahn traegt den Verlauf aus Background - blau nach orange bei der
        Temperatur, gruen nach magenta bei der Tendenz, grau nach bunt bei der
        Saettigung. Das spart die Beschriftung "links kuehler, rechts waermer" und
        sagt dasselbe schneller.

        Getrennt vom gewoehnlichen PanelSlider und nicht als dessen Erweiterung: Wo
        es nichts zu zeigen gibt - Belichtung, Gamma - waere ein Verlauf eine
        Behauptung ueber eine Richtung, die es nicht gibt.
    -->
    <Style x:Key="PanelSliderTinted" TargetType="Slider">
        <Setter Property="views:SliderGuard.CancelOnRightClick" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <!-- Background und nicht Tag: dort steht schon der Wert, auf
                             den ein Doppelklick zuruecksetzt. -->
                        <Border Background="{TemplateBinding Background}" Height="5" CornerRadius="3"
                                VerticalAlignment="Center" Margin="5,0" Opacity="0.85" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PanelSliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Die Verlaeufe dazu. Gedaempft, damit die Bahn den Griff nicht ueberstrahlt. -->
    <LinearGradientBrush x:Key="TrackTemperature" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF5B8CC8" Offset="0" />
        <GradientStop Color="#FF9AA0A8" Offset="0.5" />
        <GradientStop Color="#FFD79A4E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TrackTint" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF5FB37A" Offset="0" />
        <GradientStop Color="#FF9AA0A8" Offset="0.5" />
        <GradientStop Color="#FFC072B8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TrackSaturation" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF6E6E76" Offset="0" />
        <GradientStop Color="#FF8E8E96" Offset="0.33" />
        <GradientStop Color="#FFC8794E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TrackVibrance" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF6E6E76" Offset="0" />
        <GradientStop Color="#FF8E8E96" Offset="0.5" />
        <GradientStop Color="#FF66A8C0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TrackRed" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF4A3236" Offset="0" />
        <GradientStop Color="#FFE06C6C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TrackGreen" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF2F4436" Offset="0" />
        <GradientStop Color="#FF6CD086" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TrackBlue" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF303C4E" Offset="0" />
        <GradientStop Color="#FF6C9CE0" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="PanelSlider" TargetType="Slider">
        <Setter Property="views:SliderGuard.CancelOnRightClick" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Background="{StaticResource TrackBrush}" Height="3" CornerRadius="2"
                                VerticalAlignment="Center" Margin="5,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PanelSliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reiter fuer den Einstellungsdialog.
         Der Dialog war eine einzige Spalte aus vierzehn Zeilen und hoerte irgendwann
         unten aus dem Bildschirm heraus auf. Reiter kosten einen Klick und geben
         dafuer eine Ordnung, in der man etwas wiederfindet.

         Kein Rahmen, keine Lasche - nur der ausgewaehlte Reiter traegt einen Strich
         in der Akzentfarbe. Alles andere waere Zierrat um einen Text herum. -->
    <Style x:Key="DialogTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,16,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Panel.ZIndex="1" />
                        </Border>

                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="2" />
                        </Grid.RowDefinitions>

                        <ContentPresenter Grid.Row="0" ContentSource="Header"
                                          Margin="14,8" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />

                        <!-- Der Strich liegt immer da und ist nur unsichtbar. Ihn
                             ein- und auszublenden verschoebe sonst die Beschriftung
                             um zwei Pixel, sobald man den Reiter wechselt. -->
                        <Border x:Name="Mark" Grid.Row="1"
                                Background="{StaticResource AccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                            <Setter TargetName="Mark" Property="Opacity" Value="0.3" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dieselben drei Rollen wie in der Handy-App: Anton fuer Zahlen, die man aus
         zwei Metern lesen soll, Archivo fuer gesperrte Versalien, Montserrat fuer
         Fliesstext. Der Doppelpunkt vor dem Doppelkreuz ist Pflicht - ohne ihn sucht
         WPF die Schrift im Systemordner statt im Programm. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/FrameFlip;component/Assets/Fonts/#Anton</FontFamily>
    <FontFamily x:Key="HeadFont">pack://application:,,,/FrameFlip;component/Assets/Fonts/#Archivo</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/FrameFlip;component/Assets/Fonts/#Montserrat</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>

    <!-- Die Farben des Entwurfs 2a, gleich benannt wie in der App. Blau ist
         bewusst heller als im Designsystem, Rosa entschaerft: Es erscheint nur,
         wenn etwas nicht stimmt. -->
    <SolidColorBrush x:Key="AppBg" Color="#FF07070D" />
    <SolidColorBrush x:Key="AppBg2" Color="#FF0D0D16" />
    <SolidColorBrush x:Key="AppSurface" Color="#FF11111B" />
    <SolidColorBrush x:Key="AppNav" Color="#FF0B0B14" />
    <SolidColorBrush x:Key="AppBlue" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="AppCyan" Color="#FF22D3EE" />
    <SolidColorBrush x:Key="AppWarn" Color="#FFF472B6" />
    <SolidColorBrush x:Key="AppDim" Color="#FF6B6B80" />

    <!-- ============================================================ Bildlaufleiste

         Ohne eigene Vorlage nimmt WPF die von Windows: hellgrau, mit Pfeilknoepfen,
         breit. In einer dunklen Oberflaeche ist das der einzige helle Streifen im
         Bild, und er faellt genau deshalb auf.

         Hier nur ein Griff, schmal, ohne Knoepfe, ohne Rahmen - er hebt sich beim
         Zeigen etwas an, damit man merkt, dass man ihn fassen kann. -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="3" CornerRadius="3" Background="#FF2A2A3A" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#FF3E3E52" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#FF4C4C64" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Die Spur bleibt unsichtbar: Ein Klick daneben soll weiterhin seitenweise
         springen, deshalb liegt dort eine durchsichtige Flaeche und kein Nichts. -->
    <Style x:Key="ScrollTrack" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollTrack}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollTrack}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="11" />
                <Setter Property="MinHeight" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollTrack}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollTrack}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
