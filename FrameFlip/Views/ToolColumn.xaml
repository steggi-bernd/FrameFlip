<UserControl x:Class="FrameFlip.Views.ToolColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--
            Die Zeichen sind gezeichnet und nicht gesetzt.

            Ein Zeichensatz mit Symbolen waere weniger Arbeit und eine Wette darauf,
            dass er auf jedem Rechner liegt und in jeder Groesse gleich aussieht. Fuenf
            Striche kosten einmal zwanzig Minuten und sehen danach ueberall gleich aus.

            Die Farbe kommt von der Schaltflaeche darueber: Die Vorlage faerbt ihren
            Vordergrund um, sobald sie gewaehlt ist, und der Strich zieht mit. Sonst
            waere das gewaehlte Werkzeug an allem zu erkennen ausser an seinem Zeichen.
        -->
        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Stroke"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            <Setter Property="StrokeThickness" Value="1.25" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
            CornerRadius="4" Padding="5,7" VerticalAlignment="Top">
        <StackPanel>
            <!--
                Umschaltknoepfe einer Gruppe und nicht fuenf einzelne Schalter: Damit
                ist genau eines gewaehlt, ohne dass jemand das nachhalten muss - und
                "kein Werkzeug" gibt es nicht. Ein Bild, das je nach Zustand etwas
                anderes tut oder nichts, ist genau das, was hier abgeschafft wird.
            -->
            <RadioButton x:Name="MoveTool" Style="{StaticResource ToolButton}"
                         GroupName="AtelierTool" Tag="Move" IsChecked="True"
                         Checked="OnToolChecked"
                         ToolTip="{DynamicResource S_ToolMoveHint}">
                <Path Style="{StaticResource ToolIcon}"
                      Data="M8,1 L8,15 M1,8 L15,8
                            M8,1 L5.6,3.4 M8,1 L10.4,3.4
                            M8,15 L5.6,12.6 M8,15 L10.4,12.6
                            M1,8 L3.4,5.6 M1,8 L3.4,10.4
                            M15,8 L12.6,5.6 M15,8 L12.6,10.4" />
            </RadioButton>

            <RadioButton x:Name="SelectTool" Style="{StaticResource ToolButton}"
                         GroupName="AtelierTool" Tag="Select" Checked="OnToolChecked"
                         ToolTip="{DynamicResource S_ToolSelectHint}">
                <Path Style="{StaticResource ToolIcon}"
                      Data="M2,5 L2,2 L5,2 M11,2 L14,2 L14,5
                            M14,11 L14,14 L11,14 M5,14 L2,14 L2,11
                            M6,8 A2,2 0 1 1 10,8 A2,2 0 1 1 6,8" />
            </RadioButton>

            <RadioButton x:Name="CropTool" Style="{StaticResource ToolButton}"
                         GroupName="AtelierTool" Tag="Crop" Checked="OnToolChecked"
                         ToolTip="{DynamicResource S_ToolCropHint}">
                <Path Style="{StaticResource ToolIcon}"
                      Data="M4,1 L4,12 L15,12 M1,4 L12,4 L12,15" />
            </RadioButton>

            <RadioButton x:Name="HandTool" Style="{StaticResource ToolButton}"
                         GroupName="AtelierTool" Tag="Hand" Checked="OnToolChecked"
                         ToolTip="{DynamicResource S_ToolHandHint}">
                <Path Style="{StaticResource ToolIcon}"
                      Data="M3.5,12 L3.5,7 M6.5,12 L6.5,4 M9.5,12 L9.5,5 M12.5,11.5 L12.5,7.5
                            M3.5,11 C4.5,14.5 11.5,14.5 12.5,11" />
            </RadioButton>

            <RadioButton x:Name="BrushTool" Style="{StaticResource ToolButton}"
                         GroupName="AtelierTool" Tag="Brush" Checked="OnToolChecked"
                         ToolTip="{DynamicResource S_ToolBrushHint}">
                <Path Style="{StaticResource ToolIcon}"
                      Data="M3,15 C3,12 4,11 6,10.5 L10.5,6 L13,8.5 L8.5,13
                            C8,15 7,15.5 3,15 Z
                            M10.5,6 L12.5,3.5 A1.6,1.6 0 0 1 15,6 L13,8.5" />
            </RadioButton>

            <RadioButton x:Name="PickTool" Style="{StaticResource ToolButton}"
                         GroupName="AtelierTool" Tag="Pick" Checked="OnToolChecked"
                         ToolTip="{DynamicResource S_ToolPickHint}">
                <Path Style="{StaticResource ToolIcon}"
                      Data="M2,14 L2,11 L9.5,3.5 L12.5,6.5 L5,14 Z
                            M9.5,3.5 L11.5,1.5 L14.5,4.5 L12.5,6.5" />
            </RadioButton>
        </StackPanel>
    </Border>
</UserControl>
