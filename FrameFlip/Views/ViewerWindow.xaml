<Window x:Class="FrameFlip.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:FrameFlip.Views"
        Title="FrameFlip"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        MinWidth="400" MinHeight="300"
        Background="#FF171717"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Opacity="0">

    <!-- Ohne WindowChrome zeichnet WPF bei WindowStyle=None trotzdem einen
         Glasrahmen an der Oberkante - das ist der helle Streifen. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Drei Spalten: Metriken links, Bild in der Mitte, Korrektur rechts.
             Getrennte Spalten statt einer gemeinsamen - dadurch koennen beide
             gleichzeitig offen sein, und keine muss der anderen weichen. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Kopfleiste: Dateiname links, Zustand rechts. Ziehen bewegt das Fenster. -->
        <Grid x:Name="Header" Grid.Row="0" Grid.ColumnSpan="3" Background="#FF202020">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FileNameText" Grid.Column="0"
                       Margin="14,0,12,0" VerticalAlignment="Center"
                       Foreground="{StaticResource ForegroundBrush}"
                       FontFamily="Segoe UI" FontSize="12.5"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="RateText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           ToolTip="{DynamicResource S_MeasuredRate}" />
                <TextBlock x:Name="BufferText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           ToolTip="{DynamicResource S_BufferAhead}" />
                <TextBlock x:Name="LoadText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />

                <!-- Sichtbarer Hinweis, dass nicht das Original zu sehen ist. -->
                <TextBlock x:Name="AdjustBadge" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource AccentBrush}" FontSize="11"
                           Visibility="Collapsed"
                           ToolTip="{DynamicResource S_Adjusted}" />

                <!-- Aufloesung, Farbtiefe und Dateigroesse. Ein Klick blendet die
                     Angaben aus; der Zustand wird in der Konfiguration gehalten. -->
                <Button x:Name="MetaButton" Style="{StaticResource LinkButton}"
                        Margin="0,0,6,0" Click="OnMetaClicked"
                        ToolTip="{DynamicResource S_ToggleMeta}">
                    <TextBlock x:Name="MetaText" FontSize="11" />
                </Button>

                <Button x:Name="ZoomButton" Style="{StaticResource LinkButton}"
                        Margin="0,0,6,0" MinWidth="46" Click="OnZoomClicked"
                        ToolTip="{DynamicResource S_ZoomHint}">
                    <TextBlock x:Name="ZoomText" FontSize="11" TextAlignment="Right" />
                </Button>

                <Button x:Name="CloseButton" Style="{StaticResource HeaderButton}"
                        Content="&#x2715;" ToolTip="{DynamicResource S_Close}" Click="OnCloseClicked" />
            </StackPanel>
        </Grid>

        <!-- Anzeige. Gezoomt wird ausschliesslich ueber die Matrix auf dem Bild;
             Layoutgroessen bleiben davon unberuehrt.

             Der Canvas ist nicht kosmetisch, sondern die eigentliche Reparatur des
             Zoom-Fehlers: ein Grid arrangiert sein Kind in der Zellgroesse und setzt,
             sobald das Kind groesser ist, einen Layout-Clip. Der greift in den
             Koordinaten des Kindes, also VOR der RenderTransform - das verschobene
             Bild wurde dadurch rechts und unten um genau den Betrag des Versatzes
             abgeschnitten. Ein Canvas misst seine Kinder ohne Begrenzung und
             arrangiert sie in voller Groesse, es entsteht kein Layout-Clip.
             Beschnitten wird nur noch aussen am Viewport. -->
        <Grid x:Name="Viewport" Grid.Row="1" Grid.Column="1" Background="#FF101010" ClipToBounds="True">
            <Canvas x:Name="Stage" ClipToBounds="True">
                <Image x:Name="Display"
                       Stretch="None"
                       RenderTransformOrigin="0,0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <MatrixTransform x:Name="ViewTransform" />
                    </Image.RenderTransform>
                </Image>
            </Canvas>

            <!-- Nach links gerueckt: Oben rechts sitzt jetzt die Werkzeugleiste, und
                 eine Meldung, die einen Knopf verdeckt, ist schlimmer als eine, die
                 man an ungewohnter Stelle sucht. -->
            <Border x:Name="StatusBadge" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                    Background="{StaticResource BadgeBackground}" CornerRadius="4" Padding="10,5">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentBrush}" FontSize="12"
                           TextWrapping="Wrap" MaxWidth="420" />
            </Border>

            <!--
                Werkzeugleiste. Blendet mit derselben Zeit aus wie die Bedienleiste
                unten - sie ist beim Betrachten eines Bildes genauso im Weg.

                Getrennt von der Wiedergabe, weil es zwei verschiedene Dinge sind:
                Unten steuert man die Zeit, oben stellt man ein, WIE gezeigt wird.
                Zusammengedraengt neben dem Scrubber standen beide einander im Weg.
            -->
            <Border x:Name="ToolBar" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="10" Background="{StaticResource OverlayBackground}"
                    CornerRadius="6" Padding="8,6">
                <StackPanel Orientation="Horizontal">
                    <!-- Dekodiergröße. Wirkt auf den Puffervorlauf, nicht auf den Zoom. -->
                    <Button x:Name="DraftButton" Style="{StaticResource OverlayButton}"
                            Margin="0,0,8,0" MinWidth="52" Click="OnDraftClicked">
                        <TextBlock x:Name="DraftText" FontSize="12" />
                    </Button>

                    <ComboBox x:Name="FpsBox" Style="{StaticResource OverlayCombo}"
                              Width="88" ToolTip="{DynamicResource S_FrameRate}"
                              SelectionChanged="OnFpsChanged" />

                    <ToggleButton x:Name="PanelButton" Style="{StaticResource OverlayToggle}"
                                  Margin="8,0,0,0" Content="&#x25E7;"
                                  ToolTip="{DynamicResource S_TogglePanel}"
                                  Checked="OnPanelToggled" Unchecked="OnPanelToggled" />

                    <ToggleButton x:Name="MetricsButton" Style="{StaticResource OverlayToggle}"
                                  Margin="6,0,0,0" Content="&#x25D4;"
                                  ToolTip="{DynamicResource S_ToggleMetrics}"
                                  Checked="OnMetricsToggled" Unchecked="OnMetricsToggled" />

                    <Button x:Name="ExportButton" Style="{StaticResource OverlayButton}"
                            Margin="8,0,0,0" Content="{DynamicResource S_Export}"
                            ToolTip="{DynamicResource S_ExportHint}"
                            Click="OnExportClicked" />

                    <!--
                        Einstellungen als Schieberegler-Zeichen statt als Zahnrad.
                        Ein Zahnrad steht fuer Maschinenteile; was man hier oeffnet,
                        sind Regler - und in einem Werkzeug fuer Bild und Ton ist das
                        auch das vertrautere Bild.
                    -->
                    <Button x:Name="SettingsButton" Style="{StaticResource OverlayButton}"
                            Margin="8,0,0,0" ToolTip="{DynamicResource S_Settings}"
                            Click="OnSettingsClicked">
                        <Canvas Width="15" Height="12" SnapsToDevicePixels="True">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M0,2 H15 M0,6 H15 M0,10 H15" />
                            <Ellipse Canvas.Left="8.5" Canvas.Top="0" Width="4" Height="4"
                                     Fill="{StaticResource AccentBrush}" />
                            <Ellipse Canvas.Left="2.5" Canvas.Top="4" Width="4" Height="4"
                                     Fill="{StaticResource AccentBrush}" />
                            <Ellipse Canvas.Left="9.5" Canvas.Top="8" Width="4" Height="4"
                                     Fill="{StaticResource AccentBrush}" />
                        </Canvas>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Bedienleiste, blendet nach 2 s Inaktivitaet aus -->
            <Border x:Name="ControlBar" VerticalAlignment="Bottom" Margin="10"
                    Background="{StaticResource OverlayBackground}" CornerRadius="6" Padding="10,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Hinweiszeile fuer Luecken. Nur sichtbar, wenn welche da sind. -->
                    <Grid x:Name="GapBar" Grid.Row="0" Margin="0,0,0,6" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="GapText" Grid.Column="0" VerticalAlignment="Center"
                                   Margin="2,0,8,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource GapBrush}" FontSize="11" />

                        <Button x:Name="CopyBlenderButton" Grid.Column="1"
                                Style="{StaticResource LinkButton}"
                                Content="{DynamicResource S_CopyBlender}" Click="OnCopyBlenderClicked"
                                ToolTip="{DynamicResource S_CopyBlenderHint}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayButton" Grid.Column="0" Style="{StaticResource OverlayButton}"
                                Content="&#x25B6;" ToolTip="{DynamicResource S_PlayPause}" Click="OnPlayClicked" />

                        <!-- Luecken und Scrubber liegen in derselben Zelle mit derselben
                             Randbreite; dadurch decken sich Markierung und Spur exakt. -->
                        <Grid Grid.Column="1" Margin="12,0">
                            <Slider x:Name="Scrubber" Style="{StaticResource Scrubber}"
                                    VerticalAlignment="Center"
                                    Minimum="0" Maximum="1" Value="0" />

                            <!-- Beide Markierungen liegen UEBER dem Scrubber. Der
                                 gefuellte Teil der Spur ist deckend; darunter waere
                                 jede Luecke unsichtbar, an der man schon vorbei ist -
                                 und der In-Punkt praktisch immer. -->
                            <local:TimelineGaps x:Name="GapStrip" VerticalAlignment="Center"
                                                IsHitTestVisible="False" />

                            <local:TimelineRange x:Name="RangeStrip" VerticalAlignment="Center"
                                                 IsHitTestVisible="False"
                                                 MarkerBrush="{StaticResource ForegroundBrush}" />
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="CounterText"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       FontFamily="Consolas, Courier New" FontSize="13"
                                       ToolTip="{DynamicResource S_FrameNumber}" />
                            <TextBlock x:Name="RangeText" Margin="10,0,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Consolas, Courier New" FontSize="11"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       ToolTip="{DynamicResource S_InOutRange}" />
                        </StackPanel>

                        <ToggleButton x:Name="LoopButton" Grid.Column="3" Style="{StaticResource OverlayToggle}"
                                      Content="&#x27F3;" ToolTip="{DynamicResource S_Loop}" Margin="0,0,8,0"
                                      Checked="OnLoopChanged" Unchecked="OnLoopChanged" />

                        <!-- Die Werkzeuge sind nach oben gewandert. Hier unten bleibt,
                             was zur Wiedergabe gehoert: abspielen, scrubben, zaehlen,
                             loopen. -->

                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bildanpassung. Klappt nach rechts auf; das Fenster wächst mit, solange
             der Bildschirm es hergibt. Alles hier betrifft nur die Anzeige – die
             Dateien auf der Platte bleiben unberührt. -->
        <!--
            Der Metrik-Fluegel, links. Eigene Spalte, damit er neben der Korrektur
            bestehen kann statt gegen sie: Beide teilten sich vorher eine Zelle,
            mussten einander weichen und rechneten dabei zweimal an derselben
            Fensterbreite herum.

            Der Rahmen liegt rechts - zur Bildflaeche hin.
        -->
        <Border x:Name="MetricsPanel" Grid.Row="1" Grid.Column="0" Width="288"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,12,14,14">

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource S_Render}" Style="{StaticResource PanelHeading}" />

                        <Border Grid.Column="1" x:Name="JobStateBadge" CornerRadius="4"
                                Background="#2EF2913F" Padding="7,2">
                            <TextBlock x:Name="JobStateText" Text="{DynamicResource S_JobRunning}" FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <!-- Leerzustand: erklaert sich selbst, statt als Meldung ueber
                         dem Bild aufzutauchen und dort stehen zu bleiben. -->
                    <TextBlock x:Name="MetricsEmpty" Style="{StaticResource MetricNote}"
                               Margin="2,0,0,10" Visibility="Collapsed"
                               Text="{DynamicResource S_NoRender}" />

                    <!-- Der zuletzt geschriebene Frame. Beantwortet die Frage, wegen
                         der man ueberhaupt hinsieht: Wie sieht es gerade aus? -->
                    <Border x:Name="PreviewCard" Style="{StaticResource MetricCard}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="{DynamicResource S_LastWritten}" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="PreviewCaption" Style="{StaticResource MetricNote}"
                                           HorizontalAlignment="Right" Text="" />
                            </Grid>

                            <Border CornerRadius="5" ClipToBounds="True"
                                    Background="#FF101014" MinHeight="60">
                                <Image x:Name="LatestPreview" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Gesamtfortschritt -->
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_Overall}" Style="{StaticResource MetricLabel}" />

                            <StackPanel Orientation="Horizontal" Margin="0,3,0,7">
                                <TextBlock x:Name="OverallPercent" Text="0"
                                           Style="{StaticResource MetricValue}" FontSize="26" />
                                <TextBlock Text="%" Style="{StaticResource MetricUnit}" />
                            </StackPanel>

                            <Border Style="{StaticResource ProgressTrack}">
                                <Border x:Name="OverallFill" Style="{StaticResource ProgressFill}"
                                        Width="0" />
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="FrameCounter" Style="{StaticResource MetricNote}"
                                           Text="–" />
                                <TextBlock x:Name="RemainingText" Style="{StaticResource MetricNote}"
                                           HorizontalAlignment="Right" Text="" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Aktueller Frame -->
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_CurrentFrame}" Style="{StaticResource MetricLabel}" />

                            <StackPanel Orientation="Horizontal" Margin="0,3,0,7">
                                <TextBlock x:Name="SampleValue" Text="–"
                                           Style="{StaticResource MetricValue}" />
                                <TextBlock x:Name="SampleTotal" Style="{StaticResource MetricUnit}"
                                           Text="" />
                            </StackPanel>

                            <Border Style="{StaticResource ProgressTrack}" Height="4">
                                <Border x:Name="SampleFill" Style="{StaticResource ProgressFill}"
                                        Height="4" Width="0" />
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="FrameRemainingText" Style="{StaticResource MetricNote}"
                                           Text="" />
                                <TextBlock x:Name="MemoryText" Style="{StaticResource MetricNote}"
                                           HorizontalAlignment="Right" Text="" />
                            </Grid>

                            <TextBlock x:Name="ActivityText" Style="{StaticResource MetricNote}"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource FaintBrush}" Text="" />
                        </StackPanel>
                    </Border>

                    <!-- Tempoverlauf. Ein Mittelwert verschweigt, WELCHE Stellen teuer
                         waren - genau das will man aber wissen. -->
                    <Border x:Name="SpeedCard" Style="{StaticResource MetricCard}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource S_SpeedPerFrame}" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="SpeedSpread" Style="{StaticResource MetricNote}"
                                           HorizontalAlignment="Right" Text="" />
                            </Grid>

                            <local:FrameTimeChart x:Name="SpeedChart" Margin="0,6,0,0"
                                                  BarBrush="{StaticResource AccentBrush}"
                                                  PeakBrush="{StaticResource ForegroundBrush}"
                                                  LabelBrush="{StaticResource FaintBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Zeiten -->
                    <Border Style="{StaticResource MetricCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_PerFrame}" Style="{StaticResource MetricLabel}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock x:Name="PerFrameValue" Text="–"
                                               Style="{StaticResource MetricValue}" FontSize="17" />
                                    <TextBlock x:Name="PerFrameUnit" Style="{StaticResource MetricUnit}"
                                               Text="" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource S_Elapsed}" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="ElapsedValue" Text="0:00" Margin="0,3,0,0"
                                           Style="{StaticResource MetricValue}" FontSize="17" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Auslastung -->
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="CPU" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="CpuValue" Style="{StaticResource MetricNote}"
                                           HorizontalAlignment="Right" Text="–" />
                            </Grid>
                            <local:Sparkline x:Name="CpuLine" Margin="0,4,0,10" />

                            <Grid>
                                <TextBlock Text="{DynamicResource S_Memory}" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="RamValue" Style="{StaticResource MetricNote}"
                                           HorizontalAlignment="Right" Text="–" />
                            </Grid>
                            <local:Sparkline x:Name="RamLine" Margin="0,4,0,10" />

                            <Grid>
                                <TextBlock Text="GPU" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="GpuValue" Style="{StaticResource MetricNote}"
                                           HorizontalAlignment="Right" Text="–" />
                            </Grid>
                            <local:Sparkline x:Name="GpuLine" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Was gerendert wird -->
                    <TextBlock x:Name="JobFileText" Style="{StaticResource MetricNote}"
                               Margin="2,2,0,0" TextTrimming="CharacterEllipsis" Text="" />
                    <TextBlock x:Name="JobDetailText" Style="{StaticResource MetricLabel}"
                               Margin="2,4,0,0" Text="" />

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="SidePanel" Grid.Row="1" Grid.Column="2" Width="288"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,12,14,14">

                    <!-- Histogramm -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource S_Distribution}" Style="{StaticResource PanelHeading}" />
                        <Button x:Name="HistogramModeButton" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" Content="RGB"
                                Click="OnHistogramModeClicked"
                                ToolTip="{DynamicResource S_RgbToggle}" />
                    </Grid>

                    <local:HistogramView x:Name="HistogramView" Margin="0,0,0,4" />

                    <TextBlock x:Name="ClipText" Margin="0,0,0,14" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                    <!-- Korrektur -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource S_Correction}" Style="{StaticResource PanelHeading}" />
                        <Button x:Name="ResetAdjustButton" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" Content="{DynamicResource S_Reset}"
                                Click="OnResetAdjustClicked" />
                    </Grid>

                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="{DynamicResource S_Exposure}" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="ExposureValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="ExposureSlider" Style="{StaticResource PanelSlider}"
                            Minimum="-4" Maximum="4" Value="0" SmallChange="0.05" LargeChange="0.25"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="0" />

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="{DynamicResource S_Gamma}" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="GammaValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="GammaSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0.2" Maximum="3" Value="1" SmallChange="0.02" LargeChange="0.1"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="1" />

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="{DynamicResource S_Contrast}" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="ContrastValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="ContrastSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0" Maximum="3" Value="1" SmallChange="0.02" LargeChange="0.1"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="1" />

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="{DynamicResource S_Saturation}" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="SaturationValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="SaturationSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0" Maximum="3" Value="1" SmallChange="0.02" LargeChange="0.1"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="1" />

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="{DynamicResource S_BlackPoint}" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="BlackValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="BlackSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0" Maximum="0.9" Value="0" SmallChange="0.01" LargeChange="0.05"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="0" />

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="{DynamicResource S_WhitePoint}" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="WhiteValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="WhiteSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0.1" Maximum="1.5" Value="1" SmallChange="0.01" LargeChange="0.05"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="1" />

                    <!-- Kanäle -->
                    <TextBlock Text="{DynamicResource S_Channel}" Style="{StaticResource PanelHeading}" Margin="0,16,0,6" />
                    <ComboBox x:Name="ChannelBox" Style="{StaticResource OverlayCombo}"
                              SelectionChanged="OnChannelChanged"
                              ToolTip="{DynamicResource S_ChannelHint}" />

                    <!-- A/B -->
                    <TextBlock Text="{DynamicResource S_Compare}" Style="{StaticResource PanelHeading}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MarkAButton" Grid.Column="0" Style="{StaticResource OverlayButton}"
                                Margin="0,0,4,0" Content="{DynamicResource S_Remember}" Click="OnMarkAClicked"
                                ToolTip="{DynamicResource S_RememberHint}" />
                        <ToggleButton x:Name="CompareButton" Grid.Column="1" Style="{StaticResource OverlayToggle}"
                                      Margin="4,0,0,0" Content="A / B" IsEnabled="False"
                                      Checked="OnCompareToggled" Unchecked="OnCompareToggled"
                                      ToolTip="{DynamicResource S_CompareToggle}" />
                    </Grid>
                    <TextBlock x:Name="CompareText" Margin="0,6,0,0" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="{DynamicResource S_NoFrameKept}" />

                    <!-- Vorlagen -->
                    <TextBlock Text="{DynamicResource S_Presets}" Style="{StaticResource PanelHeading}" Margin="0,16,0,6" />
                    <ComboBox x:Name="PresetBox" Style="{StaticResource OverlayCombo}"
                              Margin="0,0,0,6" SelectionChanged="OnPresetSelected"
                              ToolTip="{DynamicResource S_PresetsHint}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PresetNameBox" Grid.Column="0" Style="{StaticResource DialogTextBox}"
                                 Margin="0,0,6,0" ToolTip="{DynamicResource S_PresetName}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="SavePresetButton" Style="{StaticResource OverlayButton}"
                                    Content="{DynamicResource S_Save}" Click="OnSavePresetClicked" />
                            <Button x:Name="DeletePresetButton" Style="{StaticResource OverlayButton}"
                                    Margin="4,0,0,0" MinWidth="26" Content="&#x2715;"
                                    Click="OnDeletePresetClicked" ToolTip="{DynamicResource S_DeletePreset}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="PanelStatus" Margin="0,10,0,0" FontSize="10"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
