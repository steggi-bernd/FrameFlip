<Window x:Class="FrameFlip.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:FrameFlip.Views"
        Title="FrameFlip"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        MinWidth="400" MinHeight="300"
        Background="#FF171717"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Opacity="0">

    <!-- Ohne WindowChrome zeichnet WPF bei WindowStyle=None trotzdem einen
         Glasrahmen an der Oberkante - das ist der helle Streifen. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Kopfleiste: Dateiname links, Zustand rechts. Ziehen bewegt das Fenster. -->
        <Grid x:Name="Header" Grid.Row="0" Grid.ColumnSpan="2" Background="#FF202020">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FileNameText" Grid.Column="0"
                       Margin="14,0,12,0" VerticalAlignment="Center"
                       Foreground="{StaticResource ForegroundBrush}"
                       FontFamily="Segoe UI" FontSize="12.5"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="RateText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           ToolTip="Tatsächlich angezeigte Bilder pro Sekunde" />
                <TextBlock x:Name="BufferText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           ToolTip="Wie weit der Ringpuffer vorausreicht. Wird die Zahl klein, stockt die Wiedergabe gleich – dann hilft eine kleinere Dekodiergröße." />
                <TextBlock x:Name="LoadText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />

                <!-- Sichtbarer Hinweis, dass nicht das Original zu sehen ist. -->
                <TextBlock x:Name="AdjustBadge" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource AccentBrush}" FontSize="11"
                           Visibility="Collapsed"
                           ToolTip="Die Anzeige ist korrigiert – die Dateien bleiben unverändert" />

                <!-- Aufloesung, Farbtiefe und Dateigroesse. Ein Klick blendet die
                     Angaben aus; der Zustand wird in der Konfiguration gehalten. -->
                <Button x:Name="MetaButton" Style="{StaticResource LinkButton}"
                        Margin="0,0,6,0" Click="OnMetaClicked"
                        ToolTip="Bilddaten ein- oder ausblenden (D)">
                    <TextBlock x:Name="MetaText" FontSize="11" />
                </Button>

                <Button x:Name="ZoomButton" Style="{StaticResource LinkButton}"
                        Margin="0,0,6,0" MinWidth="46" Click="OnZoomClicked"
                        ToolTip="Klick setzt auf 100 %, erneut auf Einpassung">
                    <TextBlock x:Name="ZoomText" FontSize="11" TextAlignment="Right" />
                </Button>

                <Button x:Name="CloseButton" Style="{StaticResource HeaderButton}"
                        Content="&#x2715;" ToolTip="Schliessen (Esc)" Click="OnCloseClicked" />
            </StackPanel>
        </Grid>

        <!-- Anzeige. Gezoomt wird ausschliesslich ueber die Matrix auf dem Bild;
             Layoutgroessen bleiben davon unberuehrt.

             Der Canvas ist nicht kosmetisch, sondern die eigentliche Reparatur des
             Zoom-Fehlers: ein Grid arrangiert sein Kind in der Zellgroesse und setzt,
             sobald das Kind groesser ist, einen Layout-Clip. Der greift in den
             Koordinaten des Kindes, also VOR der RenderTransform - das verschobene
             Bild wurde dadurch rechts und unten um genau den Betrag des Versatzes
             abgeschnitten. Ein Canvas misst seine Kinder ohne Begrenzung und
             arrangiert sie in voller Groesse, es entsteht kein Layout-Clip.
             Beschnitten wird nur noch aussen am Viewport. -->
        <Grid x:Name="Viewport" Grid.Row="1" Grid.Column="0" Background="#FF101010" ClipToBounds="True">
            <Canvas x:Name="Stage" ClipToBounds="True">
                <Image x:Name="Display"
                       Stretch="None"
                       RenderTransformOrigin="0,0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <MatrixTransform x:Name="ViewTransform" />
                    </Image.RenderTransform>
                </Image>
            </Canvas>

            <Border x:Name="StatusBadge" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Background="{StaticResource BadgeBackground}" CornerRadius="4" Padding="10,5">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentBrush}" FontSize="12" />
            </Border>

            <!-- Bedienleiste, blendet nach 2 s Inaktivitaet aus -->
            <Border x:Name="ControlBar" VerticalAlignment="Bottom" Margin="10"
                    Background="{StaticResource OverlayBackground}" CornerRadius="6" Padding="10,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Hinweiszeile fuer Luecken. Nur sichtbar, wenn welche da sind. -->
                    <Grid x:Name="GapBar" Grid.Row="0" Margin="0,0,0,6" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="GapText" Grid.Column="0" VerticalAlignment="Center"
                                   Margin="2,0,8,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource GapBrush}" FontSize="11" />

                        <Button x:Name="CopyBlenderButton" Grid.Column="1"
                                Style="{StaticResource LinkButton}"
                                Content="Blender-Befehl kopieren" Click="OnCopyBlenderClicked"
                                ToolTip="Legt einen vollstaendigen Aufruf zum Nachrendern in die Zwischenablage" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayButton" Grid.Column="0" Style="{StaticResource OverlayButton}"
                                Content="&#x25B6;" ToolTip="Wiedergabe / Pause (Leertaste)" Click="OnPlayClicked" />

                        <!-- Luecken und Scrubber liegen in derselben Zelle mit derselben
                             Randbreite; dadurch decken sich Markierung und Spur exakt. -->
                        <Grid Grid.Column="1" Margin="12,0">
                            <local:TimelineGaps x:Name="GapStrip" VerticalAlignment="Center"
                                                IsHitTestVisible="False" />

                            <Slider x:Name="Scrubber" Style="{StaticResource Scrubber}"
                                    VerticalAlignment="Center"
                                    Minimum="0" Maximum="1" Value="0" />
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="CounterText"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       FontFamily="Consolas, Courier New" FontSize="13"
                                       ToolTip="Framenummer aus dem Dateinamen" />
                            <TextBlock x:Name="RangeText" Margin="10,0,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Consolas, Courier New" FontSize="11"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       ToolTip="Bereich zwischen In- und Out-Punkt (I und O, Entf loescht ihn)" />
                        </StackPanel>

                        <ToggleButton x:Name="LoopButton" Grid.Column="3" Style="{StaticResource OverlayToggle}"
                                      Content="&#x27F3;" ToolTip="Endlosschleife (L)" Margin="0,0,8,0"
                                      Checked="OnLoopChanged" Unchecked="OnLoopChanged" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <!-- Dekodiergröße. Wirkt auf den Puffervorlauf, nicht auf den Zoom. -->
                            <Button x:Name="DraftButton" Style="{StaticResource OverlayButton}"
                                    Margin="0,0,8,0" MinWidth="52" Click="OnDraftClicked">
                                <TextBlock x:Name="DraftText" FontSize="12" />
                            </Button>

                            <ComboBox x:Name="FpsBox" Style="{StaticResource OverlayCombo}"
                                      Width="88" ToolTip="Bildrate"
                                      SelectionChanged="OnFpsChanged" />

                            <ToggleButton x:Name="PanelButton" Style="{StaticResource OverlayToggle}"
                                          Margin="8,0,0,0" Content="&#x25E7;"
                                          ToolTip="Bildanpassung ein- oder ausblenden (Tab)"
                                          Checked="OnPanelToggled" Unchecked="OnPanelToggled" />

                            <Button x:Name="ExportButton" Style="{StaticResource OverlayButton}"
                                    Margin="8,0,0,0" Content="Export …"
                                    ToolTip="Sequenz als Video exportieren (E)"
                                    Click="OnExportClicked" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bildanpassung. Klappt nach rechts auf; das Fenster wächst mit, solange
             der Bildschirm es hergibt. Alles hier betrifft nur die Anzeige – die
             Dateien auf der Platte bleiben unberührt. -->
        <Border x:Name="SidePanel" Grid.Row="1" Grid.Column="1" Width="288"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,12,14,14">

                    <!-- Histogramm -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Verteilung" Style="{StaticResource PanelHeading}" />
                        <Button x:Name="HistogramModeButton" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" Content="RGB"
                                Click="OnHistogramModeClicked"
                                ToolTip="Zwischen Farbkanälen und reiner Helligkeit wechseln" />
                    </Grid>

                    <local:HistogramView x:Name="HistogramView" Margin="0,0,0,4" />

                    <TextBlock x:Name="ClipText" Margin="0,0,0,14" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                    <!-- Korrektur -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Korrektur" Style="{StaticResource PanelHeading}" />
                        <Button x:Name="ResetAdjustButton" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" Content="zurücksetzen"
                                Click="OnResetAdjustClicked" />
                    </Grid>

                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="Belichtung" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="ExposureValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="ExposureSlider" Style="{StaticResource PanelSlider}"
                            Minimum="-4" Maximum="4" Value="0" SmallChange="0.05" LargeChange="0.25"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="0" />

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="Gamma" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="GammaValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="GammaSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0.2" Maximum="3" Value="1" SmallChange="0.02" LargeChange="0.1"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="1" />

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="Kontrast" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="ContrastValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="ContrastSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0" Maximum="3" Value="1" SmallChange="0.02" LargeChange="0.1"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="1" />

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="Sättigung" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="SaturationValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="SaturationSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0" Maximum="3" Value="1" SmallChange="0.02" LargeChange="0.1"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="1" />

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="Schwarzpunkt" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="BlackValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="BlackSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0" Maximum="0.9" Value="0" SmallChange="0.01" LargeChange="0.05"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="0" />

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="Weißpunkt" Style="{StaticResource PanelLabel}" />
                        <TextBlock x:Name="WhiteValue" Style="{StaticResource PanelValue}" />
                    </Grid>
                    <Slider x:Name="WhiteSlider" Style="{StaticResource PanelSlider}"
                            Minimum="0.1" Maximum="1.5" Value="1" SmallChange="0.01" LargeChange="0.05"
                            ValueChanged="OnAdjustmentChanged"
                            MouseDoubleClick="OnSliderReset" Tag="1" />

                    <!-- Kanäle -->
                    <TextBlock Text="Kanal" Style="{StaticResource PanelHeading}" Margin="0,16,0,6" />
                    <ComboBox x:Name="ChannelBox" Style="{StaticResource OverlayCombo}"
                              SelectionChanged="OnChannelChanged"
                              ToolTip="Einzelne Kanäle isolieren – Alpha zeigt die Freistellung" />

                    <!-- A/B -->
                    <TextBlock Text="Vergleich" Style="{StaticResource PanelHeading}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MarkAButton" Grid.Column="0" Style="{StaticResource OverlayButton}"
                                Margin="0,0,4,0" Content="Merken" Click="OnMarkAClicked"
                                ToolTip="Diesen Frame als Vergleich festhalten (A)" />
                        <ToggleButton x:Name="CompareButton" Grid.Column="1" Style="{StaticResource OverlayToggle}"
                                      Margin="4,0,0,0" Content="A / B" IsEnabled="False"
                                      Checked="OnCompareToggled" Unchecked="OnCompareToggled"
                                      ToolTip="Zwischen gemerktem und aktuellem Frame umschalten (C)" />
                    </Grid>
                    <TextBlock x:Name="CompareText" Margin="0,6,0,0" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Kein Frame gemerkt." />

                    <!-- Vorlagen -->
                    <TextBlock Text="Vorlagen" Style="{StaticResource PanelHeading}" Margin="0,16,0,6" />
                    <ComboBox x:Name="PresetBox" Style="{StaticResource OverlayCombo}"
                              Margin="0,0,0,6" SelectionChanged="OnPresetSelected"
                              ToolTip="Gespeicherte Korrektureinstellungen" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PresetNameBox" Grid.Column="0" Style="{StaticResource DialogTextBox}"
                                 Margin="0,0,6,0" ToolTip="Name für die neue Vorlage" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="SavePresetButton" Style="{StaticResource OverlayButton}"
                                    Content="Sichern" Click="OnSavePresetClicked" />
                            <Button x:Name="DeletePresetButton" Style="{StaticResource OverlayButton}"
                                    Margin="4,0,0,0" MinWidth="26" Content="&#x2715;"
                                    Click="OnDeletePresetClicked" ToolTip="Ausgewählte Vorlage löschen" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="PanelStatus" Margin="0,10,0,0" FontSize="10"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
